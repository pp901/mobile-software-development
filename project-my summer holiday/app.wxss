page {
  --ink: #26312b;
  --ink-soft: #4f5852;
  --muted: #858a84;
  --paper: #f7f3ea;
  --paper-deep: #eee9df;
  --white: #fffdf8;
  --olive: #3f7055;
  --olive-deep: #173f2d;
  --olive-pale: #dcecdf;
  --oat: #e9dccb;
  --oat-pale: #f4eadc;
  --sun: #f2bd42;
  --sun-soft: #fff0b8;
  --coral: #ec765f;
  --coral-soft: #ffe0d7;
  --sky: #73a9d8;
  --sky-soft: #dcebf6;
  --line: rgba(38, 49, 43, 0.09);
  --shadow-soft: 0 10rpx 0 rgba(23, 63, 45, .06), 0 22rpx 42rpx rgba(34, 57, 43, .08);
  --shadow-float: 0 12rpx 0 rgba(20, 54, 39, .16), 0 26rpx 52rpx rgba(30, 54, 40, .18);
  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view, text, image, button, input, textarea, scroll-view, swiper, swiper-item, picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

button::after { border: 0; }

.page-shell {
  min-height: 100vh;
  background: var(--paper);
}

.page-pad { padding-left: 28rpx; padding-right: 28rpx; }
.safe-bottom { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.tabbar-space { padding-bottom: calc(138rpx + env(safe-area-inset-bottom)); }

.brand-serif {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  letter-spacing: -1.5rpx;
}

.eyebrow {
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3.5rpx;
  text-transform: uppercase;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 32rpx 0 18rpx;
}

.section-title {
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -1rpx;
}

.section-link {
  min-height: 56rpx;
  padding: 14rpx 0 4rpx 24rpx;
  color: var(--olive-deep);
  font-size: 22rpx;
  font-weight: 500;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 96rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: .5rpx;
  transition: opacity 180ms ease, transform 180ms ease, background-color 180ms ease;
}

.primary-button {
  background: var(--olive-deep);
  color: #fff;
  box-shadow: 0 8rpx 0 #0d2d20, 0 16rpx 28rpx rgba(23, 63, 45, .18);
}

.primary-button[disabled] {
  background: #b8beb9;
  box-shadow: none;
  color: rgba(255, 255, 255, .88);
}

.secondary-button { background: var(--sun-soft); color: #5b4310; box-shadow:0 6rpx 0 #e4cf88; }
.danger-button { background: var(--coral-soft); color: #925340; }

.surface {
  background: var(--white);
  border: 1rpx solid rgba(38, 49, 43, 0.055);
  border-radius: 26rpx;
  box-shadow: var(--shadow-soft);
}

.tag {
  min-height: 48rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 12rpx;
  background: #ecebe6;
  color: #656a65;
  font-size: 21rpx;
}

.empty-state {
  padding: 104rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--muted);
  text-align: center;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--olive-pale);
  color: var(--olive);
  font-family: Georgia, serif;
  font-size: 58rpx;
  line-height: 1;
}

.empty-title { margin-top: 24rpx; color: var(--ink); font-size: 30rpx; font-weight: 600; }
.empty-copy { max-width: 500rpx; margin-top: 12rpx; font-size: 23rpx; line-height: 1.75; }

.pressable,
button { transition: opacity 160ms ease, transform 160ms ease, background-color 160ms ease; }
.pressable:active,
button:active { opacity: .78; transform: scale(.982); }

input, textarea { color: var(--ink); background:transparent; border:0; outline:none; border-radius:0; }

@media (prefers-reduced-motion: reduce) {
  .pressable, button { transition-duration: 0ms; }
}

/* Native touch feedback shared by pages and components. */
.card-hover { opacity:.78; transform:scale(.985); }
.section-link { min-height:44rpx; padding:6rpx 0 6rpx 16rpx; color:#8b8d83; font-size:21rpx; }
button { max-width:100%; }
