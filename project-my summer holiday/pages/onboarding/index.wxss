page { background: #f6f3ed; }
.onboarding { position: relative; min-height: 100vh; overflow: hidden; background: #f6f3ed; }
.onboarding-top {
  height: calc(78rpx + env(safe-area-inset-top));
  padding: env(safe-area-inset-top) 34rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mini-brand { font-size: 31rpx; font-weight: 600; }
.skip {
  min-height: 56rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  color: #7f847e;
  font-size: 21rpx;
}
.story-swiper { height: calc(100vh - 246rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom)); }
.slide { height: 100%; padding: 20rpx 36rpx 0; }
.visual {
  position: relative;
  height: 59%;
  min-height: 0;
  max-height: 650rpx;
  overflow: hidden;
  border-radius: 26rpx;
  background: #e2e9e3;
}
.visual-photo, .visual-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.visual-shade { background: linear-gradient(180deg, rgba(20, 27, 23, .04) 30%, rgba(20, 27, 23, .72) 100%); }
.visual-caption { position: absolute; left: 32rpx; right: 32rpx; bottom: 34rpx; color: #fff; }
.visual-title {
  display: block;
  max-width: 500rpx;
  margin-top: 12rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 38rpx;
  line-height: 1.4;
}

.visual-two { padding: 50rpx 40rpx; background: #e9dccb; }
.mini-card {
  width: 358rpx;
  padding: 13rpx 13rpx 16rpx;
  border-radius: 20rpx;
  background: #fffefa;
  box-shadow: 0 18rpx 38rpx rgba(67, 55, 43, .12);
  transform: rotate(-4deg);
}
.mini-card image { width: 100%; height: 196rpx; border-radius: 13rpx; }
.mini-card text { display: block; padding: 0 7rpx; }
.mini-card text:nth-child(2) { margin-top: 13rpx; font-family: Georgia, "Songti SC", serif; font-size: 24rpx; font-weight: 600; }
.mini-card text:last-child { margin-top: 5rpx; color: #8d8c86; font-size: 17rpx; }
.mini-card.offset { margin: -34rpx 0 0 142rpx; transform: rotate(4deg); }
.moment-dot {
  position: absolute;
  right: 40rpx;
  top: 32rpx;
  width: 76rpx;
  height: 76rpx;
  border: 7rpx solid rgba(255,255,255,.8);
  border-radius: 50%;
  background: #385344;
  color: #fff;
  font-size: 44rpx;
  line-height: 68rpx;
  text-align: center;
}

.visual-three { padding: 56rpx 34rpx; color: #fff; background: #385344; }
.review-label { font-size: 18rpx; letter-spacing: 3rpx; }
.review-number { display: block; margin-top: 38rpx; font-size: 136rpx; line-height: .9; }
.review-unit { display: block; margin-top: 12rpx; color: rgba(255,255,255,.74); font-size: 22rpx; }
.review-strip { height: 150rpx; margin-top: 52rpx; display: flex; gap: 9rpx; transform: rotate(-3deg); }
.review-strip image { min-width: 0; flex: 1; border: 7rpx solid rgba(255,255,255,.9); }
.review-finish { position: absolute; left: 34rpx; bottom: 34rpx; font-size: 18rpx; letter-spacing: 3rpx; }

.slide-copy-wrap { padding: 26rpx 6rpx 0; }
.slide-index { display: block; color: #647d6d; font-size: 18rpx; font-weight: 600; letter-spacing: 2rpx; }
.slide-title { display: block; margin-top: 8rpx; font-size: 35rpx; font-weight: 600; line-height: 1.35; }
.slide-copy { display: block; max-width: 620rpx; margin-top: 12rpx; color: #777e78; font-size: 23rpx; line-height: 1.65; }

.bottom-actions {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  height: 106rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.dots { flex: 1; display: flex; align-items: center; gap: 10rpx; }
.dot { width: 9rpx; height: 9rpx; border-radius: 5rpx; background: #c9cbc6; transition: width .25s ease; }
.dot.active { width: 34rpx; background: #587362; }
.primary-button { width: 286rpx; }
.button-arrow { margin-left: 18rpx; font-size: 29rpx; font-weight: 400; }
