.about{padding-top:76rpx;padding-bottom:48rpx}.about-title{font:600 62rpx/1.28 var(--font-display);letter-spacing:-2rpx;display:block;white-space:pre-line}.about-heading{font-size:35rpx;font-weight:600;letter-spacing:-.5rpx;display:block;margin:62rpx 0 16rpx}.about-copy{max-width:620rpx;font-size:29rpx;line-height:1.85;color:var(--text-secondary);display:block;margin-top:28rpx}.about button[class]{margin-top:72rpx}
.about { margin:38rpx 24rpx; padding:56rpx 36rpx 48rpx; border:1rpx solid #E2D8C8; border-radius:7rpx; background-color:#FFFDF8; background-image:repeating-linear-gradient(180deg,transparent 0,transparent 62rpx,rgba(102,126,102,.07) 63rpx); box-shadow:0 8rpx 18rpx rgba(74,68,57,.06); }.about-title { color:#31573E; font-family:var(--font-hand); letter-spacing:1rpx; }.about-heading { color:#5D7D61; font-family:var(--font-hand); }.about-copy { color:#596A5C; font-family:var(--font-hand); }
