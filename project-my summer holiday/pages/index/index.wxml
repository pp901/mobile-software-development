<view class="home-page tabbar-space">
 <navigation-bar home background="#FAFBF6"><view slot="home" class="app-masthead"><text class="app-wordmark">ongoing_</text><button class="ui-button masthead-action" bindtap="openSearch" aria-label="搜索生活记录"><image src="/assets/icons/search.svg"/></button></view></navigation-bar>
 <view class="page-pad">
  <view class="today-intro">
   <view class="date-lockup"><text class="date-day">{{todayDay}}</text><view class="date-aside"><text>{{todayMonth}}</text><text>{{weekday}}<text class="today-dot"> · </text>今天</text></view><image class="today-mark" src="/assets/images/logo.webp" mode="aspectFit" aria-label="ongoing_"/></view>
   <text wx:if="{{todayCount}}" class="today-title">今天已留下 <text class="count-accent">{{todayCount}}</text> 个 Moment。</text>
   <text wx:else class="today-title">今天，有什么想留给<text class="title-line">以后的自己？</text></text>
   
  </view>
  <button class="ui-button record-cta" bindtap="createMoment"><view class="capture-copy"><view class="palette-dots"><view></view><view></view><view></view></view><text class="capture-title">记录此刻</text><text class="capture-caption">文字 · 照片 · 声音</text></view><view class="capture-art"><image wx:for="{{capturePhotos}}" wx:key="id" wx:if="{{item.image}}" class="capture-print print-{{index}}" src="{{item.image}}" mode="aspectFill" data-index="{{index}}" binderror="captureImageError"/><view class="record-plus"><view></view><view></view></view></view></button>
  <button wx:if="{{draft}}" class="ui-button draft-resume" bindtap="resumeDraft"><text>还有一句话，等你写完</text><text>继续草稿 →</text></button>
  <button wx:if="{{syncStatus.error}}" class="ui-button sync-hint" bindtap="openSync"><view></view><text>已保存在本机 · 同步需要处理</text><text>查看 ›</text></button><view class="section-head recent-heading"><text class="section-title">最近的 Moment</text><button wx:if="{{total}}" class="ui-button section-link" bindtap="openLife">查看全部<view class="disclosure-chevron points-right"></view></button><text wx:else class="section-caption">生活的小切片</text></view>
  <scroll-view wx:if="{{moments.length}}" scroll-x class="recent-scroll" show-scrollbar="{{false}}"><view class="recent-cards"><view class="recent-card" wx:for="{{moments}}" wx:key="id"><moment-card moment="{{item}}" layout="compact" bind:open="openMoment"/></view></view></scroll-view>
  <view wx:else class="home-empty-guide moment-empty-guide">
   <view class="empty-guide-art moment-guide-art" aria-hidden="true"><view class="moment-sheet sheet-back"></view><view class="moment-sheet sheet-front"><view></view><view></view><view></view></view><view class="moment-spark">＋</view></view>
   <view class="empty-guide-copy"><text class="empty-guide-kicker">从一个瞬间开始</text><text class="empty-guide-title">这里还没有 Moment</text><text class="empty-guide-description">不必是特别的一天，写下一句、拍下一张，今天就有了开头。</text></view>
   <button class="ui-button empty-guide-action" bindtap="createMoment" aria-label="记录第一个 Moment"><text>记录第一个 Moment</text><text class="guide-arrow">↗</text></button>
  </view>
  <button wx:if="{{echo}}" class="ui-button echo-card content-enter {{echo.image && !echoImageFailed ? 'echo-with-photo' : ''}}" bindtap="openEcho" aria-label="记忆回响：{{echo.label}}">
   <image wx:if="{{echo.image && !echoImageFailed}}" class="echo-photo" src="{{echo.image}}" mode="aspectFill" binderror="echoImageError"/><view class="echo-veil"></view>
   <view class="echo-body"><view class="echo-heading"><image src="/assets/icons/echo-active.svg"/><text>时间来信 <text class="echo-english">Memory Echo</text></text></view><text class="echo-reason">{{echo.label}}</text><text class="echo-explanation">{{echo.explanation}}</text><text wx:if="{{!echo.image || echoImageFailed}}" class="echo-excerpt">{{echo.content || '那天的声音，还留在这里。'}}</text><view class="echo-bottom"><text>{{echo.echoDate}}<text class="echo-time-line"> — </text>今天</text><text class="echo-open">再看这一刻 ↗</text></view></view>
  </button>
  <view class="section-head chapter-heading"><view><text class="section-title">正在经历</text><text class="section-caption chapter-caption">Chapter · 一段生活</text></view><button wx:if="{{chapters.length}}" class="ui-button section-link" bindtap="createChapter">新的一章 ＋</button><text wx:else class="empty-section-note">从一段生活开始</text></view>
  <scroll-view wx:if="{{chapters.length}}" scroll-x class="chapter-scroll" show-scrollbar="{{false}}"><view class="chapter-cards"><button wx:for="{{chapters}}" wx:key="id" class="ui-button life-chapter palette-{{index % 3}}" data-id="{{item.id}}" bindtap="openChapter"><view class="chapter-copy"><text class="chapter-time">{{item.elapsedLabel}}</text><text class="chapter-title">{{item.title}}</text><text class="chapter-dates">{{item.dateRange}}</text><text class="chapter-numbers">{{item.momentCount}} Moment · {{item.recordedDayCount}} 个记录日</text></view><view class="chapter-side"><image wx:if="{{item.homeCover}}" class="chapter-thumb" src="{{item.homeCover}}" mode="aspectFill" data-index="{{index}}" binderror="coverError"/><view wx:else class="chapter-letter">{{item.title[0]}}</view><view class="member-stack"><view wx:for="{{item.memberPreview}}" wx:for-item="member" wx:key="id" class="member-bubble"><image wx:if="{{member.avatar}}" src="{{member.avatar}}" mode="aspectFill"/><text wx:else>{{member.nickname ? member.nickname[0] : '我'}}</text></view></view></view></button></view></scroll-view>
  <view wx:else class="home-empty-guide chapter-empty-guide">
   <view class="empty-guide-art chapter-guide-art" aria-hidden="true"><view class="chapter-book-cover"><text>Chapter</text><view></view><view></view></view><view class="chapter-book-page"></view><view class="chapter-book-tab"></view></view>
   <view class="empty-guide-copy"><text class="empty-guide-kicker">为日子留一个名字</text><text class="empty-guide-title">这一页，还没有名字</text><text class="empty-guide-description">把想慢慢记录的日子收进同一章，之后的 Moment 都能找到归处。</text></view>
   <button class="ui-button empty-guide-action" bindtap="createChapter" aria-label="新建第一个 Chapter"><text>新建第一个 Chapter</text><text class="guide-arrow">↗</text></button>
  </view>
  <text class="home-colophon">此刻很轻，时间会记得。</text>
 </view><app-tabbar active="now"/>
</view>
