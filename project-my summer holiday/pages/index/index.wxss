.home-header { display:flex; align-items:center; justify-content:space-between; padding-top:4rpx; }
.brand { font-size:56rpx; font-weight:600; line-height:1.1; color:#232823; }
.header-actions { display:flex; align-items:center; gap:22rpx; }
.round-action { width:60rpx; height:64rpx; display:flex; align-items:center; justify-content:center; }
.round-action image { width:38rpx; height:38rpx; }
.avatar-button { width:68rpx; height:68rpx; border-radius:50%; overflow:hidden; }
.avatar-button image { width:100%; height:100%; }
.intro { display:flex; align-items:center; justify-content:space-between; padding-top:28rpx; padding-bottom:26rpx; }
.intro-hand { font-family:"STKaiti","KaiTi","Songti SC",serif; font-size:30rpx; line-height:1.5; color:#73776e; white-space:pre-line; letter-spacing:3rpx; }
.intro-note { text-align:right; font-size:21rpx; line-height:1.7; color:#92928b; white-space:pre-line; }
.quick-grid { display:flex; gap:14rpx; }
.quick-item { flex:1; min-width:0; height:150rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:15rpx; border-radius:24rpx; font-size:23rpx; color:#3d433b; }
.quick-item image { width:48rpx; height:48rpx; }
.quick-photo { background:#e3e9dd; }.quick-text { background:#f8e9d9; }.quick-voice { background:#faedd3; }.quick-place { background:#f9e6dd; }
.moment-list { display:flex; flex-direction:column; gap:16rpx; }
.section-note { color:#91918a; font-size:21rpx; }
.switch-link { color:#6d7d69; text-align:right; width:100%; padding-top:14rpx; font-size:21rpx; }
.empty-button { margin-top:24rpx; }
