.home-page { min-height:100vh; overflow-x:hidden; }.home-masthead { height:100%; display:flex; align-items:center; padding-left:32rpx; }.home-wordmark { color:#34415D; font-family:var(--font-display); font-size:52rpx; font-weight:700; line-height:1; letter-spacing:-2rpx; }.home-intro { padding-top:10rpx; padding-bottom:26rpx; font-size:24rpx; color:var(--text-muted); }
.chapter-swiper { width:100%; height:456rpx; }.chapter-cover.chapter-cover { position:relative; width:calc(100% - 16rpx); height:100%; overflow:hidden; border-radius:40rpx; text-align:left; color:var(--text); background:var(--lavender-soft); }.cover-photo,.cover-placeholder,.cover-shade { position:absolute; inset:0; width:100%; height:100%; }.cover-placeholder { align-items:flex-start; padding-top:48rpx; }.cover-placeholder>image { width:60rpx; height:60rpx; }.cover-shade { background:linear-gradient(180deg,rgba(41,25,43,.02),rgba(41,25,43,.14) 30%,rgba(41,25,43,.72)); }.cover-copy { position:absolute; inset:0; padding:30rpx; display:flex; flex-direction:column; justify-content:flex-end; }.has-image { color:#fff; }.chapter-label { font-size:21rpx; letter-spacing:2rpx; opacity:.85; }.cover-title { margin:12rpx 0; font-size:42rpx; font-family:var(--font-display); line-height:1.35; font-weight:600; overflow-wrap:anywhere; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }.cover-description { font-size:25rpx; line-height:1.6; opacity:.85; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }.cover-footer { display:flex; justify-content:space-between; gap:12rpx; margin-top:26rpx; font-size:22rpx; opacity:.9; }
.new-chapter.new-chapter { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18rpx; background:var(--surface-soft); border:2rpx dashed var(--primary-soft); }.new-plus { font-size:64rpx; line-height:1; color:var(--primary); }.new-title { font-size:36rpx; font-weight:500; }.new-copy { padding:0 28rpx; font-size:25rpx; text-align:center; color:var(--text-secondary); }
.chapter-pagination { display:flex; justify-content:center; align-items:center; gap:10rpx; height:34rpx; }.chapter-pagination view { width:8rpx; height:8rpx; border-radius:999rpx; background:var(--primary-soft); }.chapter-pagination .selected { width:24rpx; background:var(--primary); }
.record-cta.record-cta { position:relative; background:linear-gradient(100deg,var(--primary-deep),#8390B5); }.cta-spark { font-size:38rpx; line-height:1; }.cta-arrow { position:absolute; right:32rpx; font-size:36rpx; font-weight:400; }
.draft-resume.draft-resume { width:100%; display:flex; justify-content:space-between; gap:16rpx; min-height:76rpx; align-items:center; font-size:24rpx; color:var(--primary-deep); }.section-head { margin:20rpx 0 12rpx; min-height:72rpx; }.section-title { font-size:34rpx; }
.recent-scroll { width:100%; }.recent-cards { display:flex; gap:16rpx; padding-bottom:8rpx; }.recent-card { width:calc((100vw - 96rpx)/3); flex:none; min-width:0; }.recent-empty { display:flex; flex-direction:column; gap:10rpx; padding:24rpx 0 36rpx; font-size:26rpx; color:var(--text-secondary); }.recent-empty text+text { color:var(--text-muted); font-size:24rpx; }
.echo-card.echo-card { width:100%; margin-top:28rpx; padding:24rpx; border-radius:26rpx; display:flex; gap:24rpx; align-items:center; text-align:left; background:linear-gradient(110deg,#F0EDF6,#ECF1F8); }.echo-copy { flex:1; min-width:0; }.echo-heading { display:flex; align-items:center; gap:12rpx; font-size:27rpx; color:#5B638B; font-weight:500; }.echo-spark { font-size:34rpx; }.echo-english { font-size:21rpx; font-weight:400; margin-left:6rpx; }.echo-description { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin:8rpx 0; font-size:25rpx; color:var(--text-secondary); line-height:1.6; }.echo-meta { display:block; color:var(--text-muted); font-size:21rpx; }.echo-thumb { width:120rpx; height:140rpx; flex:none; overflow:hidden; border-radius:24rpx; }.echo-thumb>.echo-photo { width:100%; height:100%; opacity:1; }

.chapter-swiper.is-empty { height:360rpx; }.new-chapter.new-chapter { background:linear-gradient(120deg,#EDF1F8,#F2EFF7); border:0; align-items:flex-start; padding:40rpx; gap:18rpx; }.new-copy { padding:0; text-align:left; }.new-plus { width:76rpx; height:76rpx; border-radius:24rpx; background:rgba(255,255,255,.8); display:flex; align-items:center; justify-content:center; font-size:42rpx; }.chapter-cover.chapter-cover { border-radius:48rpx; }.echo-card.echo-card { border-radius:40rpx; }.echo-heading { flex-wrap:wrap; gap:10rpx; }.echo-english { display:inline; white-space:nowrap; }.echo-thumb { height:120rpx; }.echo-meta { overflow-wrap:anywhere; }

.chapter-cover.chapter-cover.has-image { color:#FFFFFF; }
