.home-page { min-height:100vh; overflow-x:hidden; }
.today-intro { padding:24rpx 0; }
.date-lockup { display:flex; align-items:center; gap:22rpx; }
.date-day { font:500 84rpx/1 var(--font-ui); letter-spacing:-3rpx; color:var(--ink); font-variant-numeric:tabular-nums; }
.date-aside { border-left:1rpx solid var(--primary-soft); padding-left:22rpx; display:flex; flex-direction:column; gap:2rpx; font-size:22rpx; color:var(--text-secondary); }
.today-dot { color:var(--primary); }
.today-mark { width:72rpx; height:72rpx; flex:none; margin-left:auto; border-radius:20rpx; }
.today-title { display:block; margin-top:22rpx; font-size:34rpx; line-height:1.55; font-weight:500; }
.count-accent { color:var(--primary-deep); font:500 40rpx/1 var(--font-ui); }
.record-cta.record-cta {
  position:relative; display:flex; justify-content:space-between; align-items:center; gap:16rpx;
  width:100%; min-height:206rpx; padding:26rpx 30rpx; overflow:hidden; border-radius:var(--radius-large);
  background:#F5D5B5; color:var(--ink); text-align:left;
}
.capture-copy { position:relative; z-index:1; min-width:0; display:flex; flex-direction:column; gap:8rpx; }
.palette-dots { display:flex; gap:7rpx; margin-bottom:6rpx; }
.palette-dots>view { width:12rpx; height:12rpx; border-radius:50%; background:var(--primary); }
.palette-dots>view:nth-child(2) { background:#C99075; }
.palette-dots>view:nth-child(3) { background:var(--lavender); }
.capture-title { font-size:40rpx; font-weight:600; line-height:1.35; }
.capture-caption { font-size:23rpx; color:#806C58; }
.capture-art { position:relative; flex:none; width:216rpx; height:144rpx; }
.capture-print { position:absolute; right:82rpx; top:-1rpx; width:112rpx; height:138rpx; padding:6rpx 6rpx 20rpx; border-radius:10rpx; background:#FFFDF8; transform:rotate(-12deg); }
.capture-print.print-1 { right:42rpx; top:7rpx; transform:rotate(8deg); }
.record-plus { position:absolute; right:0; top:26rpx; width:96rpx; height:96rpx; border:5rpx solid #EECBB2; border-radius:50%; background:var(--primary-deep); }
.record-plus>view { position:absolute; top:calc(50% - 2rpx); left:calc(50% - 18rpx); width:36rpx; height:4rpx; border-radius:4rpx; background:#fff; }
.record-plus>view+view { transform:rotate(90deg); }
.draft-resume.draft-resume { width:100%; display:flex; justify-content:space-between; align-items:center; gap:16rpx; min-height:88rpx; color:var(--text-secondary); font-size:23rpx; text-align:left; }
.draft-resume>text+text { flex:none; color:var(--primary-deep); }
.sync-hint.sync-hint { width:100%; min-height:88rpx; display:flex; align-items:center; gap:10rpx; color:var(--text-secondary); font-size:22rpx; text-align:left; }
.sync-hint>view { width:7rpx; height:7rpx; background:#C69568; border-radius:50%; flex:none; }
.sync-hint>text:last-child { margin-left:auto; color:var(--clay); flex:none; }
.section-head { min-height:80rpx; margin:28rpx 0 14rpx; }
.section-caption { font-size:23rpx; color:var(--text-muted); }
.recent-scroll,.chapter-scroll { width:calc(100% + 32rpx); }
.recent-cards { display:flex; align-items:flex-start; gap:20rpx; padding:0 32rpx 6rpx 0; }
.recent-card { width:336rpx; flex:none; min-width:0; }
.recent-empty { display:flex; flex-direction:column; gap:10rpx; padding:32rpx; border-radius:var(--radius-medium); background:#F0F0E5; font-size:28rpx; }
.recent-empty>text+text { color:var(--text-secondary); font-size:25rpx; }
.empty-line { width:48rpx; height:3rpx; margin-bottom:12rpx; border-radius:3rpx; background:#BBBDA1; }
.echo-card.echo-card { position:relative; width:100%; overflow:hidden; margin-top:40rpx; border-radius:32rpx; text-align:left; background:#E8ECD9; }
.echo-photo { position:absolute; width:100%; height:100%; inset:0; }
.echo-veil { position:absolute; inset:0; background:linear-gradient(130deg,#E8ECD9,#F1EDDC); }
.echo-with-photo .echo-veil { background:linear-gradient(180deg,rgba(25,41,29,.04),rgba(25,41,29,.18) 28%,rgba(25,41,29,.8)); }
.echo-body { position:relative; display:flex; flex-direction:column; min-height:330rpx; padding:28rpx; }
.echo-with-photo .echo-body { min-height:402rpx; }
.echo-heading { display:flex; align-items:center; align-self:flex-start; gap:10rpx; margin-bottom:8rpx; padding:8rpx 14rpx; border-radius:var(--radius-full); background:rgba(255,255,248,.92); color:#537255; font-size:22rpx; }
.echo-heading>image { width:26rpx; height:26rpx; }
.echo-english { font:italic 23rpx/1.5 var(--font-display); margin-left:8rpx; }
.echo-reason { display:block; padding-top:28rpx; margin-top:auto; font:500 37rpx/1.4 var(--font-display); color:#40583E; overflow-wrap:anywhere; }
.echo-explanation { display:block; margin-top:8rpx; color:#6A7960; font-size:25rpx; line-height:1.7; }
.echo-excerpt { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-top:20rpx; font:italic 27rpx/1.8 var(--font-display); color:#7C8467; overflow-wrap:anywhere; }
.echo-bottom { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12rpx; padding-top:20rpx; margin-top:20rpx; border-top:1rpx solid rgba(93,113,71,.16); color:#7C8467; font-size:22rpx; }
.echo-time-line { color:var(--primary); }
.echo-open { color:#44694E; }
.echo-with-photo .echo-reason,.echo-with-photo .echo-open,.echo-with-photo .echo-time-line { color:#fff; }
.echo-with-photo .echo-explanation { color:rgba(255,255,255,.9); }
.echo-with-photo .echo-bottom { color:rgba(255,255,255,.75); border-color:rgba(255,255,255,.24); }
.chapter-heading { margin-top:40rpx; }
.chapter-caption { display:block; margin-top:6rpx; }
.chapter-cards { display:flex; gap:18rpx; padding-right:32rpx; }
.life-chapter.life-chapter { flex:none; width:620rpx; max-width:calc(100vw - 64rpx); display:flex; gap:16rpx; padding:26rpx; border-radius:var(--radius-medium); text-align:left; background:#EAF1DD; }
.life-chapter.palette-1 { background:#F0E9F6; }
.life-chapter.palette-2 { background:#FAEED8; }
.chapter-copy { flex:1; min-width:0; }
.chapter-time { font-size:22rpx; color:var(--primary-deep); }
.chapter-title { display:block; margin:8rpx 0; font-size:32rpx; font-weight:600; line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.chapter-dates { font-size:22rpx; color:var(--text-secondary); }
.chapter-numbers { display:block; margin-top:16rpx; font-size:23rpx; color:var(--text-secondary); }
.chapter-side { flex:none; width:116rpx; display:flex; flex-direction:column; align-items:flex-end; justify-content:space-between; gap:16rpx; }
.chapter-thumb,.chapter-letter { width:112rpx; height:112rpx; border-radius:var(--radius-medium); }
.chapter-letter { display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,255,255,.5); color:#8D9E82; font:400 44rpx/1 var(--font-display); }
.member-stack { display:flex; padding-left:12rpx; }
.member-bubble { display:flex; align-items:center; justify-content:center; flex:none; width:40rpx; height:40rpx; margin-left:-12rpx; border:3rpx solid #E7ECDC; border-radius:50%; overflow:hidden; background:#CDDBC6; color:#56715B; font-size:18rpx; }
.member-bubble>image { width:100%; height:100%; }
.palette-1 .member-bubble { border-color:#E9E5EF; }
.palette-2 .member-bubble { border-color:#F0E6D5; }
.chapter-empty.chapter-empty { width:100%; display:flex; justify-content:space-between; align-items:center; gap:24rpx; padding:24rpx 0; text-align:left; border-top:1rpx solid var(--line); }
.chapter-empty view>text { display:block; font-size:27rpx; }
.chapter-empty view>text+text { margin-top:6rpx; color:var(--text-secondary); font-size:23rpx; }
.chapter-empty>text { font-size:36rpx; color:var(--primary); }
.home-colophon { display:block; margin:40rpx 0 8rpx; text-align:center; color:var(--text-muted); font-size:22rpx; letter-spacing:1rpx; }
