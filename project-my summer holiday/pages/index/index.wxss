.home-page { min-height:100vh; overflow-x:hidden; }.home-masthead { height:100%; display:flex; align-items:center; padding-left:32rpx; }.home-wordmark { color:#34415D; font:700 48rpx/1 var(--font-display); letter-spacing:-2rpx; }.search-button.search-button { width:80rpx; height:80rpx; display:flex; align-items:center; justify-content:center; }.search-button image { width:34rpx; height:34rpx; }
.today-intro { padding:22rpx 0 30rpx; }.date-lockup { display:flex; align-items:center; gap:22rpx; }.date-day { font:400 116rpx/1 var(--font-display); letter-spacing:-6rpx; color:#455575; font-variant-numeric:tabular-nums; }.date-aside { border-left:1rpx solid var(--primary-soft); padding-left:22rpx; display:flex; flex-direction:column; gap:4rpx; font-size:23rpx; color:var(--text-secondary); }.today-dot { color:var(--primary); }.today-mark { margin-left:auto; align-self:flex-start; padding-top:12rpx; font:italic 24rpx/1.5 var(--font-display); color:var(--primary); }.today-title { display:block; margin-top:28rpx; font-size:40rpx; line-height:1.55; font-weight:500; letter-spacing:-1rpx; }.title-line { display:block; }.count-accent { color:var(--primary-deep); font:italic 48rpx/1 var(--font-display); }.today-note { display:block; font-size:25rpx; color:var(--text-secondary); margin-top:12rpx; }
.record-cta.record-cta { display:flex; align-items:center; gap:18rpx; width:100%; min-height:108rpx; padding:20rpx 28rpx; border-radius:30rpx; color:#fff; background:linear-gradient(110deg,#50678F,#7085A9); text-align:left; font-size:31rpx; font-weight:500; box-shadow:0 10rpx 22rpx rgba(67,89,125,.12); }.record-plus { width:48rpx; height:48rpx; border-radius:50%; border:1rpx solid rgba(255,255,255,.35); font-size:38rpx; font-weight:300; line-height:44rpx; text-align:center; }.cta-arrow { margin-left:auto; font-size:36rpx; font-weight:400; }.draft-resume.draft-resume { width:100%; display:flex; justify-content:space-between; gap:16rpx; min-height:78rpx; align-items:center; color:var(--text-secondary); font-size:23rpx; }.draft-resume text+text { color:var(--primary-deep); }
.section-head { min-height:76rpx; margin:30rpx 0 14rpx; }.section-title { font-size:32rpx; font-weight:600; }.section-caption { font-size:23rpx; color:var(--text-muted); }.section-link.section-link { min-height:76rpx; }.recent-scroll,.chapter-scroll { width:calc(100% + 32rpx); }.recent-cards { display:flex; gap:20rpx; padding:0 32rpx 6rpx 0; }.recent-card { width:292rpx; flex:none; min-width:0; }.recent-empty { display:flex; flex-direction:column; gap:10rpx; padding:22rpx 0 26rpx; font-size:29rpx; }.recent-empty text+text { color:var(--text-secondary); font-size:25rpx; }.empty-line { width:52rpx; height:3rpx; background:var(--primary-soft); margin-bottom:10rpx; }.more-note { display:block; text-align:center; padding:22rpx; font-size:24rpx; color:var(--text-muted); }
.echo-card.echo-card { position:relative; width:100%; overflow:hidden; margin-top:36rpx; border-radius:32rpx; text-align:left; background:#EAEFF5; }.echo-photo { position:absolute; width:64%; height:100%; right:0; top:0; }.echo-veil { position:absolute; inset:0; background:linear-gradient(115deg,#E8EDF4 0%,#EFF0F6 60%,#E4EAF3); }.echo-with-photo .echo-veil { background:linear-gradient(90deg,#E9EEF5 14%,rgba(233,238,245,.96) 34%,rgba(233,238,245,.5) 67%,rgba(233,238,245,.14)); }.echo-body { position:relative; padding:28rpx; }.echo-heading { display:flex; align-items:center; gap:12rpx; font-size:23rpx; color:#536885; }.echo-heading>image { width:32rpx; height:32rpx; }.echo-english { font:italic 23rpx/1.5 var(--font-display); margin-left:8rpx; }.echo-reason { display:block; max-width:94%; margin-top:24rpx; font:500 36rpx/1.5 var(--font-display); color:#344461; overflow-wrap:anywhere; }.echo-with-photo .echo-reason { max-width:83%; }.echo-explanation { display:block; font-size:25rpx; color:#52617A; line-height:1.7; margin-top:8rpx; max-width:88%; }.echo-excerpt { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-top:20rpx; font:italic 28rpx/1.8 var(--font-display); color:#67768F; overflow-wrap:anywhere; }.echo-bottom { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12rpx; margin-top:28rpx; font-size:22rpx; color:#687A94; }.echo-time-line { color:var(--primary); }.echo-open { color:#405777; }
.chapter-heading { margin-top:36rpx; }.chapter-caption { display:block; margin-top:6rpx; }.chapter-cards { display:flex; gap:18rpx; padding-right:32rpx; }.life-chapter.life-chapter { flex:none; width:620rpx; max-width:calc(100vw - 64rpx); padding:26rpx; border-radius:28rpx; display:flex; gap:16rpx; text-align:left; background:#EEF0F5; }.chapter-copy { flex:1; min-width:0; }.chapter-time { font-size:22rpx; color:var(--primary-deep); }.chapter-title { display:block; margin:8rpx 0; font:600 32rpx/1.4 var(--font-display); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.chapter-dates { font-size:21rpx; color:var(--text-secondary); }.chapter-numbers { display:block; margin-top:16rpx; font-size:23rpx; color:var(--text-secondary); }.chapter-side { flex:none; width:116rpx; display:flex; flex-direction:column; align-items:flex-end; justify-content:space-between; gap:16rpx; }.chapter-thumb,.chapter-letter { width:112rpx; height:112rpx; border-radius:22rpx; }.chapter-letter { background:#DFE5EF; color:#8796B1; display:flex; align-items:center; justify-content:center; font:400 44rpx/1 var(--font-display); }.member-stack { display:flex; padding-left:12rpx; }.member-bubble { flex:none; margin-left:-12rpx; width:40rpx; height:40rpx; border:3rpx solid #EEF0F5; border-radius:50%; overflow:hidden; background:#DCE3EE; color:#687D9D; display:flex; align-items:center; justify-content:center; font-size:18rpx; }.member-bubble>image { width:100%; height:100%; }.chapter-empty.chapter-empty { width:100%; display:flex; justify-content:space-between; align-items:center; padding:20rpx 0; text-align:left; border-top:1rpx solid var(--line); }.chapter-empty view>text { display:block; font-size:27rpx; }.chapter-empty view>text+text { font-size:23rpx; color:var(--text-muted); margin-top:6rpx; }.chapter-empty>text { font-size:38rpx; color:var(--primary); }.home-colophon { display:block; text-align:center; font-size:22rpx; color:var(--text-muted); margin:38rpx 0 6rpx; letter-spacing:2rpx; }
.home-masthead .search-button.search-button { margin-left:auto; margin-right:12rpx; }
