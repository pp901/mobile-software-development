.history-head { padding-top:6rpx; }.history-topline { display:flex; align-items:center; justify-content:space-between; }.gallery-brand { font-size:54rpx; font-weight:600; }.new-chapter { display:flex; gap:6rpx; align-items:center; min-height:64rpx; padding:0 18rpx; background:#e7ecdf; color:#5d7156; border-radius:32rpx; font-size:23rpx; }.history-copy { display:block; margin:24rpx 0 4rpx; font-size:22rpx; color:#96978b; }.tabs { margin-top:26rpx; }.tab-list { display:flex; justify-content:space-between; }.history-tab { position:relative; padding:20rpx 12rpx; color:#a0a194; font-size:25rpx; }.history-tab.active { color:#343b30; font-weight:600; }.history-tab.active::after { content:""; position:absolute; height:4rpx; background:#5d7156; bottom:0; left:14rpx; right:14rpx; }.gallery { margin-top:26rpx; display:flex; flex-direction:column; gap:22rpx; }.empty-action { margin-top:28rpx; }
