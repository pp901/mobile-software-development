.library { padding-top:32rpx; }.library-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.library-head>view { min-width:0; }.library-title { display:block; font:600 48rpx/1.3 var(--font-display); }.library-subtitle { display:block; margin-top:16rpx; color:var(--text-muted); font-size:25rpx; }.search-button.search-button { width:84rpx; min-height:88rpx; flex:none; display:flex; align-items:center; justify-content:center; background:var(--surface); border-radius:50%; }.search-button.search-button image { width:36rpx; height:36rpx; }.library-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin:28rpx 0; }.library-tabs { display:flex; gap:8rpx; }.library-tabs button[class] { min-height:88rpx; padding:14rpx 20rpx; color:var(--text-secondary); border-radius:20rpx; font-size:25rpx; display:flex; align-items:center; }.library-tabs .selected { background:var(--primary-pale); color:var(--primary-deep); font-weight:600; }.new-button.new-button { min-height:88rpx; color:var(--primary-deep); font-size:25rpx; white-space:nowrap; }.library-item { margin-bottom:28rpx; }

.library-tabs { min-width:0; gap:6rpx; }.library-tabs button[class] { padding:14rpx 18rpx; border-radius:999rpx; white-space:nowrap; }.library-head>view { flex:1; }.library-title { font-family:var(--font-ui); font-size:46rpx; letter-spacing:-1rpx; }.search-button.search-button { border-radius:28rpx; }.library-toolbar { gap:12rpx; }

.library-tabs button.selected { color:var(--primary-deep); }
