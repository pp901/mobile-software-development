.history-head { padding-top:6rpx; }.history-topline { display:flex; align-items:center; justify-content:space-between; }.gallery-brand { font-size:54rpx; font-weight:600; }.new-chapter { display:flex; gap:6rpx; align-items:center; min-height:64rpx; padding:0 18rpx; background:#f2bd42; color:#4b3608; border-radius:18rpx; font-size:23rpx; font-weight:700; box-shadow:0 6rpx 0 #c89220; }.history-copy { display:block; margin:24rpx 0 4rpx; font-size:22rpx; color:#787f78; }.tabs { margin-top:26rpx; }.tab-list { display:flex; justify-content:space-between; }.history-tab { position:relative; padding:20rpx 12rpx; color:#929990; font-size:25rpx; }.history-tab.active { color:#173f2d; font-weight:700; }.history-tab.active::after { content:""; position:absolute; height:5rpx; background:#ec765f; bottom:0; left:14rpx; right:14rpx; }.gallery { margin-top:26rpx; display:flex; flex-direction:column; gap:28rpx; }.empty-action { margin-top:28rpx; }
