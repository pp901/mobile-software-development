<view class="page-shell tabbar-space"><navigation-bar back="{{false}}" title="ongoing_"/><view class="library page-pad">
 <view class="library-head"><view><text class="library-title">{{reviewMode ? '回望' : '我的章节'}}</text><text class="library-subtitle">{{reviewMode ? '原来，平凡的日子里也有这么多。' : '每一段生活，都值得慢慢记录。'}}</text></view><button class="ui-button search-button" bindtap="openSearch" aria-label="搜索记录"><image src="/assets/icons/search.svg"/></button></view>
 <view wx:if="{{reviewMode}}" class="reading-tabs"><button class="ui-button {{reading === 'months' ? 'selected' : ''}}" data-value="months" bindtap="changeReading">按月份读</button><button class="ui-button {{reading === 'chapters' ? 'selected' : ''}}" data-value="chapters" bindtap="changeReading">按章节看</button></view>
 <block wx:if="{{reviewMode && reading === 'months'}}"><view wx:for="{{months}}" wx:key="key" class="month-section"><view class="month-heading"><text>{{item.label}}</text><view></view></view><moment-row wx:for="{{item.moments}}" wx:for-item="moment" wx:key="id" moment="{{moment}}" show-date bind:open="openMoment"/></view><text wx:if="{{hasMore}}" class="reading-more">向下滑动，继续翻阅</text><text wx:elif="{{months.length}}" class="reading-end">这是目前留下的全部 {{totalMoments}} 个 Moment。</text><view wx:else class="empty-state"><text class="empty-title">往后的某一天，<text>你会在这里遇见今天。</text></text><text class="empty-copy">留下一刻，时间会让它变得不同。</text><button class="ui-button primary-button" bindtap="createMoment">记录此刻</button></view></block>
 <block wx:else><view class="library-toolbar"><view class="library-tabs"><button wx:for="{{tabs}}" wx:key="key" class="ui-button {{active === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="changeTab">{{item.label}}</button></view><button wx:if="{{!reviewMode}}" class="ui-button new-button" bindtap="createChapter">＋ 新建</button></view><view class="library-item" wx:for="{{chapters}}" wx:key="id"><chapter-card chapter="{{item}}" compact="{{!reviewMode}}" bind:open="openChapter"/></view><view wx:if="{{!chapters.length}}" class="empty-state"><text class="empty-title">{{active === 'COMPLETED' ? '有些故事，还在继续' : '开启生活的新一章'}}</text><text class="empty-copy">{{active === 'COMPLETED' ? '进行中的章节，也可以随时回望。' : '给最近正在经历的生活取个名字。'}}</text><button wx:if="{{active !== 'COMPLETED'}}" class="ui-button primary-button" bindtap="createChapter">新建 Chapter</button></view></block>
 </view><app-tabbar active="{{reviewMode ? 'history' : 'chapters'}}"/></view>
