<view class="page-shell tabbar-space"><navigation-bar back="{{false}}" title="ongoing_"/><view class="library page-pad"><view class="library-head"><view><text class="library-title">{{reviewMode ? '回望' : '我的章节'}}</text><text class="library-subtitle">{{reviewMode ? '整理时光，遇见更完整的自己。' : '每一段生活，都值得慢慢记录。'}}</text></view><button class="ui-button search-button" bindtap="openSearch" aria-label="搜索记录"><image src="/assets/icons/search.svg"/></button></view><view class="library-toolbar"><view class="library-tabs"><button wx:for="{{tabs}}" wx:key="key" class="ui-button {{active === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="changeTab">{{item.label}}</button></view><button wx:if="{{!reviewMode}}" class="ui-button new-button" bindtap="createChapter">＋ 新建</button></view><view class="library-item" wx:for="{{chapters}}" wx:key="id"><chapter-card chapter="{{item}}" compact="{{!reviewMode}}" bind:open="openChapter"/></view><view wx:if="{{!chapters.length}}" class="empty-state"><text class="empty-title">{{active === 'COMPLETED' ? '有些故事，还在继续' : '开启生活的新一章'}}</text><text class="empty-copy">{{active === 'COMPLETED' ? '进行中的章节，也可以随时回望。' : '给最近正在经历的生活取个名字。'}}</text><button wx:if="{{active !== 'COMPLETED'}}" class="ui-button primary-button" bindtap="createChapter">新建 Chapter</button></view></view><app-tabbar active="{{reviewMode ? 'history' : 'chapters'}}"/></view>
