.chapter-invite-strip { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:16rpx 0; border-bottom:1rpx solid var(--line); }
.chapter-invite-strip>text { min-width:0; color:var(--text-secondary); font-size:23rpx; }
.chapter-invite-button.chapter-invite-button { display:flex; align-items:center; justify-content:center; flex:none; width:auto; min-height:88rpx; color:var(--primary-deep); font-size:24rpx; }
.chapter-read-error.chapter-read-error { display:block; width:100%; text-align:left; min-height:88rpx; color:var(--clay); font-size:24rpx; }
.chapter-page { padding-bottom:calc(144rpx + env(safe-area-inset-bottom)); }.chapter-hero { position:relative; min-height:490rpx; overflow:hidden; background:var(--lavender-soft); }.hero-image,.hero-placeholder,.hero-shade { position:absolute; inset:0; width:100%; height:100%; }.hero-placeholder { align-items:flex-start; justify-content:flex-end; padding:36rpx; }.hero-placeholder>image { width:70rpx; height:70rpx; }.hero-shade { background:linear-gradient(180deg,rgba(40,25,42,.03),rgba(40,25,42,.65)); }.hero-content { position:relative; padding:112rpx 40rpx 64rpx; }.has-cover .hero-content { color:white; }.hero-label { font-size:22rpx; letter-spacing:2rpx; opacity:.8; }.chapter-title { display:block; margin:14rpx 0; font:600 46rpx/1.4 var(--font-display); overflow-wrap:anywhere; }.chapter-description { display:block; font-size:26rpx; line-height:1.7; opacity:.9; }.chapter-dates { display:block; margin-top:20rpx; font-size:23rpx; opacity:.85; }.hero-bottom { margin-top:24rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.hero-members.hero-members { display:flex; align-items:center; gap:16rpx; font-size:23rpx; min-width:0; text-align:left; }.avatar-stack { display:flex; padding-left:10rpx; flex:none; }.member-avatar { margin-left:-10rpx; width:44rpx; height:44rpx; border:2rpx solid white; border-radius:50%; overflow:hidden; background:var(--primary-soft); color:var(--primary-deep); display:flex; align-items:center; justify-content:center; }.member-avatar image { width:100%; height:100%; }.hero-more.hero-more { width:80rpx; min-height:80rpx; font-size:28rpx; letter-spacing:4rpx; flex:none; }
.chapter-body { position:relative; margin-top:-32rpx; border-radius:36rpx 36rpx 0 0; background:var(--bg); min-height:500rpx; }.chapter-tabs { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); padding:12rpx 24rpx 0; border-bottom:1rpx solid var(--line); }.chapter-tabs button[class] { position:relative; min-height:94rpx; font-size:26rpx; color:var(--text-secondary); }.chapter-tabs .selected { color:var(--primary-deep); font-weight:600; }
.calendar-panel { padding-top:24rpx; }.calendar-title { display:flex; align-items:center; justify-content:space-between; font-size:30rpx; font-weight:600; }.month-arrows { display:flex; }.month-arrows button[class] { width:80rpx; min-height:88rpx; display:flex; align-items:center; justify-content:center; }.month-arrows image { width:32rpx; height:32rpx; }.calendar-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); }.week { color:var(--text-muted); font-size:23rpx; text-align:center; padding:14rpx 0; }.calendar-day.calendar-day { position:relative; width:100%; height:82rpx; display:flex; align-items:center; justify-content:center; color:var(--text-secondary); font-size:25rpx; font-variant-numeric:tabular-nums; }.calendar-day.calendar-day>text { width:62rpx; height:62rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; }.calendar-day.calendar-day.selected>text { background:var(--primary-deep); color:#fff; }.calendar-day.calendar-day.today:not(.selected)>text { background:var(--primary-pale); color:var(--primary-deep); }.calendar-day.calendar-day.muted { color:#C8C2CA; }.day-dot { position:absolute; bottom:6rpx; width:7rpx; height:7rpx; border-radius:50%; background:var(--primary); }.calendar-day.calendar-day.selected .day-dot { background:var(--primary-deep); }.day-heading { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin:30rpx 0 12rpx; padding-top:26rpx; border-top:1rpx solid var(--line); font-size:26rpx; font-weight:500; }.day-heading text+text { color:var(--text-muted); font-size:23rpx; font-weight:400; }.day-empty { padding:32rpx 0; font-size:26rpx; color:var(--text-muted); }.more-note { display:block; text-align:center; font-size:24rpx; color:var(--text-muted); }
.record-button.record-button { position:fixed; z-index:40; right:32rpx; bottom:calc(28rpx + env(safe-area-inset-bottom)); width:92rpx; height:92rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:white; background:var(--primary-deep); box-shadow:var(--elevation-material); }.record-button.record-button text { font-size:48rpx; line-height:1; }
.goal-count { font-size:26rpx; color:var(--primary-deep); }.goal-row { display:flex; gap:16rpx; align-items:center; border-bottom:1rpx solid var(--line); padding:12rpx 0; }.goal-check.goal-check { width:80rpx; min-height:88rpx; flex:none; display:flex; align-items:center; justify-content:center; }.goal-check.goal-check>text { width:38rpx; height:38rpx; border:2rpx solid var(--primary-soft); border-radius:12rpx; line-height:34rpx; color:white; }.goal-check.goal-check.done>text { background:var(--primary); border-color:var(--primary); }.goal-title { flex:1; min-width:0; font-size:28rpx; overflow-wrap:anywhere; }.goal-title.completed { color:var(--text-muted); text-decoration:line-through; }.goal-edit.goal-edit { width:76rpx; min-height:88rpx; flex:none; display:flex; align-items:center; justify-content:center; }.goal-edit.goal-edit image { width:30rpx; height:30rpx; }.goal-add.goal-add { margin-top:32rpx; }.goal-input { height:120rpx; margin:24rpx 0; padding:0 24rpx; background:var(--surface-soft); border-radius:16rpx; }
.members-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:30rpx 14rpx; }.member-item.member-item { display:flex; flex-direction:column; align-items:center; min-width:0; gap:10rpx; }.member-photo { width:92rpx; height:92rpx; border-radius:50%; background:var(--primary-pale); color:var(--primary); display:flex; align-items:center; justify-content:center; font-size:38rpx; overflow:hidden; }.member-photo image { width:100%; height:100%; }.member-name { max-width:100%; text-align:center; font-size:25rpx; overflow-wrap:anywhere; }.member-role { font-size:21rpx; color:var(--text-muted); }.members-note { display:block; padding:36rpx 0; color:var(--text-muted); font-size:26rpx; }.chapter-review { padding:36rpx 0; }.review-quote { display:block; font-family:var(--font-display); font-size:34rpx; line-height:1.8; }.review-summary { display:flex; gap:24rpx; color:var(--primary-deep); margin:24rpx 0; font-size:26rpx; }.review-thumbnails { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; margin-bottom:32rpx; }

.calendar-day.calendar-day { height:max(82rpx,44px); }

.record-button.record-button { min-width:44px; min-height:44px; }

.chapter-tabs button[class] { display:flex; align-items:center; justify-content:center; }.chapter-tabs button.selected { color:var(--primary-deep); }.tab-indicator { position:absolute; bottom:0; left:calc(50% - 18rpx); width:36rpx; height:5rpx; border-radius:999rpx; background:var(--primary-deep); }
.chapter-life-stats { display:flex; flex-wrap:wrap; gap:8rpx 24rpx; margin-top:18rpx; font-size:25rpx; }.chapter-life-stats>text:first-child { font-weight:600; }.chapter-life-stats>text+text { opacity:.85; }.hero-content { padding-top:80rpx; }.chapter-dates { margin-top:16rpx; }
