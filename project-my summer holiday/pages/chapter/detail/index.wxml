<view class="page-shell chapter-page" wx:if="{{chapter}}">
 <navigation-bar title="Chapter"/>
 <view class="chapter-hero {{chapter.cover && !coverFailed ? 'has-cover' : ''}}">
  <image wx:if="{{chapter.cover && !coverFailed}}" class="hero-image" src="{{chapter.displayCover || chapter.cover}}" mode="aspectFill" binderror="heroImageError"/><view wx:else class="hero-placeholder media-placeholder"><image src="/assets/icons/image.svg"/></view><view wx:if="{{chapter.cover && !coverFailed}}" class="hero-shade"></view>
  <view class="hero-content"><text class="hero-label">CHAPTER · {{chapter.status === 'ONGOING' ? '进行中' : '已结束'}}</text><text class="chapter-title">{{chapter.title}}</text><text wx:if="{{chapter.description}}" class="chapter-description">{{chapter.description}}</text><text class="chapter-dates">{{chapter.dateRange}}</text><view class="chapter-life-stats"><text>{{chapter.elapsedLabel}}</text><text>{{chapter.momentCount}} Moment · {{chapter.recordedDayCount}} 个记录日</text></view><view class="hero-bottom"><button class="ui-button hero-members" bindtap="openMembers"><view class="avatar-stack"><view wx:for="{{chapter.memberPreview}}" wx:key="id" class="member-avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"/><text wx:else>{{item.nickname ? item.nickname[0] : '我'}}</text></view></view><text>{{chapter.memberCount > 1 ? chapter.memberCount + ' 人一起经历' : '我的这一段生活'}}</text></button><button class="ui-button hero-more" bindtap="more" aria-label="Chapter 操作">•••</button></view></view>
 </view>
 <view class="chapter-body">
  <view class="chapter-tabs" role="tablist"><button wx:for="{{tabs}}" wx:key="*this" class="ui-button {{activeTab === item ? 'selected' : ''}}" data-tab="{{item}}" bindtap="selectTab" role="tab" aria-selected="{{activeTab === item}}"><text>{{item}}</text><view wx:if="{{activeTab === item}}" class="tab-indicator"></view></button></view>
  <view class="page-pad">
   <view wx:if="{{chapter.isOwner}}" class="chapter-invite-strip">
    <text>{{chapter.memberCount > 1 ? chapter.memberCount + ' 人，一起记住这段生活' : '这一段生活，也可以一起记。'}}</text>
    <button wx:if="{{invite}}" class="ui-button chapter-invite-button" open-type="share">邀请一起记录</button>
    <button wx:else class="ui-button chapter-invite-button" bindtap="prepareInvite" loading="{{preparingInvite}}" disabled="{{preparingInvite}}">{{preparingInvite ? '准备邀请' : '重试邀请'}}</button>
   </view>
   <text wx:if="{{inviteError}}" class="inline-error">{{inviteError}}</text>
   <button wx:if="{{readError}}" class="ui-button chapter-read-error" bindtap="refreshChapter">{{readError}} · 点击重试</button>
   <block wx:if="{{activeTab === '瞬间'}}"><view class="section-head"><text class="section-title">这一章的瞬间</text><button wx:if="{{chapter.memberCount > 1}}" class="ui-button section-link" bindtap="filterMine">{{filter === 'all' ? '我参与的' : '查看全部'}}</button></view><moment-card wx:for="{{moments}}" wx:key="id" moment="{{item}}" show-chapter="{{false}}" bind:open="openMoment"/><view wx:if="{{!moments.length}}" class="empty-state"><text class="empty-title">{{filter === 'mine' ? '还没有参与的记录' : '从一个小小的瞬间开始'}}</text><text class="empty-copy">把这一章的日常，留在这里。</text></view><text wx:if="{{hasMore}}" class="more-note">向下滑动，继续回看</text></block>
   <view wx:elif="{{activeTab === '日历'}}" class="calendar-panel">
    <view class="calendar-title"><text>{{calendar.monthLabel}}</text><view class="month-arrows"><button class="ui-button" bindtap="previousMonth" aria-label="上个月"><image src="/assets/icons/chevron-left.svg"/></button><button class="ui-button" bindtap="nextMonth" aria-label="下个月"><image src="/assets/icons/chevron-right.svg"/></button></view></view>
    <view class="calendar-grid week"><text wx:for="{{calendar.weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="calendar-grid days"><button wx:for="{{calendar.days}}" wx:key="key" data-key="{{item.key}}" bindtap="selectDay" class="ui-button calendar-day {{item.isSelected ? 'selected' : ''}} {{!item.inMonth ? 'muted' : ''}} {{item.isToday ? 'today' : ''}}" aria-label="{{item.key}}，{{item.count}} 个瞬间{{item.isSelected ? '，已选择' : ''}}"><text>{{item.day}}</text><view class="day-dot" wx:if="{{item.count}}"></view></button></view>
    <view class="day-heading"><text>{{calendar.selectedDateLabel}}</text><text>{{calendar.selectedMomentCount}} 个瞬间</text></view>
    <moment-row wx:for="{{calendar.selectedMoments}}" wx:key="id" moment="{{item}}" bind:open="openMoment"/>
    <view wx:if="{{!calendar.selectedMomentCount}}" class="day-empty"><text>这一天，还没有留下记录。</text><button wx:if="{{chapter.canAddMoment}}" class="ui-button section-link" bindtap="recordSelectedDay">补记这一天 →</button></view>
   </view>
   <view wx:elif="{{activeTab === '目标'}}" class="goals-panel"><view class="section-head"><text class="section-title">想一起完成的事</text><text class="goal-count">{{chapter.goalsDone}} / {{chapter.goalsTotal}}</text></view><view class="goal-row" wx:for="{{chapter.goals}}" wx:key="id"><button class="ui-button goal-check {{item.done ? 'done' : ''}}" data-id="{{item.id}}" bindtap="toggleGoal" disabled="{{chapter.status !== 'ONGOING' || !chapter.isOwner}}" aria-label="{{item.done ? '标为未完成：' : '完成目标：'}}{{item.title}}"><text>{{item.done ? '✓' : ''}}</text></button><text class="goal-title {{item.done ? 'completed' : ''}}">{{item.title}}</text><button wx:if="{{chapter.isOwner}}" class="ui-button goal-edit" data-id="{{item.id}}" bindtap="openGoal" aria-label="编辑目标"><image src="/assets/icons/pencil.svg"/></button></view><text wx:if="{{!chapter.isOwner}}" class="members-note">目标由章节创建者维护。</text><text wx:if="{{!chapter.goals.length}}" class="empty-copy">一次出发，或一个小愿望。</text><button wx:if="{{chapter.isOwner}}" class="ui-button secondary-button goal-add" bindtap="openGoal">＋ 添加目标</button></view>
   <view wx:elif="{{activeTab === '成员'}}" class="members-panel"><view class="section-head"><text class="section-title">一起走过这一章</text><button class="ui-button section-link" bindtap="openMembers">{{chapter.isOwner ? '管理 ›' : '查看 ›'}}</button></view><view class="members-grid"><view wx:for="{{chapter.members}}" wx:key="id" class="member-item"><view class="member-photo"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"/><text wx:else>{{item.nickname ? item.nickname[0] : '我'}}</text></view><text class="member-name">{{item.nickname}}</text><text class="member-role">{{item.id === chapter.ownerId ? '创建者' : '共同记录者'}}</text></view><button wx:if="{{chapter.isOwner}}" class="ui-button member-item invite-member" bindtap="openMembers"><view class="member-photo">＋</view><text class="member-name">邀请</text></button></view><text class="members-note">和重要的人，一起把这段日子留住。</text></view>
   <view wx:elif="{{activeTab === '回望'}}" class="chapter-review"><text class="review-quote">{{chapter.ending || chapter.description || '每一段记录，都让这一章更完整。'}}</text><view class="review-summary"><text>{{chapter.recordedDayCount}} 天有记录</text><text>{{chapter.momentCount}} 个 Moment</text></view><view wx:if="{{reviewPhotos.length}}" class="review-thumbnails"><view wx:for="{{reviewPhotos}}" wx:key="id"><moment-card moment="{{item}}" layout="compact" bind:open="openMoment"/></view></view><button class="ui-button primary-button" bindtap="openReview">回望这一章 →</button></view>
  </view>
 </view>
 <button wx:if="{{chapter.canAddMoment}}" class="ui-button record-button" bindtap="createMoment" aria-label="记录此刻"><text>＋</text></button>
 <view wx:if="{{goalPanel}}" class="sheet-mask" bindtap="closeGoal"><view class="sheet" catchtap="noop"><text class="sheet-title">{{goalId ? '编辑目标' : '一个小目标'}}</text><input class="goal-input" value="{{goalTitle}}" bindinput="inputGoal" maxlength="100" placeholder="想在这一章完成什么？"/><text wx:if="{{goalError}}" class="inline-error">{{goalError}}</text><button class="ui-button primary-button" bindtap="saveGoal">保存目标</button><button wx:if="{{goalId}}" class="ui-button sheet-close" bindtap="deleteGoal">删除目标</button><button class="ui-button sheet-close" bindtap="closeGoal">取消</button></view></view>
</view>
<view wx:elif="{{missing}}" class="page-pad"><navigation-bar title="Chapter"/><view class="empty-state"><text class="empty-title">{{refreshing ? '正在读取 Chapter' : '无法打开这个 Chapter'}}</text><text class="empty-copy">{{readError || '记录不存在，或你没有阅读权限。'}}</text><button class="ui-button section-link" bindtap="refreshChapter" disabled="{{refreshing}}">重新读取</button><button class="ui-button secondary-button" bindtap="goBack">返回</button></view></view>
