<view class="chapter-page" wx:if="{{chapter}}">
  <navigation-bar title="" background="#F7F3EA"><button slot="right" class="nav-circle" bindtap="more"><image src="/assets/icons/more.svg"/></button></navigation-bar>
  <view class="hero"><image class="hero-photo" src="{{chapter.cover}}" mode="aspectFill"/><view class="hero-shade"></view><view class="status-chip {{chapter.status === 'COMPLETED' ? 'done' : ''}}">{{chapter.statusText}}</view></view>
  <view class="chapter-paper">
    <view class="hero-copy"><text class="eyebrow">{{chapter.englishTitle}}</text><text class="hero-title brand-serif">{{chapter.title}}</text><text class="hero-description">{{chapter.dateRange}}</text><view class="hero-progress"><view><text>DAY {{chapter.dayCurrent}} / {{chapter.dayTotal}}</text><text>{{chapter.progress}}%</text></view><view class="hero-track"><view style="width:{{chapter.progress}}%"></view></view></view></view>
    <button class="member-banner" bindtap="openMembers"><view class="member-avatars"><image wx:for="{{chapter.memberPreview}}" wx:key="id" src="{{item.avatar}}" mode="aspectFill"/></view><view><text>{{chapter.memberCount}} 人共同记录</text><text>查看成员与邀请朋友</text></view><text class="arrow">›</text></button>
    <view class="chapter-stats"><view><text class="stat-number">{{chapter.momentCount}}</text><text>瞬间</text></view><view><text class="stat-number">{{chapter.placeCount}}</text><text>足迹</text></view><view><text class="stat-number">{{chapter.goalsDone}}/{{chapter.goalsTotal}}</text><text>目标</text></view><view><text class="stat-number">{{chapter.pendingCount}}</text><text>待补完</text></view></view>
    <scroll-view class="chapter-tabs" scroll-x><view class="chapter-tab-list"><button wx:for="{{chapter.modules}}" wx:key="*this" class="chapter-tab {{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="changeTab">{{item}}</button></view></scroll-view>
    <view class="chapter-content page-pad safe-bottom">
      <block wx:if="{{activeTab === '瞬间'}}">
        <view class="content-intro"><view><text class="eyebrow">SHARED TIMELINE</text><text class="content-title">共同时间线</text></view><button wx:if="{{chapter.canAddMoment}}" class="small-add" bindtap="createMoment">＋ 快速记录</button></view>
        <scroll-view class="filter-scroll" scroll-x><view class="filter-row"><button wx:for="{{filters}}" wx:key="id" class="filter-pill {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeFilter"><image wx:if="{{item.avatar}}" src="{{item.avatar}}"/>{{item.nickname}}</button></view></scroll-view>
        <view class="timeline" wx:if="{{moments.length}}"><view class="timeline-row" wx:for="{{visibleMoments}}" wx:key="id"><view class="timeline-mark"><view class="timeline-dot {{item.status === 'DRAFT' ? 'draft' : ''}}"></view><view class="timeline-line"></view></view><view class="timeline-card"><moment-card moment="{{item}}" bind:open="openMoment"/></view></view></view>
        <view wx:else class="empty-state surface"><text class="empty-mark">＋</text><text class="empty-title">这里还没有片刻</text><text class="empty-copy">拍一张、写一句或说一段，3 秒也可以开始。</text><button wx:if="{{chapter.canAddMoment}}" class="secondary-button empty-action" bindtap="createMoment">留下第一个 Moment</button></view>
        <button wx:if="{{visibleMoments.length < moments.length}}" class="secondary-button more-button" bindtap="showAll">查看全部 {{moments.length}} 个</button>
      </block>
      <block wx:elif="{{activeTab === '足迹' || activeTab === '地图' || activeTab === '路线'}}"><view class="content-intro"><view><text class="eyebrow">PLACES</text><text class="content-title">故事发生过的地方</text></view></view><view class="place-hero"><text class="big-number">{{places.length}}</text><text>个地方，被这一章记住</text></view><view class="place-grid"><view class="place-card" wx:for="{{places}}" wx:key="name"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><view><text>{{item.name}}</text><text>{{item.count}} 个 Moment</text></view></view></view></block>
      <block wx:elif="{{activeTab === '目标' || activeTab === '进度' || activeTab === '里程碑'}}"><view class="content-intro"><view><text class="eyebrow">WISH LIST</text><text class="content-title">想在这一章完成</text></view><button wx:if="{{chapter.isOwner && chapter.status === 'ONGOING'}}" class="small-add" bindtap="showGoalPanel">＋ 新目标</button></view><view class="goal-summary surface"><text class="goal-percent">{{completion}}%</text><view><text>{{chapter.goalsDone}} 件事已经发生</text><text>所有成员都可以一起点亮进度</text></view></view><view class="goal-list surface"><button class="goal-row" wx:for="{{chapter.goals}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleGoal" bindlongpress="editGoal"><view class="goal-check {{item.done ? 'done' : ''}}">{{item.done ? '✓' : ''}}</view><text class="{{item.done ? 'done-text' : ''}}">{{item.title}}</text></button></view></block>
      <block wx:else><view class="review-preview"><text class="eyebrow">CHAPTER REVIEW</text><text class="review-title brand-serif">这一章，{{chapter.status === 'ONGOING' ? '仍在发生。' : '写完了。'}}</text><text class="review-copy">把天数、足迹、共同记录和完整时间线收进一张回望。</text><button class="primary-button" bindtap="openReview">{{chapter.status === 'ONGOING' ? '预览回望' : '完整回望'}}</button><button wx:if="{{chapter.isOwner && chapter.status === 'ONGOING'}}" class="finish-link" bindtap="finishChapter">结束这一章</button></view></block>
    </view>
  </view>
  <button wx:if="{{chapter.canAddMoment}}" class="floating-add" bindtap="createMoment">＋</button>
  <view wx:if="{{goalPanel}}" class="modal-mask" bindtap="closeGoalPanel"><view class="goal-modal" catchtap="noop"><text>{{editingGoalId ? '编辑目标' : '新的小目标'}}</text><input value="{{goalTitle}}" bindinput="inputGoal" maxlength="40" focus placeholder="例如：看一次日落"/><button class="primary-button" bindtap="saveGoal">保存</button><button wx:if="{{editingGoalId}}" class="delete-goal" bindtap="deleteGoal">删除目标</button></view></view>
</view>
