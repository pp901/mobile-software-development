page{background:#f7f3ea}.members-page{padding-bottom:70rpx}.members-hero{margin-top:22rpx;padding:34rpx 28rpx;border-radius:28rpx;background:#173f2d;color:#fff;box-shadow:0 10rpx 0 #0d2d20,0 24rpx 42rpx rgba(23,63,45,.18)}.avatar-stack{display:flex;padding-left:18rpx}.avatar-stack image{width:76rpx;height:76rpx;margin-left:-18rpx;border:5rpx solid #173f2d;border-radius:50%;background:#dcecdf}.hero-count{display:block;margin-top:26rpx;font-size:38rpx;font-weight:700}.hero-copy{display:block;margin-top:10rpx;color:#bed3c5;font-size:22rpx;line-height:1.7}.invite-button{width:100%;height:88rpx;margin-top:28rpx;border-radius:18rpx;background:#f2bd42;color:#4b3608;font-weight:700;box-shadow:0 7rpx 0 #b9871b}.invite-button[disabled]{opacity:.7}.member-limit{color:#777f78;font-size:21rpx}.member-list{overflow:hidden;border-radius:24rpx;background:#fffdf8;box-shadow:0 7rpx 0 rgba(43,72,54,.07)}.member-row{min-height:112rpx;padding:18rpx 20rpx;display:flex;align-items:center;gap:16rpx;border-bottom:1rpx solid #eee8dc}.member-row:last-child{border:0}.member-row>image{width:66rpx;height:66rpx;border-radius:50%;background:#dcecdf}.member-row>view{min-width:0;flex:1}.member-row>view text{display:block;font-size:24rpx;font-weight:600}.member-row>view text+text{margin-top:5rpx;color:#888e88;font-size:19rpx;font-weight:400}.member-row button{padding:12rpx 16rpx;border-radius:12rpx;background:#ffe0d7;color:#a44433;font-size:19rpx}.role{color:#60806e;font-size:16rpx;letter-spacing:1rpx}.rule-card{margin-top:24rpx;padding:25rpx;border-radius:22rpx;background:#dcebf6;color:#315873;box-shadow:0 6rpx 0 #bfd8ea}.rule-card text{display:block;font-size:24rpx;font-weight:700}.rule-card text+text{margin-top:8rpx;font-size:20rpx;font-weight:400;line-height:1.7}.leave-button{width:100%;margin-top:32rpx;padding:26rpx;color:#bd4b37}
