.members-title{display:block;font-size:56rpx;font-weight:600;line-height:1.3;margin:64rpx 0 24rpx;overflow-wrap:anywhere}.members-description,.invite-scope{display:block;font-size:28rpx;color:var(--text-secondary);margin-bottom:48rpx}.member-row{display:flex;align-items:center;gap:28rpx;padding:40rpx 0;border-bottom:2rpx solid var(--border-subtle)}.member-row image,.avatar-placeholder{width:88rpx;height:88rpx;border-radius:50%;background:var(--background-secondary);text-align:center;line-height:88rpx}.member-copy{flex:1;min-width:0}.member-copy text{display:block;overflow-wrap:anywhere}.member-role{font-size:24rpx;color:var(--text-secondary)}.remove.remove{min-height:88rpx;min-width:88rpx;color:var(--danger);font-size:28rpx}.invite-box,.leave.leave{margin-top:64rpx}