.members-heading { padding:36rpx 0 24rpx; }
.members-title { display:block; font-size:40rpx; font-weight:600; line-height:1.4; overflow-wrap:anywhere; }
.members-description { display:block; margin-top:16rpx; color:var(--text-secondary); font-size:25rpx; }
.member-row { display:flex; align-items:center; gap:20rpx; padding:24rpx 0; border-bottom:1rpx solid var(--line); }
.member-avatar { flex:none; display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; border-radius:50%; overflow:hidden; background:var(--sage); color:var(--primary-deep); }
.member-avatar>image { width:100%; height:100%; }
.member-copy { flex:1; min-width:0; }
.member-copy>text { display:block; overflow-wrap:anywhere; font-size:28rpx; }
.member-copy>.member-role { font-size:23rpx; color:var(--text-secondary); margin-top:4rpx; }
.remove.remove { display:flex; align-items:center; justify-content:center; flex:none; width:auto; min-width:88rpx; min-height:88rpx; color:var(--text-secondary); font-size:25rpx; }
.invite-box,.leave.leave { margin-top:48rpx; }
.invite-scope { display:block; text-align:center; font-size:23rpx; color:var(--text-secondary); margin:20rpx 12rpx; }
