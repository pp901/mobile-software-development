<view class="page-shell safe-bottom">
 <navigation-bar title="一起记录的人"/>
 <view class="page-pad" wx:if="{{chapter}}">
  <view class="members-heading"><text class="members-title">{{chapter.title}}</text><text class="members-description">{{members.length}} 人在这一段生活里 · 各自留下，也一起记得</text></view>
  <view class="member-row" wx:for="{{members}}" wx:key="id">
   <view class="member-avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-index="{{index}}" binderror="avatarError"/><text wx:else>{{item.nickname[0]}}</text></view>
   <view class="member-copy"><text>{{item.nickname}}{{item.isMe ? '（我）' : ''}}</text><text class="member-role">{{item.isOwner ? 'Chapter 创建者' : '共同记录者'}}</text></view>
   <button wx:if="{{chapter.isOwner && !item.isOwner}}" class="ui-button remove" data-id="{{item.id}}" bindtap="removeMember" disabled="{{busy}}">移除</button>
  </view>
  <view wx:if="{{chapter.isOwner}}" class="invite-box">
   <button class="ui-button primary-button" loading="{{preparing}}" disabled="{{preparing}}" bindtap="copyInvite">{{preparing ? '正在准备邀请' : '复制邀请信息'}}</button>
   <text class="invite-scope">把邀请信息发给朋友。对方在「生活 → 加入共同记录」粘贴后确认加入，7 天内有效。</text>
  </view>
  <button wx:else class="ui-button danger-button leave" bindtap="leave" disabled="{{busy}}">退出 Chapter</button>
 </view>
 <view wx:else class="page-pad empty-state"><text class="empty-title">{{loading ? '正在读取成员' : '暂时无法打开这个 Chapter'}}</text><button wx:if="{{!loading}}" class="ui-button secondary-button" bindtap="refresh">重新读取</button><button class="ui-button section-link" bindtap="goHome">返回生活</button></view>
 <text wx:if="{{error}}" class="inline-error page-pad">{{error}}</text>
</view>
