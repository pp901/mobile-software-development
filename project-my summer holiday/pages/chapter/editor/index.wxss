.chapter-form { padding-top:72rpx; }.form-title { display:block; font-size:52rpx; font-weight:600; letter-spacing:-1rpx; line-height:1.35; }.name-input { height:176rpx; margin:32rpx 0; font-size:44rpx; border-bottom:2rpx solid var(--border-subtle); }.placeholder { color:var(--text-muted); }.date-row { display:flex; align-items:center; justify-content:space-between; gap:24rpx; min-height:120rpx; font-size:30rpx; }.date-row picker>view { min-height:88rpx; display:flex; align-items:center; color:var(--accent); }.optional.optional { width:100%; min-height:128rpx; display:flex; justify-content:space-between; align-items:center; text-align:left; font-size:30rpx; }.optional-meta { display:flex; align-items:center; gap:16rpx; color:var(--text-secondary); font-size:26rpx; }.cover-picker.cover-picker { width:100%; height:320rpx; margin:24rpx 0; border-radius:24rpx; overflow:hidden; background:linear-gradient(135deg,var(--blush-soft),var(--lavender-soft),var(--blue-soft)); }.cover-picker.cover-picker>image { width:100%; height:100%; }.cover-picker.cover-picker>view { height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:24rpx; font-size:28rpx; color:var(--text-secondary); }.cover-picker.cover-picker>view image { width:48rpx; height:48rpx; }.remove-cover.remove-cover { min-height:88rpx; color:var(--text-secondary); font-size:26rpx; }.description { min-height:200rpx; padding:32rpx 0; font-size:32rpx; line-height:1.7; }.primary-button.primary-button { margin-top:72rpx; }.privacy-note { display:block; margin-top:32rpx; color:var(--text-secondary); font-size:24rpx; text-align:center; }
