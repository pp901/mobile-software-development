.editor { padding-top: 34rpx; }
.editor-head>.eyebrow { display:none; }
.editor-title {
  display: block;
  max-width: 630rpx;
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.32;
  letter-spacing: -2rpx;
}
.editor-lead { display: block; max-width: 590rpx; margin-top: 16rpx; color: #858b85; font-size: 22rpx; line-height: 1.65; }

.cover-picker {
  position: relative;
  width: 100%;
  height: 300rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border-radius: 22rpx;
  box-shadow: 0 16rpx 38rpx rgba(45,54,48,.12);
  text-align: left;
}
.cover-picker>image, .cover-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.cover-shade { background: linear-gradient(180deg, rgba(20,25,22,.08), rgba(20,25,22,.62)); }
.cover-label { position: absolute; left: 26rpx; right: 26rpx; bottom: 26rpx; color: #fff; }
.cover-label text { display: block; }
.cover-label text:last-child { margin-top: 9rpx; color: rgba(255,255,255,.74); font-size: 20rpx; }
.cover-action {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  min-height: 62rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border-radius: 17rpx;
  background: rgba(255,254,250,.9);
  color: #34443a;
  font-size: 20rpx;
}
.cover-action image { width: 29rpx; height: 29rpx; opacity: .72; }

.form-section { margin-top:30rpx; padding:0 0 24rpx; border:0; border-bottom:1rpx solid #e9e9de; border-radius:0; background:transparent; box-shadow:none; }
.form-heading { padding-bottom:8rpx; }
.step { display:none; }
.form-title, .section-desc { display: block; }
.form-title { font-size: 28rpx; font-weight: 600; }
.section-desc { margin-top: 7rpx; color: #929791; font-size: 21rpx; line-height: 1.45; }

.field { margin-top: 24rpx; }
.field-label { display: block; color: #707770; font-size: 20rpx; }
.text-input {
  width:100%;
  height: 84rpx;
  border-bottom: 1rpx solid rgba(38,49,43,.12);
  font-family: Georgia, "Songti SC", serif;
  font-size: 32rpx;
}
.text-area {
  width: 100%;
  min-height: 106rpx;
  padding: 20rpx 0 12rpx;
  border-bottom: 1rpx solid rgba(38,49,43,.12);
  font-size: 25rpx;
  line-height: 1.65;
}
.placeholder { color: #adb0ab; }

.template-grid { margin-top: 24rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.template-card {
  position: relative;
  min-width: 0;
  height: 140rpx;
  padding: 17rpx;
  display: flex;
  align-items: center;
  gap: 13rpx;
  border: 1rpx solid rgba(38,49,43,.08);
  border-radius: 20rpx;
  background: #f8f6f1;
  text-align: left;
}
.template-card.active { border-color: #8da293; background: #e8eee9; }
.template-mark {
  width: 49rpx;
  height: 49rpx;
  flex: none;
  border-radius: 15rpx;
  background: #eee9df;
  color: #587362;
  font-family: "STKaiti", serif;
  line-height: 49rpx;
  text-align: center;
}
.template-card.active .template-mark { background: #fffefa; }
.template-name, .template-copy { display: block; }
.template-card>view { min-width:0; flex:1; }
.template-name { font-size: 23rpx; font-weight: 600; }
.template-copy { margin-top:6rpx; color:#8e938d; font-size:20rpx; line-height:1.4; white-space:normal; }
.selected-mark { position: absolute; right: 10rpx; top: 8rpx; color: #587362; font-size: 18rpx; }

.date-row { margin-top: 24rpx; display: grid; grid-template-columns: 1fr 38rpx 1fr; align-items: center; gap: 7rpx; }
.date-row picker { min-width: 0; }
.date-field { width: 100%; padding: 21rpx 18rpx; border-radius: 19rpx; background: #f3f1eb; }
.date-field text { display: block; }
.date-field text:first-child { color: #8c918b; font-size: 18rpx; }
.date-field text:last-child { margin-top: 8rpx; overflow: hidden; font-family: Georgia, serif; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.date-dash { color: #9ba09b; font-size: 23rpx; text-align: center; }

.module-row { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 11rpx; }
.module-chip {
  min-height: 66rpx;
  padding: 0 19rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border: 1rpx solid transparent;
  border-radius: 18rpx;
  background: #f0eee8;
  color: #777d77;
  font-size: 22rpx;
}
.module-chip.active { border-color: #c2d0c5; background: #e5ece7; color: #385344; }
.module-chip.fixed { opacity: .84; }
.module-check { width: 28rpx; height: 28rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid currentColor; border-radius: 9rpx; }
.module-check image { width: 23rpx; height: 23rpx; }

.save-area { padding: 42rpx 0 14rpx; }
.save-button { width: 100%; }
.save-note { display: block; margin-top: 16rpx; color: #979b96; font-size: 19rpx; text-align: center; }
