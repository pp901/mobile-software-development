<view class="page-shell safe-bottom"><navigation-bar title="{{id ? '编辑 Chapter' : '新建 Chapter'}}" intercept-back bind:back="handleBack"/><view class="chapter-form page-pad content-enter"><text class="form-title">{{id ? 'Chapter' : '这一段生活，叫什么？'}}</text><input class="name-input" value="{{title}}" maxlength="80" focus="{{!id}}" bindinput="inputTitle" placeholder="例如：东京交换" placeholder-class="placeholder"/><view class="date-row"><text>开始日期</text><picker mode="date" value="{{startDate}}" bindchange="chooseStart"><view>{{startDate}}</view></picker></view><button class="ui-button optional" bindtap="toggleDetails"><text>封面与说明</text><text>{{details ? '收起' : '可选 ＋'}}</text></button><view wx:if="{{details}}"><button class="ui-button cover-picker" bindtap="chooseCover"><image wx:if="{{cover && cover !== '/assets/images/chapter-summer.webp' && !coverFailed}}" src="{{cover}}" mode="aspectFill" binderror="coverError"/><view wx:else><image src="/assets/icons/image.svg"/><text>添加封面</text></view></button><button wx:if="{{cover}}" class="ui-button remove-cover" bindtap="removeCover">移除封面</button><textarea class="description" value="{{description}}" maxlength="500" auto-height bindinput="inputDescription" placeholder="关于这一段生活（可选）"/></view><text wx:if="{{error}}" class="inline-error">{{error}}</text><button class="ui-button primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving || blocked || adding || !title}}">{{id ? '保存修改' : '创建'}}</button><text wx:if="{{!id}}" class="privacy-note">仅自己可见，之后可以邀请共同记录。</text></view></view>
