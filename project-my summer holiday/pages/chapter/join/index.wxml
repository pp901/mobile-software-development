<view class="page-shell safe-bottom"><navigation-bar title="邀请"/><view class="invitation page-pad"><text class="brand">ongoing_</text><text wx:if="{{loading}}" class="loading-copy">正在读取邀请…</text><block wx:elif="{{invitation}}"><text class="inviter">{{invitation.inviter}} 邀请你</text><text class="invitation-title">{{invitation.title}}</text><text class="invitation-scope">{{invitation.scope === 'moment' ? '接受后，你可以阅读和记录这个 Moment。其他 Chapter 内容仍然是私人的。' : '接受后，你可以阅读这个 Chapter，并一起记录。'}}</text><button class="ui-button primary-button" loading="{{joining}}" disabled="{{joining}}" bindtap="join">{{invitation.scope === 'moment' ? '参与这个 Moment' : '加入 Chapter'}}</button></block><text wx:if="{{error}}" class="inline-error">{{error}}</text><button wx:if="{{error && !invitation}}" class="ui-button secondary-button" bindtap="load">重试</button><button class="ui-button sheet-close" bindtap="goHome">返回首页</button></view></view>