.invite-code-field { border:1rpx solid var(--primary-soft); background:var(--surface); border-radius:20rpx; padding:12rpx 22rpx; }
.invite-code-field>input { width:100%; height:80rpx; font-size:27rpx; }
.paste-invite.paste-invite { width:100%; min-height:96rpx; margin:8rpx 0 16rpx; color:var(--primary-deep); font-size:26rpx; }
.invitation { padding-top:36rpx; }
.invite-logo { display:block; width:104rpx; height:104rpx; margin-bottom:36rpx; border-radius:28rpx; }
.invite-person { display:flex; align-items:center; gap:12rpx; color:var(--text-secondary); font-size:26rpx; }
.invite-person>image { flex:none; width:44rpx; height:44rpx; border-radius:50%; }
.invitation-title { display:block; margin-top:20rpx; font-size:46rpx; line-height:1.4; font-weight:600; overflow-wrap:anywhere; }
.invite-cover { display:block; width:100%; height:260rpx; margin:28rpx 0 20rpx; border-radius:var(--radius-medium); }
.invitation-meta { display:block; margin-top:16rpx; color:var(--primary-deep); font-size:24rpx; }
.invitation-scope { display:block; margin:24rpx 0 32rpx; font-size:28rpx; color:var(--text-secondary); line-height:1.8; }
.join-identity { display:flex; align-items:center; gap:20rpx; padding:20rpx; margin-bottom:32rpx; border-radius:24rpx; background:var(--primary-pale); }
.join-avatar.join-avatar { display:flex; align-items:center; justify-content:center; flex:none; width:96rpx; height:96rpx; min-height:0; border-radius:50%; overflow:hidden; background:var(--surface); }
.join-avatar>image { width:100%; height:100%; }
.join-avatar>.avatar-icon { width:38rpx; height:38rpx; }
.join-identity>view { flex:1; min-width:0; }
.join-identity>view>text { display:block; font-size:22rpx; color:var(--text-secondary); }
.join-identity input { font-size:28rpx; height:68rpx; width:100%; }
.loading-copy { display:block; padding:48rpx 0; color:var(--text-secondary); }

.invitation { padding-top:48rpx; }.invite-logo { width:92rpx; height:92rpx; padding:10rpx; border-radius:24rpx; background:var(--surface); box-shadow:0 8rpx 20rpx rgba(65,78,67,.05); }.invitation-title { font-family:var(--font-display); font-size:52rpx; letter-spacing:-1rpx; }.invite-code-field { border-color:rgba(72,102,83,.16); border-radius:18rpx; background:var(--surface); box-shadow:0 6rpx 18rpx rgba(60,71,64,.035); }.invite-cover { height:290rpx; border-radius:24rpx; }.join-identity { border:1rpx solid rgba(72,102,83,.08); border-radius:22rpx; background:#EEF4EA; }.join-avatar.join-avatar { border-radius:18rpx; }
.invitation { padding:44rpx 28rpx 36rpx; margin-top:28rpx; border:1rpx solid #E2D8C8; border-radius:8rpx; background:#FFFDF8; box-shadow:0 8rpx 18rpx rgba(75,69,58,.06); }.invite-logo { border-radius:7rpx; transform:rotate(-3deg); }.invitation-title { color:#31573E; font-family:var(--font-hand); font-size:54rpx; letter-spacing:1rpx; }.invite-code-field { border:1rpx dashed #AFC4A8; border-radius:7rpx; background:#F1F7EB; }.invite-cover { padding:7rpx 7rpx 26rpx; border:1rpx solid #DED4C4; border-radius:4rpx; background:#fff; box-shadow:0 6rpx 13rpx rgba(70,64,53,.09); transform:rotate(.5deg); }.invitation-scope { font-family:var(--font-hand); font-size:30rpx; }.join-identity { border:1rpx dashed #B7CBAE; border-radius:8rpx; background:#EEF6E8; }.join-avatar.join-avatar { border-radius:6rpx; }
