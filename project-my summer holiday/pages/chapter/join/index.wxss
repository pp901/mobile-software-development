page{background:#f7f3ea}.join-page{min-height:100vh}.join-card{margin:90rpx 30rpx 0;padding:48rpx 32rpx;border-radius:32rpx;background:#ec765f;color:#fff;box-shadow:0 12rpx 0 #bd4b37,0 28rpx 50rpx rgba(112,42,31,.18)}.invite-mark{width:92rpx;height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:28rpx;background:#f2bd42;color:#4c3608;font-size:58rpx;box-shadow:0 8rpx 0 #b9871b}.join-card>.eyebrow{display:block;margin-top:40rpx;color:#ffe6df}.join-title{display:block;margin-top:16rpx;font-size:51rpx;font-weight:700;line-height:1.35}.join-copy{display:block;margin:26rpx 0 40rpx;color:#fff1ed;font-size:23rpx;line-height:1.8}.join-card .primary-button{width:100%;background:#173f2d;box-shadow:0 8rpx 0 #0d2d20}.error{display:block;margin-top:25rpx;padding:18rpx;border-radius:14rpx;background:rgba(255,255,255,.18);font-size:20rpx;line-height:1.6}
