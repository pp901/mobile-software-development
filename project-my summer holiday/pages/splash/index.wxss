page { background: #f1ece3; }
.splash {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: radial-gradient(circle at 80% 14%, rgba(255,254,250,.88) 0, transparent 42%), #f1ece3;
}
.grain {
  position: absolute;
  inset: 0;
  opacity: .14;
  background-image: radial-gradient(rgba(38,49,43,.24) .7rpx, transparent .7rpx);
  background-size: 9rpx 9rpx;
}
.edition { position: absolute; top: calc(34rpx + env(safe-area-inset-top)); right: 34rpx; color: #858a84; font-size: 16rpx; letter-spacing: 3rpx; }
.brand-wrap { position: relative; display: flex; flex-direction: column; align-items: center; animation: reveal 800ms ease both; }
.brand { font-size: 78rpx; font-weight: 600; letter-spacing: -3rpx; }
.cn { margin-top: 16rpx; color: #587362; font-size: 22rpx; font-weight: 600; letter-spacing: 14rpx; text-indent: 14rpx; }
.brand-dot { position: absolute; right: -24rpx; top: -10rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #e7bc72; }
.splash-bottom {
  position: absolute;
  bottom: calc(62rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  color: #747b75;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  animation: reveal 800ms 160ms ease both;
}
.hairline { width: 40rpx; height: 2rpx; background: #587362; }
.loading-copy { color: #a2a59f; font-size: 16rpx; letter-spacing: 2rpx; animation: breathe 1.2s ease-in-out infinite; }
@keyframes reveal { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes breathe { 0%,100% { opacity: .35; } 50% { opacity: .9; } }

