.search-wrap { padding-top: var(--space-4); }
.search-box { height: 92rpx; padding: 0 var(--space-3); display: flex; align-items: center; gap: var(--space-2); border-bottom: 1rpx solid var(--text-primary); background: transparent; }
.search-box image { width: 32rpx; height: 32rpx; opacity: .62; }
.search-box input { min-width: 0; height: 92rpx; flex: 1; font-size: 27rpx; }
.search-box button[class] { min-width: 72rpx; height: 72rpx; color: var(--text-tertiary); font-size: var(--type-metadata); }
.placeholder { color: var(--text-tertiary); }
.suggestions { margin-top: var(--space-12); }
.suggestions>.eyebrow { display: block; color: var(--accent); }
.suggestion-row { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: var(--space-2); }
.count { color: var(--text-tertiary); font-size: var(--type-metadata); }
.place-results { border-top: 1rpx solid var(--border-subtle); }
.place-result { min-height: 96rpx; padding: var(--space-3) 0; display: grid; grid-template-columns: 92rpx 1fr; align-items: center; border-bottom: 1rpx solid var(--border-subtle); }
.place-result text:first-child { color: var(--accent); font-size: var(--type-micro); font-weight: 650; letter-spacing: 1rpx; }
.place-result text:last-child { overflow: hidden; color: var(--text-primary); font-size: var(--type-caption); text-overflow: ellipsis; white-space: nowrap; }
.result-list { border-top: 1rpx solid var(--border-subtle); }
.result-list chapter-card { display: block; margin-bottom: var(--space-4); }
