<view class="page-shell safe-bottom">
  <navigation-bar title="寻找片刻" background="#F6F3ED" color="#26312B" />
  <view class="search-wrap page-pad">
    <view class="search-box"><image src="/assets/icons/search.svg" /><input value="{{keyword}}" bindinput="input" focus placeholder="搜索 Chapter、文字、地点或标签" placeholder-class="placeholder" /><button wx:if="{{keyword}}" bindtap="clear">清除</button></view>
    <view wx:if="{{!searched}}" class="suggestions"><text class="eyebrow">最近想起</text><view class="suggestion-row"><button wx:for="{{suggestions}}" wx:key="*this" class="tag pressable" data-value="{{item}}" bindtap="useSuggestion">{{item}}</button></view></view>
    <block wx:if="{{searched}}">
      <view wx:if="{{chapters.length}}"><view class="section-head"><text class="section-title">Chapter</text><text class="count">{{chapters.length}} 个结果</text></view><view class="result-list"><chapter-card wx:for="{{chapters}}" wx:key="id" chapter="{{item}}" compact bind:open="openChapter" /></view></view>
      <view wx:if="{{moments.length}}"><view class="section-head"><text class="section-title">Moment</text><text class="count">{{moments.length}} 个结果</text></view><view class="result-list"><moment-card wx:for="{{moments}}" wx:key="id" moment="{{item}}" bind:open="openMoment" /></view></view>
      <view wx:if="{{noResults}}" class="empty-state"><text class="empty-mark">_</text><text class="empty-title">没有找到这一页</text><text class="empty-copy">换一个词，或许会遇见别的片刻。</text></view>
    </block>
  </view>
</view>
