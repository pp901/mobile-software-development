<view class="page-shell safe-bottom">
  <navigation-bar title="搜索" />
  <view class="search-wrap page-pad">
    <view class="search-box"><image src="/assets/icons/search.svg" /><input value="{{keyword}}" bindinput="input" focus placeholder="搜索 Chapter、内容或地点" placeholder-class="placeholder" /><button class="ui-button" wx:if="{{keyword}}" bindtap="clear">清除</button></view>
    <block wx:if="{{searched}}">
      <view wx:if="{{places.length}}"><view class="section-head"><text class="section-title">地点</text><text class="count">{{places.length}} 个结果</text></view><view class="place-results"><view wx:for="{{places}}" wx:key="*this" class="place-result"><text>地点</text><text>{{item}}</text></view></view></view>
      <view wx:if="{{chapters.length}}"><view class="section-head"><text class="section-title">Chapter</text><text class="count">{{chapters.length}} 个结果</text></view><view class="result-list"><chapter-card wx:for="{{chapters}}" wx:key="id" chapter="{{item}}" compact bind:open="openChapter" /></view></view>
      <view wx:if="{{moments.length}}"><view class="section-head"><text class="section-title">Moment</text><text class="count">{{moments.length}} 个结果</text></view><view class="result-list"><moment-card wx:for="{{moments}}" wx:key="id" moment="{{item}}" bind:open="openMoment" /></view></view>
      <view wx:if="{{noResults}}" class="empty-state"><text class="empty-mark">_</text><text class="empty-title">没有匹配的记录</text><text class="empty-copy">试试其他关键词。</text></view>
    </block>
  </view>
</view>
