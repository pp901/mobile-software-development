.share-nav { width: 74rpx; height: 74rpx; display: flex; align-items: center; justify-content: center; }
.share-nav image { width: 32rpx; height: 32rpx; opacity: .76; }

.review-hero { padding-top: 54rpx; padding-bottom: 58rpx; }
.review-hero>.eyebrow { color: #587362; }
.review-name { display: block; margin-top: 12rpx; font-size: 48rpx; font-weight: 600; letter-spacing: -2rpx; }
.review-description { display: block; width: 88%; margin-top: 16rpx; color: #777d77; font-size: 23rpx; line-height: 1.68; }
.review-rule { width: 40rpx; height: 2rpx; margin: 44rpx 0 30rpx; background: #587362; }
.duration { font-size: 114rpx; line-height: .9; font-variant-numeric: tabular-nums; }
.duration-copy { margin-left: 18rpx; color: #587362; font-size: 17rpx; letter-spacing: 3rpx; }
.duration-cn { display: block; margin-top: 15rpx; color: #8b908a; font-size: 21rpx; }

.hero-photo-wrap { position: relative; height: 430rpx; }
.hero-photo { width: 100%; height: 100%; }
.photo-note {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 27rpx;
  display: flex;
  gap: 14rpx;
  border-radius: 22rpx;
  background: rgba(255,254,250,.92);
  color: #454e47;
  font-family: Georgia, "Songti SC", serif;
  font-size: 23rpx;
  line-height: 1.65;
}
.photo-note text:first-child { color: #c79e5e; font-size: 46rpx; line-height: .9; }

.review-section { padding-top: 54rpx; padding-bottom: 60rpx; }
.section-number { display: block; color: #b2b6b1; font-size: 21rpx; }
.review-section>.eyebrow, .review-section>view>.eyebrow { display: block; margin-top: 14rpx; color: #587362; }
.story-title { display: block; margin-top: 20rpx; font-size: 36rpx; font-weight: 600; line-height: 1.38; letter-spacing: -1rpx; white-space: pre-line; }
.first-moment { margin-top: 34rpx; overflow: hidden; box-shadow: none; }
.first-moment image { width: 100%; height: 380rpx; }
.first-moment>view { padding: 26rpx; }
.first-moment text { display: block; }
.first-moment text:first-child { color: #8b908a; font-size: 19rpx; }
.first-moment text:nth-child(2) { margin-top: 12rpx; font-family: Georgia, "Songti SC", serif; font-size: 27rpx; line-height: 1.65; }
.first-moment text:last-child { margin-top: 14rpx; color: #587362; font-size: 19rpx; }

.dark-section { overflow: hidden; background: #e9eee2; color: #343d2d; }
.dark-section .section-number { color: #939b89; }
.dark-section .eyebrow { color: #738367; }
.photo-ribbon { margin-top: 50rpx; white-space: nowrap; }
.photo-row { padding: 0 36rpx 30rpx; display: flex; align-items: center; gap: 15rpx; }
.photo-item { width: 314rpx; height: 390rpx; flex: none; border: 9rpx solid #f6f3ed; transform: rotate(-2deg); }
.photo-1 { height: 338rpx; transform: rotate(3deg); }
.photo-2 { transform: rotate(-1deg); }
.review-empty { margin-top: 42rpx; color: rgba(255,255,255,.62); font-size: 22rpx; }

.place-art { position: relative; height: 390rpx; margin-top: 36rpx; overflow: hidden; border-radius: 50%; background: #e4ece6; }
.orbit { position: absolute; border: 1rpx solid rgba(56,83,68,.23); border-radius: 50%; }
.orbit-one { width: 470rpx; height: 240rpx; left: 70rpx; top: 72rpx; transform: rotate(18deg); }
.orbit-two { width: 280rpx; height: 440rpx; right: 40rpx; top: -20rpx; transform: rotate(-31deg); }
.place-pin { position: absolute; width: 16rpx; height: 16rpx; border: 4rpx solid #fff; border-radius: 50%; background: #587362; box-shadow: 0 3rpx 10rpx rgba(56,83,68,.25); }
.pin-one { left: 110rpx; top: 190rpx; }
.pin-two { right: 125rpx; top: 98rpx; }
.pin-three { right: 85rpx; bottom: 95rpx; }
.place-number { position: absolute; left: 50%; top: 50%; font-size: 98rpx; transform: translate(-50%,-60%); }
.place-copy { position: absolute; left: 50%; top: 63%; color: #587362; font-size: 17rpx; letter-spacing: 3rpx; transform: translateX(-50%); }
.place-list { margin-top: 26rpx; display: flex; flex-direction: column; gap: 12rpx; color: #777d77; font-size: 20rpx; }

.oat-section { background: #e9dccb; }
.oat-section>.eyebrow { color: #7f5c4c; }
.tag-cloud { min-height: 310rpx; padding: 44rpx 0 18rpx; display: flex; flex-wrap: wrap; align-content: center; justify-content: center; gap: 18rpx; }
.cloud-tag { padding: 16rpx 23rpx; border-radius: 18rpx; background: rgba(255,254,250,.7); font-family: Georgia, "Songti SC", serif; font-size: 29rpx; transform: rotate(-3deg); }
.tag-count { margin-left: 6rpx; color: #9c6955; font-size: 17rpx; }
.cloud-1 { transform: rotate(2deg) translateY(15rpx); }
.cloud-2 { font-size: 36rpx; transform: rotate(-1deg); }
.cloud-3 { transform: rotate(4deg) translateY(-8rpx); }
.mood-chart { margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(93,72,57,.13); }
.mood-bar { margin-top: 18rpx; display: grid; grid-template-columns: 70rpx 1fr 32rpx; align-items: center; gap: 14rpx; color: #6e5d51; font-size: 20rpx; }
.mood-bar>view { height: 9rpx; overflow: hidden; border-radius: 5rpx; background: rgba(255,255,255,.47); }
.mood-fill { display: block; height: 100%; border-radius: 5rpx; background: #ad705c; }

.goal-score { margin: 40rpx 0; padding: 34rpx; display: flex; align-items: baseline; border-radius: 25rpx; background: #e4ece6; }
.goal-score text:first-child { font-size: 84rpx; }
.goal-score text:nth-child(2) { margin-left: 8rpx; color: #587362; font-size: 29rpx; }
.goal-score text:last-child { margin-left: auto; color: #587362; font-size: 16rpx; letter-spacing: 2rpx; }
.review-goal { min-height: 84rpx; display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid rgba(38,49,43,.08); }
.review-goal>view { width: 34rpx; height: 34rpx; border: 2rpx solid #a8ada8; border-radius: 11rpx; }
.review-goal.done>view { display: flex; align-items: center; justify-content: center; border-color: #587362; background: #587362; }
.review-goal image { width: 23rpx; height: 23rpx; filter: invert(1); }
.review-goal.done>text { color: #858a85; text-decoration: line-through; }
.simple-note { margin-top: 36rpx; padding: 30rpx; box-shadow: none; }
.simple-note text { display: block; }
.simple-note text:first-child { font-size: 26rpx; font-weight: 600; }
.simple-note text:last-child { margin-top: 10rpx; color: #858b85; font-size: 21rpx; line-height: 1.6; }

.closing-section { position: relative; min-height: 940rpx; color: #fff; }
.closing-section>image, .closing-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.closing-shade { background: rgba(27,35,30,.78); }
.closing-content { position: relative; padding-top: 96rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.closing-content>.eyebrow { color: #d7dfd9; }
.closing-title { display: block; margin-top: 18rpx; font-size: 52rpx; }
.ending-copy { display: block; margin-top: 46rpx; color: rgba(255,255,255,.86); font-family: Georgia, "Songti SC", serif; font-size: 30rpx; line-height: 1.9; }
.closing-content textarea { width: 100%; min-height: 270rpx; margin-top: 38rpx; padding: 27rpx; border: 1rpx solid rgba(255,255,255,.3); border-radius: 23rpx; background: rgba(255,255,255,.11); color: #fff; font-family: Georgia, "Songti SC", serif; font-size: 27rpx; line-height: 1.7; }
.ending-placeholder { color: rgba(255,255,255,.52); }
.finish-button { width: 100%; height: 96rpx; margin-top: 42rpx; border-radius: 48rpx; background: #d3ddc5; color: #344138; font-weight: 600; }
.finish-button.ghost { border: 1rpx solid rgba(255,255,255,.45); background: transparent; color: #fff; }
.completed { display: block; margin-top: 92rpx; color: rgba(255,255,255,.62); font-size: 18rpx; letter-spacing: 4rpx; text-align: center; }
.brand-bottom { display: block; margin-top: 18rpx; font-size: 44rpx; text-align: center; }
.finish-button { display:flex; align-items:center; justify-content:center; }
.memory-share { width:calc(100% - 60rpx); }
.memory-stamp .stamp-status { font-size:24rpx; font-family:"Songti SC",serif; letter-spacing:0; margin:0; white-space:nowrap; }
.memory-paper { margin:24rpx 30rpx 0; padding:32rpx; background:#fffdf7; border-radius:28rpx; box-shadow:0 12rpx 42rpx rgba(96,76,47,.08); }
.memory-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:28rpx; }
.memory-brand { display:block; font-size:43rpx; font-weight:600; }.memory-subtitle { display:block; margin-top:10rpx; font-size:18rpx; letter-spacing:2rpx; color:#919080; }
.memory-stamp { width:112rpx; height:112rpx; flex:none; border:3rpx double #bc9885; border-radius:50%; color:#ac816e; display:flex; align-items:center; justify-content:center; flex-direction:column; font-size:28rpx; font-family:"Songti SC",serif; transform:rotate(-14deg); }.memory-stamp text { font:13rpx Georgia,serif; letter-spacing:2rpx; margin-top:8rpx; }
.memory-cover { width:100%; height:328rpx; border-radius:14rpx; display:block; }
.memory-season { display:block; margin-top:26rpx; font-size:19rpx; color:#7d8174; }.memory-name { display:block; margin-top:8rpx; font-size:37rpx; font-weight:600; font-family:"Songti SC","Microsoft YaHei",serif; }.memory-dates { display:block; margin-top:10rpx; color:#939789; font-size:20rpx; }
.memory-stats { display:flex; justify-content:space-between; margin:32rpx 0; }.memory-stats>view { display:flex; flex-direction:column; align-items:center; width:25%; border-right:1rpx solid #e8e6dc; }.memory-stats>view:last-child { border-right:0; }.memory-stats text:first-child { font:30rpx Georgia,serif; }.memory-stats text:last-child { color:#919584; font-size:18rpx; margin-top:7rpx; }
.memory-quote { display:block; font-family:"STKaiti","KaiTi",serif; font-size:26rpx; line-height:1.75; color:#7e8271; }.memory-sign { display:block; text-align:right; font:italic 25rpx Georgia,serif; color:#929781; margin-top:14rpx; }.memory-share { margin:32rpx 30rpx 0; background:#6f8366; box-shadow:none; }.memory-hint { display:block; text-align:center; margin-top:22rpx; color:#9b9d91; font-size:21rpx; }
