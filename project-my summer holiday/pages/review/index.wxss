.review-page { background:linear-gradient(180deg,var(--primary-pale),var(--bg) 1100rpx); }.review-cover { position:relative; min-height:420rpx; overflow:hidden; }.review-art { position:absolute; right:32rpx; top:0; width:58%; height:400rpx; border-radius:180rpx 180rpx 0 0; overflow:hidden; }.review-art>.review-cover-photo { width:100%; height:100%; opacity:.82; }.review-cover-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(237,241,248,0) 20%,rgba(237,241,248,.94)); }.review-cover-copy { position:relative; padding:200rpx 44rpx 64rpx; }.archive-mark { display:block; font-size:22rpx; letter-spacing:2rpx; color:var(--primary); }.review-title { display:block; margin-top:12rpx; font:600 46rpx/1.4 var(--font-display); overflow-wrap:anywhere; }.review-dates { display:block; margin-top:18rpx; color:var(--primary-deep); font-size:24rpx; }.review-content { position:relative; }.review-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:-24rpx; padding:28rpx 8rpx; border-radius:32rpx; background:rgba(255,255,255,.85); }.review-stats>view { display:flex; align-items:center; flex-direction:column; }.review-stats text:first-child { font:500 46rpx/1.25 var(--font-display); color:var(--primary-deep); }.review-stats text+text { font-size:23rpx; color:var(--text-muted); margin-top:6rpx; }.summary-card { margin-top:28rpx; padding:22rpx 30rpx 26rpx; border-radius:32rpx; background:rgba(255,255,255,.78); }.quote-mark { display:block; font:70rpx/.8 var(--font-display); color:var(--primary-soft); }.summary-copy { display:block; margin:10rpx 0 20rpx; font-size:29rpx; line-height:1.8; color:var(--text-secondary); white-space:pre-wrap; overflow-wrap:anywhere; }.summary-sign { display:block; text-align:right; font-size:24rpx; font-family:var(--font-display); color:var(--text-muted); }.section-head { margin:20rpx 0 12rpx; }.featured-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; }.export-actions { margin-top:32rpx; }.export-actions .primary-button.primary-button { background:linear-gradient(100deg,var(--primary-deep),#8390B5); }.export-actions image { width:34rpx; height:34rpx; }.save-poster.save-poster,.ending-link.ending-link { justify-content:center; width:100%; }.review-empty { color:var(--text-muted); font-size:26rpx; padding:24rpx 0; }.month-marker { display:block; margin:36rpx 0 24rpx; font-size:32rpx; font-family:var(--font-display); }.entry-date.entry-date { width:100%; display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:88rpx; text-align:left; color:var(--text-secondary); font-size:24rpx; }.entry-date.entry-date>image { width:28rpx; height:28rpx; flex:none; }.review-entry { padding-bottom:32rpx; }.review-perspective+.review-perspective { margin-top:28rpx; padding-top:24rpx; border-top:1rpx solid var(--line); }.perspective-name { display:flex; gap:14rpx; align-items:center; font-size:24rpx; margin:20rpx 0; }.perspective-name image { width:48rpx; height:48rpx; border-radius:50%; }.reading-more { display:block; font-size:24rpx; color:var(--text-muted); text-align:center; }.ending-input { min-height:280rpx; padding:24rpx; background:var(--surface-soft); border-radius:24rpx; margin:24rpx 0; }.poster-canvas { position:fixed; left:-3000px; top:0; pointer-events:none; }
