<view class="page-shell safe-bottom review-page" wx:if="{{chapter}}">
 <navigation-bar title="回望" background="#EDF1F8"/>
 <view class="review-cover"><view class="review-art media-placeholder"><image wx:if="{{chapter.cover && !coverFailed}}" class="review-cover-photo" src="{{chapter.displayCover || chapter.cover}}" mode="aspectFill" binderror="coverError"/><image wx:else src="/assets/icons/image.svg"/></view><view class="review-cover-shade"></view><view class="review-cover-copy"><text class="archive-mark">CHAPTER · {{chapter.status === 'ONGOING' ? '仍在继续' : '已成章'}}</text><text class="review-title">{{chapter.title}}</text><text class="review-dates">{{chapter.startDate}} — {{chapter.status === 'ONGOING' ? '现在' : chapter.endDate || '已结束'}}</text></view></view>
 <view class="page-pad review-content">
  <view class="review-stats"><view><text>{{chapter.recordedDayCount}}</text><text>记录天数</text></view><view><text>{{total}}</text><text>总 Moment</text></view><view><text>{{chapter.memberCount}}</text><text>同行成员</text></view></view>
  <view class="summary-card"><text class="quote-mark">“</text><text class="summary-copy">{{chapter.ending || chapter.description || '每一个被记录的日常，都是这一章的一部分。'}}</text><text class="summary-sign">— ongoing_</text></view>
  <view class="section-head"><text class="section-title brand-serif">精选瞬间</text><button wx:if="{{total}}" class="ui-button section-link" bindtap="toggleEntries">{{expanded ? '收起记录' : '查看全部 ›'}}</button></view>
  <view wx:if="{{featured.length}}" class="featured-grid"><view wx:for="{{featured}}" wx:key="id"><moment-card moment="{{item}}" layout="compact" bind:open="openCard"/></view></view>
  <view wx:else class="review-empty"><text>这一章，还在等待你的记录。</text><button class="ui-button section-link" bindtap="goBack">返回 Chapter →</button></view>
  <view class="export-actions"><button class="ui-button primary-button" loading="{{generating}}" disabled="{{generating}}" bindtap="generatePoster"><image src="/assets/icons/share-light.svg"/><text>生成分享海报</text></button><button wx:if="{{posterPath}}" class="ui-button section-link save-poster" bindtap="savePoster">保存到相册</button><text wx:if="{{error}}" class="inline-error">{{error}}</text></view>
  <button wx:if="{{chapter.isOwner}}" class="ui-button section-link ending-link" bindtap="startEnding">{{chapter.status === 'ONGOING' ? '为这一章写下结语' : '编辑章节结语'}}</button>
  <view wx:if="{{expanded}}" class="review-timeline"><view wx:for="{{entries}}" wx:for-item="entry" wx:key="id" class="review-entry"><text wx:if="{{entry.startMonth}}" class="month-marker">{{entry.month}}</text><button class="ui-button entry-date" data-id="{{entry.id}}" bindtap="openMoment"><text>{{entry.moment.dateLabel}}{{entry.moment.location ? ' · ' + entry.moment.location : ''}}</text><image src="/assets/icons/arrow-right.svg"/></button><view wx:for="{{entry.perspectives}}" wx:for-item="perspective" wx:key="id" class="review-perspective"><view wx:if="{{entry.perspectives.length > 1}}" class="perspective-name"><image wx:if="{{perspective.creator.avatar}}" src="{{perspective.creator.avatar}}" mode="aspectFill"/><text>{{perspective.creator.nickname}}</text></view><moment-content item="{{perspective}}"/></view></view><text wx:if="{{hasMore}}" class="reading-more">继续向下阅读</text></view>
 </view>
 <canvas canvas-id="reviewPoster" class="poster-canvas" style="width:750px;height:1100px"></canvas>
 <view wx:if="{{composing}}" class="sheet-mask" bindtap="closeEnding"><view class="sheet" catchtap="noop"><text class="sheet-title">{{chapter.status === 'ONGOING' ? '为这一章写下结语' : '编辑结语'}}</text><text class="sheet-copy">{{chapter.status === 'ONGOING' ? '保存结语后，这一章将标记为已结束，仍可阅读、编辑和补记。' : '结束日期保持不变。'}}</text><textarea class="ending-input" value="{{ending}}" maxlength="1000" bindinput="inputEnding" placeholder="回头看看，想对这段日子说什么？"/><text wx:if="{{error}}" class="inline-error">{{error}}</text><button class="ui-button primary-button" bindtap="complete">{{chapter.status === 'ONGOING' ? '保存并结束这一章' : '保存结语'}}</button><button class="ui-button sheet-close" bindtap="closeEnding">取消</button></view></view>
</view><view wx:elif="{{missing}}"><navigation-bar title="回望"/><view class="page-pad empty-state"><text class="empty-title">无法读取这个 Chapter</text><button class="ui-button secondary-button" bindtap="goBack">返回</button></view></view>
