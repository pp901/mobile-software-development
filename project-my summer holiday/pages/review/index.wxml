<view class="page-shell safe-bottom review-page" wx:if="{{chapter}}">
 <navigation-bar title="回望" background="#F7F7F2"/>
 <view class="review-cover"><view class="review-art media-placeholder"><image wx:if="{{chapter.cover && !coverFailed}}" class="review-cover-photo" src="{{chapter.displayCover || chapter.cover}}" mode="aspectFill" binderror="coverError"/><image wx:else src="/assets/icons/image.svg"/></view><view class="review-cover-shade"></view><view class="review-cover-copy"><text class="archive-mark">CHAPTER · {{chapter.status === 'ONGOING' ? '仍在继续' : '已成章'}}</text><text class="review-title">{{chapter.title}}</text><text class="review-dates">{{chapter.startDate}} — {{chapter.status === 'ONGOING' ? '现在' : chapter.endDate || '已结束'}}</text></view></view>
 <view class="page-pad review-content">
  <view class="review-stats"><view><text>{{chapter.recordedDayCount}}</text><text>记录天数</text></view><view><text>{{total}}</text><text>总 Moment</text></view><view><text>{{chapter.memberCount}}</text><text>同行成员</text></view></view>
  <view class="summary-card"><text class="quote-mark">“</text><text class="summary-copy">{{chapter.ending || chapter.description || '每一个被记录的日常，都是这一章的一部分。'}}</text><text class="summary-sign">— ongoing_</text></view>
  <view class="section-head"><text class="section-title brand-serif">精选瞬间</text><button wx:if="{{total}}" class="ui-button section-link" bindtap="toggleEntries">{{expanded ? '收起记录' : '查看全部 ›'}}</button></view>
  <view wx:if="{{featured.length}}" class="featured-grid"><view wx:for="{{featured}}" wx:key="id"><moment-card moment="{{item}}" layout="compact" bind:open="openCard"/></view></view>
  <view wx:else class="review-empty"><text>这一章，还在等待你的记录。</text><button class="ui-button section-link" bindtap="goBack">返回 Chapter →</button></view>
  <view class="export-actions"><button class="ui-button primary-button" loading="{{generating}}" disabled="{{generating}}" bindtap="openPoster"><image src="/assets/icons/share-light.svg"/><text>把这一章，做成海报</text></button><text wx:if="{{error}}" class="inline-error">{{error}}</text></view>
  <button wx:if="{{chapter.isOwner}}" class="ui-button section-link ending-link" bindtap="startEnding">{{chapter.status === 'ONGOING' ? '为这一章写下结语' : '编辑章节结语'}}</button>
  <view wx:if="{{expanded}}" class="review-timeline"><view wx:for="{{entries}}" wx:for-item="entry" wx:key="id" class="review-entry"><text wx:if="{{entry.startMonth}}" class="month-marker">{{entry.month}}</text><button class="ui-button entry-date" data-id="{{entry.id}}" bindtap="openMoment"><text>{{entry.moment.dateLabel}}{{entry.moment.location ? ' · ' + entry.moment.location : ''}}</text><image src="/assets/icons/arrow-right.svg"/></button><view wx:for="{{entry.perspectives}}" wx:for-item="perspective" wx:key="id" class="review-perspective"><view wx:if="{{entry.perspectives.length > 1}}" class="perspective-name"><image wx:if="{{perspective.creator.avatar}}" src="{{perspective.creator.avatar}}" mode="aspectFill"/><text>{{perspective.creator.nickname}}</text></view><moment-content item="{{perspective}}"/></view></view><text wx:if="{{hasMore}}" class="reading-more">继续向下阅读</text></view>
 </view>
 <view wx:if="{{posterOpen}}" class="sheet-mask poster-mask" bindtap="closePoster"><view class="poster-studio" catchtap="noop">
  <view class="studio-head"><view><text class="studio-title">把这一段，留成一张</text><text class="studio-subtitle">{{posterStep === 'result' ? '你的生活，有自己的颜色。' : '选 0—3 张照片，也可以只留下文字。'}}</text></view><button class="ui-button studio-close" bindtap="closePoster" disabled="{{generating || savingPoster}}" aria-label="关闭海报">×</button></view>
  <scroll-view scroll-y class="poster-studio-scroll">
   <view wx:if="{{posterStep === 'select'}}" class="studio-content">
    <view class="poster-section-head"><text>01 / 选照片</text><text>{{selectedCount}} / 3</text></view>
    <scroll-view wx:if="{{photoChoices.length}}" scroll-y class="poster-picker" bindscrolltolower="morePosterPhotos"><view class="poster-photo-grid"><button wx:for="{{photoChoices}}" wx:key="key" class="ui-button poster-photo {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectPhoto" disabled="{{generating}}" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.dateLabel}} 的照片"><image wx:if="{{!item.failed}}" src="{{item.displayPath || item.path}}" mode="aspectFill" data-key="{{item.key}}" binderror="photoError"/><text wx:else class="poster-photo-failed">图片暂不可用</text><view class="photo-select-check">{{item.selected ? item.order : ''}}</view></button></view><text wx:if="{{photoHasMore}}" class="picker-more">向下滑动，选更多照片</text></scroll-view>
    <button class="ui-button text-poster-choice" bindtap="useTextPoster" disabled="{{generating}}">{{selectedCount ? '不放照片，做一张文字海报' : '文字海报，也很好看 ✓'}}</button>
    <view class="poster-section-head"><text>02 / 海报预览</text><text>ongoing_ collection</text></view>
    <view class="live-poster"><view class="live-paper">
     <view class="live-brand"><text>ongoing_</text><view><view></view><view></view><view></view></view></view><text class="live-eyebrow">A CHAPTER OF MY LIFE</text><text class="live-title">{{posterModel.title}}</text><text class="live-date">{{posterModel.dateRange}}</text>
     <view wx:if="{{selectedCount}}" class="live-photos photos-{{selectedCount}}"><image wx:for="{{selectedPhotos}}" wx:key="key" src="{{item.displayPath || item.path}}" mode="aspectFill"/></view>
     <text wx:if="{{selectedCount}}" class="live-excerpt">{{posterModel.excerpt}}</text>
     <view wx:else class="live-word-art"><view class="word-art-circles"><view></view><view></view></view><text class="live-quote">“</text><text class="live-word-excerpt">{{posterModel.excerpt}}</text><text class="live-word-caption">有些日子，文字就能留下颜色。</text></view>
     <view class="live-stats"><view><text>{{posterModel.momentCount}}</text><text>MOMENT</text></view><view><text>{{posterModel.recordedDayCount}}</text><text>个记录日</text></view><view><text>{{posterModel.sharedCount}}</text><text>{{posterModel.sharedCount ? '共同 MOMENT' : '共同视角，待续'}}</text></view></view><view class="live-footer"><text>此刻很轻，时间会记得。</text><text>{{posterModel.ongoing ? 'TO BE CONTINUED →' : 'A CHAPTER TO KEEP'}}</text></view>
    </view></view>
   </view>
   <view wx:else class="studio-content poster-result"><text class="poster-ready">已经做好了，留在相册里吧。</text><image class="poster-result-image" src="{{posterPath}}" mode="widthFix" bindtap="previewPoster"/><button class="ui-button poster-reselect" bindtap="changePosterSelection">重新选照片</button></view>
   <text wx:if="{{posterError}}" class="poster-error">{{posterError}}</text>
  </scroll-view>
  <view class="studio-footer"><button wx:if="{{posterStep === 'select'}}" class="ui-button primary-button" bindtap="generatePoster" loading="{{generating}}" disabled="{{generating}}">{{generating ? '正在排好这一段生活' : '生成分享海报 ↗'}}</button><button wx:elif="{{albumDenied}}" class="ui-button primary-button" bindtap="openAlbumSettings">允许保存到相册</button><button wx:else class="ui-button primary-button" bindtap="savePoster" loading="{{savingPoster}}" disabled="{{savingPoster}}">保存到相册 ↓</button></view>
 </view></view>
 <canvas canvas-id="reviewPoster" class="poster-canvas" style="width:750px;height:1200px"></canvas>
 <view wx:if="{{composing}}" class="sheet-mask" bindtap="closeEnding"><view class="sheet" catchtap="noop"><text class="sheet-title">{{chapter.status === 'ONGOING' ? '为这一章写下结语' : '编辑结语'}}</text><text class="sheet-copy">{{chapter.status === 'ONGOING' ? '保存结语后，这一章将标记为已结束，仍可阅读、编辑和补记。' : '结束日期保持不变。'}}</text><textarea class="ending-input" value="{{ending}}" maxlength="1000" bindinput="inputEnding" placeholder="回头看看，想对这段日子说什么？"/><text wx:if="{{error}}" class="inline-error">{{error}}</text><button class="ui-button primary-button" bindtap="complete">{{chapter.status === 'ONGOING' ? '保存并结束这一章' : '保存结语'}}</button><button class="ui-button sheet-close" bindtap="closeEnding">取消</button></view></view>
</view><view wx:elif="{{missing}}"><navigation-bar title="回望"/><view class="page-pad empty-state"><text class="empty-title">无法读取这个 Chapter</text><button class="ui-button secondary-button" bindtap="goBack">返回</button></view></view>
