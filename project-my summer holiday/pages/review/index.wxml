<view class="review-page" wx:if="{{chapter}}"><navigation-bar title="回望" background="#F7F3EA"><button slot="right" class="share-nav" open-type="share"><image src="/assets/icons/share.svg"/></button></navigation-bar>
  <view class="cover-card"><image src="{{chapter.cover}}" mode="aspectFill"/><view class="cover-shade"></view><view class="cover-copy"><text class="eyebrow">CHAPTER REVIEW</text><text class="cover-title">{{chapter.title}}</text><text>{{chapter.startDate}} — {{chapter.endDate || '仍在继续'}}</text><text class="ending-line">{{chapter.status === 'COMPLETED' ? '这一章，写完了。' : '这一章，仍在发生。'}}</text></view></view>
  <view class="stats-grid page-pad"><view class="sun"><text>{{chapter.dayTotal}}</text><text>持续天数</text></view><view class="coral"><text>{{moments.length}}</text><text>Moment</text></view><view class="blue"><text>{{members.length}}</text><text>参与人数</text></view><view class="green"><text>{{places.length}}</text><text>地点数量</text></view></view>
  <view class="page-pad"><view class="highlight-grid"><view><text class="eyebrow">BUSIEST DAY</text><text>{{busiestDay ? busiestDay.date : '还没有'}}</text><text>{{busiestDay ? busiestDay.count + ' 个记录' : '等待发生'}}</text></view><view><text class="eyebrow">TOGETHER</text><text>{{sharedMoments.length}}</text><text>个共同补完时刻</text></view></view>
    <view class="section-head"><view><text class="eyebrow green-text">THE STORY</text><text class="section-title">从开始，到最后</text></view></view>
    <button wx:if="{{firstMoment}}" class="edge-moment first" data-id="{{firstMoment.id}}" bindtap="openMoment"><text>第一个 Moment</text><text>{{firstMoment.content || '一个画面，故事开始了。'}}</text><text>{{firstMoment.dateLabel}}</text></button>
    <button wx:if="{{lastMoment}}" class="edge-moment last" data-id="{{lastMoment.id}}" bindtap="openMoment"><text>最后一个 Moment</text><text>{{lastMoment.content || '这一刻，成为章节的结尾。'}}</text><text>{{lastMoment.dateLabel}}</text></button>
    <view class="section-head"><view><text class="eyebrow coral-text">FULL TIMELINE</text><text class="section-title">完整时间线</text></view><text>{{moments.length}} 条</text></view>
    <view class="full-timeline"><button wx:for="{{moments}}" wx:key="id" data-id="{{item.id}}" bindtap="openMoment"><view class="line-date"><text>{{item.dateLabel}}</text><text>{{item.time}}</text></view><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><view class="line-copy"><text>{{item.content || '一个没有文字的画面'}}</text><text>{{item.creator.nickname}}{{item.contributionCount ? ' · ' + item.contributionCount + ' 次补完' : ''}}</text></view></button></view>
    <view class="poster-card"><view><text class="eyebrow">SHARE POSTER</text><text>选择照片，生成这一章的海报</text><text>最多 3 张，可随时重新组合。</text></view><view class="poster-preview"><image wx:for="{{photos}}" wx:key="id" src="{{item.image}}" mode="aspectFill"/></view><button class="primary-button" bindtap="openPhotoPanel">选择照片并生成</button><button wx:if="{{posterPath}}" class="save-poster" bindtap="savePoster">保存已有海报到相册</button></view>
  </view>
  <view class="closing"><text class="eyebrow">A NOTE TO THIS CHAPTER</text><text class="closing-title">{{chapter.status === 'COMPLETED' ? '这一章，写完了。' : '准备写下结尾了吗？'}}</text><block wx:if="{{composing}}"><textarea value="{{ending}}" maxlength="300" auto-height bindinput="inputEnding" placeholder="写下最难忘的一句…"/><button class="finish" bindtap="complete">{{chapter.status === 'COMPLETED' ? '保存新的结语' : '确认结束这一章'}}</button><text wx:if="{{chapter.pendingCount && chapter.status === 'ONGOING'}}">仍有 {{chapter.pendingCount}} 个待补完 Moment，确认时会再次提醒。</text></block><block wx:else><text class="ending-copy">{{chapter.ending || chapter.description}}</text><button wx:if="{{chapter.isOwner && chapter.status === 'ONGOING'}}" class="finish" bindtap="startEnding">结束这一章</button><button wx:elif="{{chapter.isOwner}}" class="edit-ending" bindtap="startEnding">更新结语</button></block></view>
  <canvas canvas-id="reviewPoster" class="poster-canvas" style="width:750px;height:1060px"></canvas>
  <view wx:if="{{photoPanel}}" class="photo-mask" bindtap="closePhotoPanel"><view class="photo-sheet" catchtap="noop"><text>选择海报照片</text><text>已选择 {{selectedPhotoIds.length}} / 3</text><scroll-view scroll-y><view class="choose-grid"><button wx:for="{{allPhotos}}" wx:key="id" data-id="{{item.id}}" class="{{item.selected ? 'selected' : ''}}" bindtap="togglePosterPhoto"><image src="{{item.image}}" mode="aspectFill"/><text>✓</text></button></view></scroll-view><button class="primary-button" loading="{{generating}}" bindtap="confirmPhotos">生成回望海报</button></view></view>
</view>
