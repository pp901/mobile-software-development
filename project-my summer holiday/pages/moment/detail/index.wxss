.echo-context { margin:8rpx 32rpx 28rpx; padding:22rpx 0; }.echo-date-line { display:flex; align-items:center; gap:20rpx; color:var(--primary); font:24rpx/1.5 var(--font-display); font-variant-numeric:tabular-nums; }.echo-date-line>view { flex:1; height:1rpx; background:var(--primary-soft); }.echo-context-title { display:block; margin-top:20rpx; font:500 36rpx/1.5 var(--font-display); }.echo-context-copy { display:block; margin-top:10rpx; color:var(--text-secondary); font-size:25rpx; }
.together-banner { display:flex; align-items:center; gap:18rpx; padding:26rpx 32rpx; background:#F0F2F7; }.together-copy { flex:1; min-width:0; }.together-copy>text { display:block; font-size:29rpx; font-weight:500; }.together-copy>text+text { font-size:22rpx; font-weight:400; color:var(--text-secondary); margin-top:6rpx; }.together-symbol { position:relative; width:60rpx; height:56rpx; flex:none; }.together-symbol>view { position:absolute; width:38rpx; height:46rpx; border:2rpx solid #8EA1BC; border-radius:12rpx; top:0; left:0; transform:rotate(-8deg); }.together-symbol>view+view { background:rgba(198,210,230,.55); top:8rpx; left:20rpx; transform:rotate(8deg); }.together-avatars { display:flex; padding-left:12rpx; }.together-avatar { width:44rpx; height:44rpx; margin-left:-12rpx; border:3rpx solid #F0F2F7; border-radius:50%; background:#DCE4EF; overflow:hidden; display:flex; align-items:center; justify-content:center; font-size:19rpx; color:var(--primary-deep); }.together-avatar image { width:100%; height:100%; }
.moment-gallery { border-radius:0; background:#EDF0F5; }.detail-swiper { height:500rpx; }.event-header>view { flex:1; min-width:0; }.moment-kicker { display:block; font-size:21rpx; letter-spacing:1rpx; color:var(--primary); margin-bottom:8rpx; }.event-title { display:block; font-size:34rpx; }.event-meta { flex-direction:row; flex-wrap:wrap; gap:12rpx 24rpx; }.perspectives-section { margin-top:28rpx; border-top:1rpx solid var(--line); padding-top:30rpx; }.perspectives-heading .section-title { font-size:31rpx; }.perspectives-label { font-size:24rpx; line-height:1.7; margin-top:8rpx; }.perspective { margin:24rpx 0; padding:24rpx; border:0; border-radius:24rpx; background:#F4F5F8; }.perspective:nth-child(odd) { background:#EFF2F7; }.perspective-content { margin-left:0; padding-left:16rpx; border-left:2rpx solid #CDD6E5; margin-top:12rpx; }.perspective-controls { display:flex; align-items:center; flex-wrap:wrap; gap:8rpx 28rpx; margin:12rpx 0; }.perspective-mine.perspective-mine,.invite-link.invite-link { min-height:88rpx; color:var(--primary-deep); font-size:25rpx; }.invite-link.invite-link { color:var(--text-secondary); }.organize-link.organize-link { display:flex; align-items:center; gap:20rpx; width:100%; border-top:1rpx solid var(--line); padding:26rpx 0; margin-top:24rpx; text-align:left; }.organize-link>view { flex:1; }.organize-link text { display:block; font-size:27rpx; }.organize-link view>text+text { margin-top:6rpx; font-size:23rpx; color:var(--text-muted); }.organize-link>text { color:var(--primary); font-size:34rpx; }.organize-choices { max-height:45vh; }.organize-choice.organize-choice { display:flex; align-items:center; gap:24rpx; justify-content:space-between; }.organize-choice>text+text { flex:none; color:var(--text-muted); font-size:23rpx; }.return-today.return-today { width:100%; min-height:100rpx; margin-top:24rpx; font-size:25rpx; color:var(--primary-deep); }
@keyframes receipt-arrive { from { opacity:0; transform:translateY(-10rpx); } to { opacity:1; transform:translateY(0); } } @keyframes receipt-check { from { opacity:0; transform:scale(.8); } to { opacity:1; transform:scale(1); } }
@media (prefers-reduced-motion:reduce) { .saved-receipt,.receipt-check { animation:none; } }
.moment-gallery,.detail { animation:content-in var(--motion-content) var(--ease-out); } @media (prefers-reduced-motion:reduce) { .moment-gallery,.detail { animation:none; } }
