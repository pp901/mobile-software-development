page { background:var(--surface); }.moment-gallery { position:relative; background:var(--lavender-soft); border-radius:0 0 40rpx 40rpx; overflow:hidden; }.detail-swiper { height:530rpx; }.detail-photo { width:100%; height:100%; }.failed-photo { width:100%; height:100%; flex-direction:column; gap:16rpx; color:var(--text-muted); font-size:26rpx; }.photo-counter { position:absolute; right:26rpx; bottom:24rpx; padding:6rpx 18rpx; border-radius:999rpx; background:rgba(60,35,56,.55); color:#fff; font-size:23rpx; }.detail { padding-top:26rpx; }.event-header { display:flex; align-items:flex-start; gap:12rpx; }.event-title { flex:1; min-width:0; font:600 38rpx/1.5 var(--font-display); overflow-wrap:anywhere; }.more-button.more-button { width:72rpx; min-height:72rpx; flex:none; display:flex; align-items:center; justify-content:center; }.more-button.more-button image { width:36rpx; height:36rpx; }.event-meta { display:flex; flex-direction:column; gap:8rpx; margin-top:12rpx; font-size:23rpx; color:var(--text-muted); }.event-meta>view { display:flex; align-items:center; gap:10rpx; }.event-meta image { width:26rpx; height:26rpx; flex:none; }.event-meta text { min-width:0; overflow-wrap:anywhere; }.moment-tags { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:16rpx; }.detail-actions { display:flex; align-items:center; justify-content:space-between; gap:24rpx; margin:20rpx 0 10rpx; }.original-author { display:flex; align-items:center; gap:12rpx; min-width:0; font-size:24rpx; color:var(--text-secondary); }.small-avatar { width:56rpx; height:56rpx; flex:none; background:var(--primary-pale); border-radius:50%; overflow:hidden; display:flex; align-items:center; justify-content:center; }.small-avatar image { width:100%; height:100%; }.favorite.favorite { display:flex; align-items:center; gap:10rpx; min-height:88rpx; color:var(--text-muted); font-size:23rpx; flex:none; }.favorite.favorite>text:first-child { font-size:40rpx; }.is-favorite { color:var(--primary-deep); }.sync-note { display:block; margin:0 0 16rpx; color:var(--text-muted); font-size:22rpx; }
.invite-card.invite-card { width:100%; margin-top:24rpx; padding:24rpx; display:flex; align-items:center; gap:20rpx; background:var(--primary-pale); border-radius:32rpx; text-align:left; }.invite-symbol { width:70rpx; height:70rpx; border-radius:50%; background:var(--primary-soft); display:flex; align-items:center; justify-content:center; flex:none; }.invite-symbol image { width:38rpx; height:38rpx; }.invite-copy { flex:1; min-width:0; }.invite-copy>text { display:block; font-size:28rpx; color:var(--primary-deep); font-weight:600; }.invite-copy>text+text { margin-top:6rpx; font-size:23rpx; color:#828CAB; font-weight:400; }.invite-arrow { flex:none; color:var(--primary-deep); font-size:32rpx; }.section-head { margin-top:36rpx; }.perspectives-label { display:block; font-size:22rpx; color:var(--text-muted); margin-top:6rpx; }.perspective { padding:24rpx 0; border-bottom:1rpx solid var(--line); }.author { display:flex; align-items:center; gap:14rpx; }.author-copy { flex:1; min-width:0; font-size:26rpx; }.author-copy>text { display:block; }.author-copy>text+text { font-size:21rpx; color:var(--text-muted); margin-top:4rpx; }.author button[class] { min-height:80rpx; min-width:64rpx; font-size:23rpx; color:var(--text-muted); flex:none; }.perspective-content { margin-left:70rpx; }.perspective-empty { display:block; padding:20rpx 0 40rpx; font-size:26rpx; color:var(--text-muted); }.chapter-link.chapter-link { width:100%; display:flex; align-items:center; justify-content:space-between; gap:24rpx; text-align:left; padding:24rpx; margin-top:28rpx; border-radius:32rpx; background:var(--surface-soft); }.chapter-link.chapter-link>view { min-width:0; }.chapter-link.chapter-link text { display:block; font-size:27rpx; overflow-wrap:anywhere; }.chapter-link.chapter-link text:first-child { font-size:21rpx; color:var(--text-muted); margin-bottom:6rpx; }.chapter-link.chapter-link>image { width:28rpx; height:28rpx; flex:none; }.unfiled { display:block; margin-top:32rpx; color:var(--text-muted); font-size:24rpx; }

.favorite.favorite.is-favorite { color:var(--primary-deep); }
