.nav-more { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; }
.nav-more image { width: 34rpx; height: 34rpx; opacity: .76; }
.date-block { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding-top:26rpx; padding-bottom:12rpx; }
.date-block>.eyebrow { color: #647d6d; }
.date { display: block; margin-top: 10rpx; font-size: 51rpx; font-weight: 600; line-height: 1.2; }
.time { display: block; margin-top: 8rpx; color: #898e88; font-size: 21rpx; font-variant-numeric: tabular-nums; }

.main-photo { position: relative; width: 100%; min-height: 400rpx; overflow: hidden; background: #e4eae5; }
.main-photo image { display:block; width:100%; height:610rpx; object-fit:cover; }
.image-count { position: absolute; right: 22rpx; bottom: 20rpx; padding: 10rpx 16rpx; border-radius: 11rpx; background: rgba(25,30,27,.62); color: #fff; font-size: 18rpx; letter-spacing: 2rpx; }
.text-only-mark { height: 170rpx; display: flex; align-items: flex-end; padding: 0 36rpx; color: #d0aa68; font-size: 170rpx; line-height: .6; }

.story { padding-top:12rpx; }
.story-copy { display:block; font-size:28rpx; line-height:1.85; font-family:-apple-system,"PingFang SC",sans-serif; }
.voice-card { margin-top: 28rpx; padding: 20rpx 22rpx; display: flex; align-items: center; gap: 17rpx; box-shadow: none; }
.play { width: 56rpx; height: 56rpx; flex: none; border-radius: 18rpx; background: #385344; color: #fff; font-size: 18rpx; line-height: 56rpx; text-align: center; }
.wave { height: 42rpx; flex: 1; display: flex; align-items: center; gap: 7rpx; }
.bar { width: 4rpx; height: 16rpx; border-radius: 2rpx; background: #8da091; }
.bar-1 { height: 30rpx; }
.bar-2 { height: 40rpx; }
.bar-3 { height: 24rpx; }
.voice-card>text { color: #8b908a; font-size: 20rpx; }

.detail-meta { margin-top: 38rpx; padding: 5rpx 0; border-top: 1rpx solid rgba(38,49,43,.08); border-bottom: 1rpx solid rgba(38,49,43,.08); }
.meta-row { min-height: 96rpx; display: flex; align-items: center; gap: 17rpx; }
.meta-row+ .meta-row { border-top: 1rpx solid rgba(38,49,43,.06); }
.meta-icon, .mood-dot { width: 52rpx; height: 52rpx; flex: none; border-radius: 17rpx; background: #e4ece6; }
.meta-icon { display: flex; align-items: center; justify-content: center; }
.meta-icon image { width: 27rpx; height: 27rpx; }
.mood-dot { position: relative; background: #f3e2dc; }
.mood-dot::after { position: absolute; content: ""; width: 14rpx; height: 14rpx; left: 19rpx; top: 19rpx; border-radius: 50%; background: #c77c68; }
.meta-label, .meta-value { display: block; }
.meta-label { color: #969a95; font-size: 17rpx; }
.meta-value { margin-top: 5rpx; font-size: 23rpx; }

.tags-row { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 9rpx; }
.chapter-link { width: 100%; margin-top: 38rpx; padding: 15rpx; display: flex; align-items: center; box-shadow: none; text-align: left; }
.chapter-link>image { width: 92rpx; height: 92rpx; border-radius: 18rpx; }
.chapter-link>view { min-width: 0; flex: 1; margin-left: 17rpx; }
.chapter-label, .chapter-title { display: block; }
.chapter-label { color: #949993; font-size: 17rpx; }
.chapter-title { margin-top: 6rpx; font-family: Georgia, "Songti SC", serif; font-size: 26rpx; font-weight: 600; }
.arrow { padding: 0 8rpx; color: #a7aba6; font-size: 38rpx; }

.action-row { display:flex; gap:12rpx; margin-top:28rpx; }.action-row>button { flex:1; }
.round-button { height: 102rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 18rpx; background: #eceee9; color: #747a74; font-size: 19rpx; }
.round-button>view { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.round-button image { width: 31rpx; height: 31rpx; opacity: .66; }
.round-button.active { background: #f3e2dc; color: #a15d4b; font-weight: 600; }
.round-button.active image { opacity: .86; }
.ending { padding: 72rpx 0 20rpx; display: flex; flex-direction: column; align-items: center; gap: 17rpx; color: #a4a8a3; font-family: Georgia, serif; font-size: 18rpx; font-style: italic; }
.ending view { width: 36rpx; height: 1rpx; background: #8ca092; }
.mood-tag { background:#f4e5df; color:#b16d58; border-radius:30rpx; }
.related-section { margin-top:34rpx; padding-top:26rpx; border-top:1rpx solid #eae8df; }
.related-title { display:block; font-size:25rpx; font-weight:600; margin-bottom:18rpx; }
.related-row { display:flex; gap:12rpx; }
.related-photo,.related-add { width:calc((100% - 36rpx)/4); height:126rpx; border-radius:17rpx; overflow:hidden; flex:none; }
.related-photo image { width:100%; height:100%; }
.related-add { display:flex; align-items:center; justify-content:center; color:#9b9b90; background:#eeece4; font-size:44rpx; }
