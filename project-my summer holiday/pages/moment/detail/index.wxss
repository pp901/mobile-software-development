page { background:var(--surface); }
.moment-gallery { position:relative; background:#F0F0E9; overflow:hidden; }
.detail-swiper { height:560rpx; }
.detail-photo { width:100%; height:100%; }
.failed-photo { width:100%; height:100%; flex-direction:column; gap:16rpx; color:var(--text-muted); font-size:26rpx; }
.photo-counter { position:absolute; right:26rpx; bottom:24rpx; padding:6rpx 18rpx; border-radius:var(--radius-full); background:rgba(39,48,39,.55); color:#fff; font-size:23rpx; }
.detail { padding-top:26rpx; }
.event-header { display:flex; align-items:flex-start; gap:12rpx; }
.event-header>view { flex:1; min-width:0; }
.moment-kicker { display:block; font-size:21rpx; letter-spacing:1rpx; color:var(--primary-deep); margin-bottom:8rpx; }
.event-title { display:block; font:600 34rpx/1.5 var(--font-ui); overflow-wrap:anywhere; }
.more-button.more-button { width:44px; height:44px; flex:none; display:flex; align-items:center; justify-content:center; border-radius:50%; }
.more-button>image { width:36rpx; height:36rpx; }
.event-meta { display:flex; flex-wrap:wrap; gap:12rpx 24rpx; margin-top:12rpx; font-size:23rpx; color:var(--text-muted); }
.event-meta>view { display:flex; align-items:center; gap:10rpx; min-width:0; }
.event-meta image { width:26rpx; height:26rpx; flex:none; }
.event-meta text { min-width:0; overflow-wrap:anywhere; }
.moment-tags { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:16rpx; }
.detail-actions { display:flex; align-items:center; justify-content:space-between; gap:24rpx; margin:20rpx 0 10rpx; }
.original-author { display:flex; align-items:center; gap:12rpx; min-width:0; font-size:24rpx; color:var(--text-secondary); }
.original-author>text { min-width:0; overflow-wrap:anywhere; }
.small-avatar { width:56rpx; height:56rpx; flex:none; background:var(--primary-pale); border-radius:50%; overflow:hidden; display:flex; align-items:center; justify-content:center; }
.small-avatar image { width:100%; height:100%; }
.favorite.favorite { display:flex; align-items:center; gap:10rpx; min-height:44px; color:var(--text-muted); font-size:23rpx; flex:none; }
.favorite>text:first-child { font-size:40rpx; }
.favorite.favorite.is-favorite { color:var(--primary-deep); }
.sync-note { display:block; margin:0 0 16rpx; color:var(--text-muted); font-size:22rpx; }
.sync-retry.sync-retry { width:100%; font-size:23rpx; min-height:44px; text-align:left; color:var(--clay); }
.sync-detail { display:block; color:var(--text-secondary); font-size:23rpx; line-height:1.7; }

.saved-receipt { position:relative; display:flex; gap:20rpx; align-items:flex-start; margin:16rpx 28rpx 28rpx; padding:28rpx 64rpx 28rpx 26rpx; background:linear-gradient(120deg,#E4EEDC,#F4F1DF); border-radius:30rpx; animation:receipt-arrive 550ms var(--ease-out) both; }
.receipt-check { flex:none; width:48rpx; height:48rpx; border-radius:50%; background:var(--primary-deep); color:#fff; display:flex; align-items:center; justify-content:center; font-size:27rpx; animation:receipt-check 650ms ease-out both; }
.receipt-copy { min-width:0; }
.receipt-title { display:block; font:500 37rpx/1.4 var(--font-ui); color:var(--primary-deep); }
.receipt-description { display:block; margin-top:12rpx; font-size:25rpx; }
.receipt-description>text { font-size:30rpx; font-weight:600; color:var(--primary-deep); }
.receipt-footnote { display:block; font-size:21rpx; color:var(--text-secondary); margin-top:12rpx; }
.receipt-close.receipt-close { position:absolute; right:0; top:0; width:44px; height:44px; color:var(--text-muted); font-size:28rpx; }
.echo-context { margin:8rpx 32rpx 28rpx; padding:22rpx 0; }
.echo-date-line { display:flex; align-items:center; gap:20rpx; color:var(--primary-deep); font-size:24rpx; font-variant-numeric:tabular-nums; }
.echo-date-line>view { flex:1; height:1rpx; background:var(--primary-soft); }
.echo-context-title { display:block; margin-top:20rpx; font:500 36rpx/1.5 var(--font-ui); }
.echo-context-copy { display:block; margin-top:10rpx; color:var(--text-secondary); font-size:25rpx; }

.together-banner { display:flex; align-items:center; gap:18rpx; padding:26rpx 32rpx; background:var(--lavender-soft); }
.together-copy { flex:1; min-width:0; }
.together-copy>text { display:block; font-size:29rpx; font-weight:500; }
.together-copy>text+text { font-size:22rpx; font-weight:400; color:var(--text-secondary); margin-top:6rpx; }
.together-symbol { position:relative; width:60rpx; height:56rpx; flex:none; }
.together-symbol>view { position:absolute; width:38rpx; height:46rpx; border:2rpx solid #A69DBB; border-radius:12rpx; top:0; left:0; transform:rotate(-8deg); }
.together-symbol>view+view { background:rgba(190,181,207,.55); top:8rpx; left:20rpx; transform:rotate(8deg); }
.together-avatars { display:flex; padding-left:12rpx; }
.together-avatar { width:44rpx; height:44rpx; margin-left:-12rpx; border:3rpx solid var(--lavender-soft); border-radius:50%; background:#D7CCE2; overflow:hidden; display:flex; align-items:center; justify-content:center; font-size:19rpx; color:var(--primary-deep); }
.together-avatar image { width:100%; height:100%; }
.perspectives-section { margin-top:28rpx; border-top:1rpx solid var(--line); padding-top:30rpx; }
.perspectives-heading .section-title { font-size:31rpx; }
.perspectives-label { display:block; font-size:24rpx; color:var(--text-muted); line-height:1.7; margin-top:8rpx; }
.perspective { margin:24rpx 0; padding:24rpx; border-radius:var(--radius-medium); background:var(--primary-pale); }
.perspective:nth-child(odd) { background:var(--blush-soft); }
.author { display:flex; align-items:center; gap:14rpx; }
.author-copy { flex:1; min-width:0; font-size:26rpx; }
.author-copy>text { display:block; overflow-wrap:anywhere; }
.author-copy>text+text { font-size:21rpx; color:var(--text-muted); margin-top:4rpx; }
.perspective-more.perspective-more { flex:none; width:44px; height:44px; display:flex; align-items:center; justify-content:center; border-radius:50%; }
.perspective-more>image { width:32rpx; height:32rpx; }
.perspective-content { padding-left:18rpx; border-left:2rpx solid #D4C6B9; margin-top:12rpx; }
.my-perspective-card { padding:24rpx; margin-top:28rpx; border-radius:var(--radius-medium); background:var(--primary-pale); }
.my-perspective-heading { display:flex; align-items:flex-start; gap:16rpx; margin-bottom:22rpx; }
.my-perspective-heading>view+view { flex:1; min-width:0; }
.my-perspective-heading text { display:block; font-size:28rpx; font-weight:500; }
.my-perspective-heading text+text { margin-top:8rpx; color:var(--text-secondary); font-size:24rpx; line-height:1.7; font-weight:400; }
.perspective-status-mark { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; flex:none; border-radius:50%; background:var(--surface); color:var(--primary-deep); font-size:25rpx; }
.my-perspective-card .secondary-button { background:var(--surface); }
.invite-perspective-row.invite-perspective-row { display:flex; align-items:center; gap:20rpx; width:100%; margin-top:12rpx; padding:24rpx 4rpx; text-align:left; color:var(--primary-deep); }
.invite-perspective-row>view:first-child { flex:1; min-width:0; }
.invite-perspective-row text { display:block; font-size:27rpx; }
.invite-perspective-row text+text { margin-top:6rpx; color:var(--text-secondary); font-size:23rpx; line-height:1.6; }
.moment-invite-code { display:block; margin:20rpx 0; padding:22rpx; text-align:center; background:var(--primary-pale); border-radius:20rpx; color:var(--primary-deep); font-size:32rpx; letter-spacing:4rpx; overflow-wrap:anywhere; }

.chapter-link.chapter-link { width:100%; display:flex; align-items:center; justify-content:space-between; gap:24rpx; text-align:left; padding:24rpx; margin-top:28rpx; border-radius:var(--radius-medium); background:var(--primary-pale); }
.chapter-link>view { min-width:0; }
.chapter-link text { display:block; font-size:27rpx; overflow-wrap:anywhere; }
.chapter-link text:first-child { font-size:21rpx; color:var(--text-muted); margin-bottom:6rpx; }
.chapter-link>image { width:28rpx; height:28rpx; flex:none; }
.unfiled { display:block; margin-top:32rpx; color:var(--text-muted); font-size:24rpx; }
.organize-link.organize-link { display:flex; align-items:center; gap:20rpx; width:100%; border-top:1rpx solid var(--line); padding:26rpx 0; margin-top:24rpx; text-align:left; }
.organize-link>view:first-child { flex:1; min-width:0; }
.organize-link text { display:block; font-size:27rpx; }
.organize-link view>text+text { margin-top:6rpx; font-size:23rpx; color:var(--text-muted); }
.organize-choices { max-height:45vh; }
.organize-choice.organize-choice { display:flex; align-items:center; gap:24rpx; justify-content:space-between; }
.organize-choice>text+text { flex:none; color:var(--text-muted); font-size:23rpx; }
.return-today.return-today { width:100%; min-height:100rpx; margin-top:24rpx; font-size:25rpx; color:var(--primary-deep); }

.moment-gallery,.detail { animation:content-in var(--motion-content) var(--ease-out); }
@keyframes receipt-arrive { from { opacity:0; transform:translateY(-10rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes receipt-check { from { opacity:0; transform:scale(.8); } to { opacity:1; transform:scale(1); } }
@media (prefers-reduced-motion:reduce) { .saved-receipt,.receipt-check,.moment-gallery,.detail { animation:none; } }
