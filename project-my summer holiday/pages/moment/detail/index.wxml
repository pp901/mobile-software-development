<view wx:if="{{moment}}" class="page-shell moment-page safe-bottom">
 <navigation-bar title="Moment"/>
 <view wx:if="{{moment.media.length}}" class="moment-gallery"><swiper class="detail-swiper" current="{{imageIndex}}" bindchange="changeImage" duration="220"><swiper-item wx:for="{{moment.media}}" wx:key="id"><image wx:if="{{!failedImages[index]}}" class="detail-photo" src="{{item.displayPath || item.path}}" mode="aspectFit" bindtap="preview" data-src="{{item.displayPath || item.path}}" binderror="imageError" data-index="{{index}}"/><view wx:else class="failed-photo media-placeholder"><image src="/assets/icons/image.svg"/><text>图片暂时无法显示</text></view></swiper-item></swiper><text class="photo-counter">{{imageIndex + 1}} / {{moment.media.length}}</text></view>
 <view class="detail page-pad">
  <view class="event-header"><text class="event-title">{{headline}}</text><button wx:if="{{moment.canEdit || moment.canDelete}}" class="ui-button more-button" bindtap="more" aria-label="Moment 操作"><image src="/assets/icons/more.svg"/></button></view>
  <view class="event-meta"><view><image src="/assets/icons/calendar.svg"/><text>{{moment.dateLabel}} {{moment.time}}</text></view><view wx:if="{{moment.location}}"><image src="/assets/icons/pin.svg"/><text>{{moment.location}}</text></view></view>
  <moment-content item="{{moment}}" show-photos="{{false}}"/>
  <view wx:if="{{moment.tags.length}}" class="moment-tags"><text wx:for="{{moment.tags}}" wx:key="*this" class="tag"># {{item}}</text></view>
  <view class="detail-actions"><view class="original-author"><view class="small-avatar"><image wx:if="{{moment.creator.avatar}}" src="{{moment.creator.avatar}}" mode="aspectFill"/><image wx:else src="/assets/icons/user.svg"/></view><text>{{moment.creator.nickname}}</text></view><button class="ui-button favorite {{moment.favorite ? 'is-favorite' : ''}}" bindtap="favorite" aria-label="{{moment.favorite ? '取消收藏' : '收藏此刻'}}"><text>{{moment.favorite ? '♥' : '♡'}}</text><text>{{moment.favorite ? '已收藏' : '收藏'}}</text></button></view>
  <text wx:if="{{moment.syncState === 'pending'}}" class="sync-note">已存到本机 · 等待同步</text>
  <button wx:if="{{moment.canEdit && moment.status !== 'DRAFT'}}" class="ui-button invite-card" bindtap="invite"><view class="invite-symbol"><image src="/assets/icons/user-active.svg"/></view><view class="invite-copy"><text>邀请 TA 一起完成</text><text>把同一刻的不同视角，留在一起。</text></view><text class="invite-arrow">→</text></button>
  <view class="section-head"><view><text class="section-title">共同记录</text><text class="perspectives-label">Perspectives · {{moment.participantCount}} 人的视角</text></view><button wx:if="{{moment.canContribute}}" class="ui-button section-link" bindtap="contribute">＋ 我的视角</button></view>
  <view wx:for="{{perspectives}}" wx:key="id" class="perspective"><view class="author"><view class="small-avatar"><image wx:if="{{item.creator.avatar}}" src="{{item.creator.avatar}}" mode="aspectFill"/><image wx:else src="/assets/icons/user.svg"/></view><view class="author-copy"><text>{{item.creator.nickname}}</text><text>{{item.dateLabel}} {{item.time}}</text></view><button class="ui-button" wx:if="{{item.canEdit}}" bindtap="edit" data-id="{{item.id}}" data-original="{{item.isOriginal}}">编辑</button><button class="ui-button" wx:if="{{item.canEdit}}" bindtap="deletePerspective" data-id="{{item.id}}" aria-label="删除自己的视角">删除</button></view><view class="perspective-content"><moment-content item="{{item}}"/></view></view>
  <text wx:if="{{!perspectives.length}}" class="perspective-empty">同一个瞬间，也可以有不一样的记忆。</text>
  <button wx:if="{{chapter}}" class="ui-button chapter-link" bindtap="openChapter"><view><text>收录于 Chapter</text><text>{{chapter.title}}</text></view><image src="/assets/icons/chevron-right.svg"/></button><text wx:elif="{{!moment.chapterId}}" class="unfiled">暂未归入 Chapter</text>
 </view>
 <view wx:if="{{invitePanel}}" class="sheet-mask" bindtap="closeInvite"><view class="sheet" catchtap="noop"><text class="sheet-title">邀请 TA 一起完成</text><text class="sheet-copy">一起记录这个 Moment。对方接受后，可查看并补充这一刻的视角。</text><text wx:if="{{error}}" class="inline-error">{{error}}</text><button wx:if="{{error}}" class="ui-button secondary-button" bindtap="invite">重试</button><button wx:else class="ui-button primary-button" open-type="share" disabled="{{!invite}}">{{invite ? '通过微信邀请' : '准备邀请中'}}</button><button class="ui-button sheet-close" bindtap="closeInvite">取消</button></view></view>
</view>
<view wx:else><navigation-bar title="Moment"/><view class="page-pad empty-state"><text class="empty-title">{{loading ? '正在读取' : '无法打开这个 Moment'}}</text><text wx:if="{{!loading}}" class="empty-copy">记录不存在，或需要邀请后才能查看。</text><button wx:if="{{!loading}}" class="ui-button secondary-button" bindtap="goBack">返回</button></view></view>
