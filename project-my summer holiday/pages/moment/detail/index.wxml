<view wx:if="{{moment}}" class="page-shell moment-page safe-bottom">
 <navigation-bar title="{{echo ? '记忆回响' : 'Moment'}}"/>
 <view wx:if="{{showReceipt}}" class="saved-receipt"><view class="receipt-check">✓</view><view class="receipt-copy"><text class="receipt-title">这一刻留下了。</text><text class="receipt-description">你已经在 <text>{{stats.recordedDayCount}}</text> 个日子里记录生活。</text><text class="receipt-footnote">第 {{stats.momentCount}} 个 Moment · 留给以后的自己</text></view><button class="ui-button receipt-close" bindtap="dismissReceipt" aria-label="收起完成反馈">×</button></view>
 <view wx:if="{{echo}}" class="echo-context"><view class="echo-date-line"><text>{{echo.echoDate}}</text><view></view><text>{{echo.returnDate}}</text></view><text class="echo-context-title">{{echo.label}}</text><text class="echo-context-copy">{{echo.explanation}}</text></view>
 <view wx:if="{{moment.participantCount > 1}}" class="together-banner"><view class="together-symbol"><view></view><view></view></view><view class="together-copy"><text>同一瞬间，不同视角</text><text>{{moment.participantCount}} 人共同记录 · Perspectives</text></view><view class="together-avatars"><view wx:for="{{moment.participantPreview}}" wx:key="id" class="together-avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"/><text wx:else>{{item.nickname[0]}}</text></view></view></view>
 <view wx:if="{{moment.media.length}}" class="moment-gallery"><swiper class="detail-swiper" current="{{imageIndex}}" bindchange="changeImage" duration="220"><swiper-item wx:for="{{moment.media}}" wx:key="id"><image wx:if="{{!failedImages[index]}}" class="detail-photo" src="{{item.displayPath || item.path}}" mode="aspectFit" bindtap="preview" data-src="{{item.displayPath || item.path}}" binderror="imageError" data-index="{{index}}"/><view wx:else class="failed-photo media-placeholder"><image src="/assets/icons/image.svg"/><text>图片暂时无法显示</text></view></swiper-item></swiper><text class="photo-counter">{{imageIndex + 1}} / {{moment.media.length}}</text></view>
 <view class="detail page-pad">
  <view class="event-header"><view><text class="moment-kicker">{{moment.participantCount > 1 ? '视角 01 / ' + (moment.canEdit ? '我' : moment.creator.nickname) : 'MOMENT / 此刻'}}</text><text class="event-title">{{headline}}</text></view><button wx:if="{{moment.canEdit || moment.canDelete}}" class="ui-button more-button" bindtap="more" aria-label="Moment 操作"><image src="/assets/icons/more.svg"/></button></view>
  <view class="event-meta"><view><image src="/assets/icons/calendar.svg"/><text>{{moment.dateLabel}} {{moment.time}}</text></view><view wx:if="{{moment.location}}"><image src="/assets/icons/pin.svg"/><text>{{moment.location}}</text></view></view>
  <moment-content item="{{moment}}" show-photos="{{false}}"/>
  <view wx:if="{{moment.tags.length}}" class="moment-tags"><text wx:for="{{moment.tags}}" wx:key="*this" class="tag"># {{item}}</text></view>
  <view class="detail-actions"><view class="original-author"><view class="small-avatar"><image wx:if="{{moment.creator.avatar}}" src="{{moment.creator.avatar}}" mode="aspectFill"/><image wx:else src="/assets/icons/user.svg"/></view><text>{{moment.canEdit ? '我的视角' : moment.creator.nickname + ' 的视角'}}</text></view><button class="ui-button favorite {{moment.favorite ? 'is-favorite' : ''}}" bindtap="favorite" aria-label="{{moment.favorite ? '取消收藏' : '收藏此刻'}}"><text>{{moment.favorite ? '♥' : '♡'}}</text><text>{{moment.favorite ? '已收藏' : '收藏'}}</text></button></view>
  <text wx:if="{{pendingHere}}" class="sync-note">已存到本机{{syncStatus.error ? ' · 同步未完成' : ' · 正在等待同步'}}</text><block wx:if="{{pendingHere && syncStatus.error}}"><text class="sync-detail">{{syncStatus.error}}</text><button class="ui-button sync-retry" bindtap="retrySync">重试同步 ↗</button></block>
  <button wx:if="{{readError}}" class="ui-button sync-retry" bindtap="retrySync">{{readError}} · 重试</button>
  <view class="perspectives-section"><view class="perspectives-heading"><text class="section-title">{{perspectives.length ? '他们眼中的这一刻' : '同一瞬间，不同视角'}}</text><text class="perspectives-label">{{perspectives.length ? '记忆，在彼此的视角里变得完整。' : '把同一刻的不同记忆，留在一起。'}}</text></view>
   <view wx:for="{{perspectives}}" wx:key="id" class="perspective"><view class="author"><view class="small-avatar"><image wx:if="{{item.creator.avatar}}" src="{{item.creator.avatar}}" mode="aspectFill"/><image wx:else src="/assets/icons/user.svg"/></view><view class="author-copy"><text>{{item.canEdit ? '我的视角' : item.creator.nickname + ' 的视角'}}</text><text>视角 {{index + 2}} · {{item.dateLabel}}</text></view><button class="ui-button" wx:if="{{item.canEdit}}" bindtap="edit" data-id="{{item.id}}" data-original="{{item.isOriginal}}">编辑</button><button class="ui-button" wx:if="{{item.canEdit}}" bindtap="deletePerspective" data-id="{{item.id}}" aria-label="删除自己的视角">删除</button></view><view class="perspective-content"><moment-content item="{{item}}"/></view></view>
   <view class="perspective-controls"><button wx:if="{{moment.canContribute}}" class="ui-button perspective-mine" bindtap="contribute">{{myPerspectiveLabel}} ↗</button><button wx:if="{{moment.canEdit && moment.status !== 'DRAFT'}}" class="ui-button invite-link" bindtap="invite">邀请 TA 一起记录 ＋</button></view>
  </view>
  <button wx:if="{{chapter}}" class="ui-button chapter-link" bindtap="openChapter"><view><text>这一刻，属于这段生活</text><text>{{chapter.title}}</text></view><image src="/assets/icons/chevron-right.svg"/></button>
  <button wx:elif="{{moment.canOrganize}}" class="ui-button organize-link" bindtap="openOrganize"><view><text>整理到 Chapter</text><text>想好归属时，再放进一段生活。</text></view><view class="disclosure-chevron points-right"></view></button>
  <text wx:elif="{{!moment.chapterId}}" class="unfiled">独立的 Moment{{moment.participantCount > 1 ? ' · 共同的记忆' : ''}}</text>
  <button class="ui-button return-today" bindtap="goHome">回到今天 →</button>
 </view>
 <view wx:if="{{organizePanel}}" class="sheet-mask" bindtap="closeOrganize"><view class="sheet" catchtap="noop"><text class="sheet-title">收进一段生活</text><text class="sheet-copy">这一刻已经留下，随时可以慢慢整理。</text><text wx:if="{{organizeError}}" class="inline-error">{{organizeError}}</text><scroll-view scroll-y class="organize-choices"><button wx:for="{{chapters}}" wx:key="id" class="ui-button sheet-row organize-choice" data-id="{{item.id}}" bindtap="organize"><text>{{item.title}}</text><text>{{item.memberCount > 1 ? item.memberCount + ' 人可见' : '仅自己'}}</text></button></scroll-view><button class="ui-button sheet-row" bindtap="createChapter">＋ 新建 Chapter</button><button class="ui-button sheet-close" bindtap="closeOrganize">以后再整理</button></view></view>
 <view wx:if="{{invitePanel}}" class="sheet-mask" bindtap="closeInvite"><view class="sheet" catchtap="noop"><text class="sheet-title">也想看看，你眼中的这一刻</text><text class="sheet-copy">TA 接受邀请后，可以查看这一刻，并留下自己的视角。</text><text wx:if="{{error}}" class="inline-error">{{error}}</text><button wx:if="{{error}}" class="ui-button secondary-button" bindtap="invite">重试</button><button wx:else class="ui-button primary-button" open-type="share" disabled="{{!invite}}">{{invite ? '通过微信邀请' : '准备邀请中'}}</button><button class="ui-button sheet-close" bindtap="closeInvite">取消</button></view></view>
</view>
<view wx:else><navigation-bar title="Moment"/><view class="page-pad empty-state"><text class="empty-title">{{loading ? '正在读取' : '无法打开这个 Moment'}}</text><text wx:if="{{!loading}}" class="empty-copy">{{readError || '记录不存在，或需要邀请后才能查看。'}}</text><button wx:if="{{!loading}}" class="ui-button secondary-button" bindtap="goBack">返回</button></view></view>
