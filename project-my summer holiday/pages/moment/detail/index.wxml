<view class="detail-page" wx:if="{{moment}}"><navigation-bar title="Moment" background="#F7F3EA"><button slot="right" class="nav-more" bindtap="more"><image src="/assets/icons/more.svg"/></button></navigation-bar>
  <swiper wx:if="{{moment.image}}" class="photo-swiper" indicator-dots="{{moment.imageCount > 1}}"><swiper-item wx:for="{{moment.media}}" wx:key="id"><image src="{{item.path}}" mode="aspectFill" data-src="{{item.path}}" bindtap="preview"/></swiper-item></swiper><view wx:else class="text-mark">“</view>
  <view class="page-pad detail-body"><view class="moment-top"><view class="creator"><image src="{{moment.creator.avatar}}"/><view><text>{{moment.creator.nickname}} 记录</text><text>{{moment.dateLabel}} · {{moment.time}}</text></view></view><text wx:if="{{moment.status === 'DRAFT'}}" class="draft">待补完</text></view>
  <text class="story-copy">{{moment.content || '画面和声音，已经替这一刻说完。'}}</text>
  <button wx:if="{{moment.voicePath}}" class="voice-card" data-path="{{moment.voicePath}}" bindtap="play"><text>{{playingPath === moment.voicePath ? 'Ⅱ' : '▶'}}</text><view></view><text>{{moment.voiceDuration}}″</text></button>
  <view class="meta-row"><text wx:if="{{moment.location}}">⌖ {{moment.location}}</text><text wx:if="{{moment.mood}}">● {{moment.mood}}</text><text wx:for="{{moment.tags}}" wx:key="*this">#{{item}}</text></view>
  <view class="contribution-head"><view><text class="eyebrow">TOGETHER</text><text class="section-title">{{contributorCount}} 人共同补完</text></view><button bindtap="prepareInvite">邀请补完</button></view>
  <view wx:if="{{moment.contributions.length}}" class="contribution-list"><view class="contribution" wx:for="{{moment.contributions}}" wx:key="id"><view class="contributor"><image src="{{item.creator.avatar}}"/><view><text>{{item.creator.nickname}} 补充</text><text>{{item.dateLabel}}</text></view></view><text wx:if="{{item.content}}" class="contribution-copy">{{item.content}}</text><image wx:if="{{item.image}}" class="contribution-photo" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="previewContribution"/><button wx:if="{{item.voicePath}}" class="mini-voice" data-path="{{item.voicePath}}" bindtap="play">{{playingPath === item.voicePath ? '暂停' : '播放'}} · {{item.voiceDuration}} 秒</button></view></view>
  <view wx:else class="contribution-empty"><text>同一时刻，可以有不同人的记忆。</text><button wx:if="{{moment.creatorId !== current.id}}" bindtap="contribute">补充我记得的</button></view>
  <button class="chapter-link" bindtap="openChapter"><image src="{{chapter.cover}}"/><view><text>收录于 Chapter</text><text>{{chapter.title}}</text></view><text>›</text></button>
  <view class="related"><text>同一章里的片刻</text><view><button wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="openRelated"><image src="{{item.image}}" mode="aspectFill"/></button></view></view>
  <view class="actions"><button class="{{moment.favorite ? 'active' : ''}}" bindtap="toggleFavorite">{{moment.favorite ? '♥ 已收藏' : '♡ 收藏'}}</button><button open-type="share">分享</button><button wx:if="{{moment.creatorId !== current.id && chapter.status === 'ONGOING'}}" bindtap="contribute">我来补完</button></view></view>
  <view wx:if="{{sharePanel}}" class="share-mask" bindtap="closeSharePanel"><view class="share-sheet" catchtap="noop"><image src="{{inviteTarget.avatar}}"/><text>邀请 {{inviteTarget.nickname}} 补完</text><text>微信分享时选择对方，打开后会直接进入补充页面。</text><button class="primary-button" open-type="share">发送补完卡片</button><button bindtap="closeSharePanel">取消</button></view></view>
</view>
