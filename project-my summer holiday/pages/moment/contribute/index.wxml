<view class="contribute-page" wx:if="{{moment}}"><navigation-bar title="补完 Moment" background="#F7F3EA"/><view class="page-pad safe-bottom"><view class="origin-card"><image src="{{moment.creator.avatar}}"/><view><text>{{moment.creator.nickname}} 的原始记录</text><text>{{moment.content || '留下了一张照片或一段声音'}}</text></view></view><view class="invite-copy"><text class="eyebrow">ADD YOUR SIDE</text><text class="big-title">你记得的，<br/>或许是另一种样子。</text><text>补充内容会单独署名，原始记录不会被改动。</text></view>
  <view wx:if="{{canContribute}}"><view class="type-grid"><button class="type photo {{type === 'photo' ? 'active' : ''}}" data-type="photo" bindtap="selectType">照片</button><button class="type text {{type === 'text' ? 'active' : ''}}" data-type="text" bindtap="selectType">一句话</button><button class="type voice {{type === 'voice' ? 'active' : ''}}" data-type="voice" bindtap="selectType">语音</button></view>
  <view class="capture-box"><block wx:if="{{type === 'photo'}}"><view class="photo-grid"><image wx:for="{{media}}" wx:key="id" src="{{item.path}}" mode="aspectFill"/><button bindtap="choosePhoto">＋ 选择照片</button></view></block><textarea wx:elif="{{type === 'text'}}" value="{{content}}" maxlength="180" auto-height focus bindinput="inputContent" placeholder="写下你记得的这一刻…"/><block wx:else><button wx:if="{{!voicePath}}" class="record-button {{recording ? 'recording' : ''}}" bindtouchstart="startRecord" bindtouchend="stopRecord">{{recording ? '松开发送' : '按住说话'}}</button><view wx:else class="voice-ready">已录下 {{voiceDuration}} 秒 <button bindtap="startRecord">重录</button></view></block></view>
  <button class="primary-button save" loading="{{saving}}" bindtap="save">以 {{current.nickname}} 的名字补完</button></view>
  <view wx:else class="blocked">只有这一章的其他成员，才能补充这条 Moment。</view></view></view>
