page{background:#f7f3ea}.origin-card{margin-top:20rpx;padding:18rpx;display:flex;align-items:center;gap:15rpx;border-radius:20rpx;background:#fffdf8;box-shadow:0 6rpx 0 rgba(43,72,54,.07)}.origin-card>image{width:60rpx;height:60rpx;border-radius:50%}.origin-card>view{min-width:0}.origin-card text{display:block;font-size:21rpx;font-weight:600}.origin-card text+text{margin-top:5rpx;overflow:hidden;color:#8a8f89;font-size:19rpx;font-weight:400;text-overflow:ellipsis;white-space:nowrap}.invite-copy{padding:55rpx 4rpx 34rpx}.invite-copy>.eyebrow{color:#3f7055}.big-title{display:block;margin:12rpx 0 15rpx;font-size:49rpx;font-weight:700;line-height:1.35}.invite-copy>text:last-child{color:#7d847e;font-size:21rpx;line-height:1.7}.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.type{height:94rpx;border-radius:19rpx;font-weight:700;box-shadow:0 6rpx 0 rgba(50,50,40,.12)}.type.photo{background:#dcebf6;color:#315873}.type.text{background:#fff0b8;color:#664b10}.type.voice{background:#ffe0d7;color:#963f30}.type.active{border:5rpx solid #173f2d;transform:translateY(-3rpx)}.capture-box{min-height:270rpx;margin-top:22rpx;padding:25rpx;border-radius:25rpx;background:#fffdf8;box-shadow:0 7rpx 0 rgba(43,72,54,.07)}.capture-box textarea{width:100%;min-height:220rpx;font-size:28rpx;line-height:1.7}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.photo-grid image,.photo-grid button{width:100%;height:180rpx;border-radius:17rpx;background:#dcebf6}.photo-grid button{font-size:20rpx;color:#315873}.record-button{width:100%;height:220rpx;border-radius:22rpx;background:#ec765f;color:#fff;font-size:27rpx;font-weight:700;box-shadow:0 9rpx 0 #bd4b37}.record-button.recording{background:#173f2d;box-shadow:0 9rpx 0 #0d2d20}.voice-ready{height:220rpx;display:flex;align-items:center;justify-content:center;gap:16rpx;color:#3f7055;font-size:27rpx}.voice-ready button{padding:12rpx;background:#dcecdf;border-radius:10rpx}.save{width:100%;margin-top:28rpx}.blocked{margin-top:20rpx;padding:28rpx;border-radius:22rpx;background:#ffe0d7;color:#8b3c2e;line-height:1.7}
