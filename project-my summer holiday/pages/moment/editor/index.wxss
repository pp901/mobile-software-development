page { background:var(--surface); }.composer { min-height:100vh; }.nav-draft { font-size:23rpx; color:var(--primary); }.composer-body { padding:22rpx 32rpx calc(300rpx + env(safe-area-inset-bottom)); }.chapter-context.chapter-context { width:100%; padding:20rpx; display:flex; align-items:center; gap:20rpx; border-radius:32rpx; background:var(--surface-soft); text-align:left; }.chapter-context.chapter-context[disabled] { opacity:1; }.context-thumb { width:92rpx; height:92rpx; border-radius:26rpx; flex:none; }.context-thumb>image { width:38rpx; height:38rpx; }.context-copy { flex:1; min-width:0; }.context-label { display:block; color:var(--text-muted); font-size:23rpx; }.context-name { display:block; margin-top:4rpx; color:#3D537D; font-size:29rpx; font-weight:500; overflow-wrap:anywhere; }.context-chevron { width:28rpx; height:28rpx; flex:none; }.draft-line { display:flex; flex-wrap:wrap; justify-content:space-between; gap:6rpx 20rpx; color:var(--text-muted); font-size:21rpx; margin:16rpx 0 22rpx; }.parent-context { display:block; margin:24rpx 0; padding-left:20rpx; border-left:3rpx solid var(--primary-soft); color:var(--text-secondary); font-size:26rpx; max-height:180rpx; overflow-y:auto; }
.writing-area { padding:24rpx; border-radius:32rpx; background:linear-gradient(180deg,#FBFCFE,#F5F7FC); }.composer-input { width:100%; min-height:348rpx; font-size:31rpx; line-height:1.9; }.placeholder { color:#969FB0; }.word-count { display:block; text-align:right; margin-top:24rpx; color:var(--text-muted); font-size:21rpx; }.media-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14rpx; margin-top:24rpx; }.media-item,.add-photo.add-photo { position:relative; height:180rpx; border-radius:26rpx; overflow:hidden; background:var(--surface-soft); }.media-item>image { width:100%; height:100%; }.remove-photo.remove-photo { position:absolute; top:0; right:0; width:72rpx; height:72rpx; color:white; background:rgba(72,34,55,.48); border-radius:0 26rpx 0 26rpx; font-size:38rpx; }.add-photo.add-photo { width:100%; display:flex; align-items:center; justify-content:center; color:var(--text-muted); font-size:48rpx; }.media-count { display:block; text-align:right; font-size:21rpx; margin-top:10rpx; color:var(--text-muted); }.voice-ready,.record-status { display:flex; align-items:center; gap:18rpx; justify-content:space-between; padding:8rpx 20rpx; margin-top:24rpx; border-radius:26rpx; background:var(--lavender-soft); font-size:26rpx; }.voice-ready button[class],.record-status button[class] { min-width:72rpx; min-height:88rpx; display:flex; align-items:center; gap:16rpx; }.voice-ready image { width:32rpx; height:32rpx; }.record-dot { width:12rpx; height:12rpx; background:var(--primary); border-radius:50%; }.metadata { display:flex; flex-direction:column; margin-top:24rpx; gap:8rpx; color:var(--text-secondary); font-size:24rpx; }.date-control,.place { min-height:68rpx; display:flex; align-items:center; gap:14rpx; }.metadata image { width:28rpx; height:28rpx; flex:none; }.place>text { flex:1; min-width:0; overflow-wrap:anywhere; }.place button[class] { width:72rpx; min-height:72rpx; }.composer-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:12rpx; }.composer-tags button[class] { min-height:64rpx; }
.composer-toolbar { position:fixed; z-index:30; left:0; right:0; padding:12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background:var(--surface); border-top:1rpx solid var(--line); }.composer-toolbar.keyboard-open { padding-bottom:12rpx; }.capture-tools { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10rpx; margin-bottom:22rpx; }.capture-tools button[class],.dock-tool { min-height:96rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10rpx; border-radius:26rpx; color:var(--text-secondary); font-size:22rpx; background:var(--surface-soft); }.capture-tools image { width:36rpx; height:36rpx; }.stop-recording { width:28rpx; height:28rpx; background:var(--primary-deep); border-radius:6rpx; }.publish-button.publish-button { min-height:96rpx; }.publish-button.publish-button text:first-child { font-size:36rpx; }.publish-button.publish-button text:last-child { margin-left:8rpx; }.chapter-choices { max-height:44vh; margin-top:20rpx; }.sheet-row.sheet-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; font-size:28rpx; }.sheet-row.sheet-row>text { color:var(--text-muted); font-size:23rpx; flex:none; }.sheet-row.sheet-row>.choice-name { color:var(--text); font-size:28rpx; flex:1; min-width:0; overflow-wrap:anywhere; }.sheet-row.sheet-row.chosen>.choice-name,.new-chapter.new-chapter { color:var(--primary-deep); }.tag-input { height:100rpx; padding:20rpx; border-radius:26rpx; background:var(--surface-soft); margin:24rpx 0 32rpx; }

.capture-tools button[class],.dock-tool { min-height:max(96rpx,44px); }
