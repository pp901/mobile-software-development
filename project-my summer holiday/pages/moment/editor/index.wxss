page { background: #f4f1e9; }
.quick-page { min-height: 100vh; background: #f4f1e9; }
.quick-editor { padding-top: 12rpx; padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.context-line { height: 92rpx; padding: 12rpx 16rpx; display: flex; align-items: center; gap: 14rpx; border-radius: 22rpx; background: #253b30; color: #fff; box-shadow: 0 14rpx 30rpx rgba(37, 59, 48, .18); }
.context-line>image { width: 66rpx; height: 66rpx; flex: none; border-radius: 16rpx; }
.context-line>view { min-width: 0; flex: 1; }
.context-line>view text { display: block; }
.context-line>view text:first-child { color: rgba(255,255,255,.66); font-size: 20rpx; }
.context-line>view text:last-child { margin-top: 4rpx; overflow: hidden; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.creator-name { color: rgba(255,255,255,.72); font-size: 21rpx; }
.quick-heading { padding: 38rpx 2rpx 24rpx; }
.quick-title { display: block; color: #253029; font-size: 43rpx; font-weight: 750; letter-spacing: -1rpx; }
.quick-copy { display: block; margin-top: 10rpx; color: #626c65; font-size: 24rpx; }
.type-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.type-card { height: 154rpx; padding: 18rpx 10rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; border: 3rpx solid transparent; border-radius: 22rpx; text-align: left; }
.type-card>view { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: rgba(255,255,255,.55); }
.type-card image { width: 29rpx; height: 29rpx; }
.type-card>text:nth-child(2) { margin-top: 10rpx; font-size: 25rpx; font-weight: 750; }
.type-card>text:last-child { margin-top: 3rpx; font-size: 19rpx; opacity: .72; }
.type-photo { background: #d8e6dc; color: #294737; }
.type-text { background: #f2d7ce; color: #743d31; }
.type-voice { background: #f1d99c; color: #5b4315; }
.type-card.active { border-color: currentColor; box-shadow: 0 12rpx 24rpx rgba(43,50,44,.12); transform: translateY(-3rpx); }
.capture-surface { min-height: 330rpx; margin-top: 16rpx; overflow: hidden; border-radius: 26rpx; background: #fffdf8; box-shadow: 0 16rpx 36rpx rgba(38,48,41,.1); }
.type-surface-photo { border-top: 10rpx solid #476354; }
.type-surface-text { border-top: 10rpx solid #c96049; }
.type-surface-voice { border-top: 10rpx solid #d6a43e; }
.capture-empty { width: 100%; height: 270rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #355442; background: #e3eee6; }
.capture-empty image { width: 58rpx; height: 58rpx; }
.capture-empty text:nth-child(2) { margin-top: 15rpx; font-size: 29rpx; font-weight: 700; }
.capture-empty text:last-child { margin-top: 6rpx; color: #65776c; font-size: 22rpx; }
.media-grid { padding: 14rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.media-item, .media-add { position: relative; height: 188rpx; overflow: hidden; border-radius: 16rpx; }
.media-item>image { width: 100%; height: 100%; }
.media-item>button { position: absolute; top: 8rpx; right: 8rpx; width: 48rpx; height: 48rpx; border-radius: 50%; background: rgba(24,30,26,.72); color: #fff; font-size: 34rpx; }
.media-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; background: #e3eee6; color: #476354; font-size: 20rpx; }
.media-add image { width: 34rpx; height: 34rpx; }
.quick-textarea { display: block; width: 100%; padding: 28rpx; color: #253029; font-size: 29rpx; line-height: 1.7; }
.main-copy { min-height: 330rpx; }
.photo-caption, .voice-caption { min-height: 126rpx; border-top: 1rpx solid rgba(37,48,41,.1); }
.placeholder { color: #788179; }
.voice-capture { width: 100%; height: 270rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #614915; background: #f8e8bd; }
.voice-orbit { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #d6a43e; box-shadow: 0 0 0 18rpx rgba(214,164,62,.17); }
.voice-orbit image { width: 48rpx; height: 48rpx; }
.voice-capture>text:nth-child(2) { margin-top: 28rpx; font-size: 28rpx; font-weight: 750; }
.voice-capture>text:last-child { margin-top: 7rpx; font-size: 21rpx; opacity: .7; }
.voice-capture.recording .voice-orbit { background: #c96049; animation: record-pulse 1s ease-in-out infinite; }
.remove-voice { width: 100%; min-height: 72rpx; color: #8f4538; font-size: 22rpx; }
.details-toggle { width: 100%; min-height: 94rpx; margin-top: 22rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 22rpx; background: #e4e8e1; color: #34463a; font-size: 25rpx; font-weight: 650; }
.details-toggle text:last-child { color: #647069; font-size: 21rpx; font-weight: 500; }
.details-panel { margin-top: 12rpx; padding: 8rpx 24rpx 26rpx; border-radius: 24rpx; background: #fffdf8; box-shadow: 0 12rpx 30rpx rgba(38,48,41,.07); }
.detail-block { padding-top: 26rpx; }
.detail-head { margin-bottom: 15rpx; display: flex; justify-content: space-between; align-items: center; }
.detail-head text:first-child { font-size: 27rpx; font-weight: 700; }
.detail-head text:last-child { color: #747c76; font-size: 20rpx; }
.detail-action, .selected-place { width: 100%; min-height: 82rpx; padding: 0 18rpx; display: flex; align-items: center; gap: 12rpx; border-radius: 18rpx; background: #e3eee6; color: #355442; font-size: 24rpx; }
.detail-action image, .selected-place image { width: 32rpx; height: 32rpx; }
.selected-place>text { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.selected-place>button { width: 72rpx; height: 72rpx; color: #6c766f; font-size: 21rpx; }
.mood-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.mood-chip, .tag-chip { min-height: 66rpx; border: 1rpx solid rgba(37,48,41,.1); border-radius: 16rpx; background: #f1f0ea; color: #5f6962; font-size: 22rpx; }
.mood-chip.active { border-color: #c96049; background: #f2d7ce; color: #743d31; font-weight: 700; }
.tag-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag-chip { min-height: 60rpx; padding: 0 18rpx; }
.tag-chip.active { border-color: #476354; background: #d8e6dc; color: #294737; font-weight: 700; }
.quick-save-bar { position: fixed; z-index: 50; right: 0; bottom: 0; left: 0; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 210rpx 1fr; gap: 12rpx; border-top: 1rpx solid rgba(37,48,41,.1); background: rgba(255,253,248,.97); box-shadow: 0 -16rpx 34rpx rgba(37,48,41,.1); }
.draft-button, .publish-button { height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 46rpx; font-size: 25rpx; font-weight: 700; }
.draft-button { background: #e5e9e4; color: #445249; }
.publish-button { background: #476354; color: #fff; box-shadow: 0 10rpx 24rpx rgba(45,80,59,.22); }
.publish-button[disabled] { background: #aeb7b0; box-shadow: none; }
@keyframes record-pulse { 0%,100% { box-shadow: 0 0 0 14rpx rgba(201,96,73,.12); } 50% { box-shadow: 0 0 0 28rpx rgba(201,96,73,.22); } }
@media (prefers-reduced-motion: reduce) { .voice-capture.recording .voice-orbit { animation: none; } }
