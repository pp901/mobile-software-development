page { background:var(--surface); }.composer { min-height:100vh; }.nav-draft { font-size:21rpx; color:var(--text-muted); }.composer-body { padding:28rpx 36rpx calc(220rpx + env(safe-area-inset-bottom)); }.composer-kicker { display:block; margin-bottom:28rpx; color:var(--text-secondary); font-size:25rpx; }.recovered-note { display:block; font-size:23rpx; color:var(--primary-deep); margin-bottom:20rpx; }.parent-context { display:block; margin:0 0 24rpx; padding:16rpx 22rpx; border-left:3rpx solid var(--primary-soft); background:var(--primary-pale); color:var(--text-secondary); font-size:26rpx; max-height:180rpx; overflow-y:auto; }
.writing-area { padding:8rpx 0; }.composer-input { width:100%; min-height:260rpx; font-size:34rpx; line-height:1.9; }.placeholder { color:#959EAE; }.word-count { display:block; text-align:right; color:var(--text-muted); font-size:21rpx; }.media-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; margin-top:20rpx; }.media-item,.add-photo.add-photo { position:relative; height:184rpx; border-radius:20rpx; overflow:hidden; background:var(--surface-soft); }.media-item>image { width:100%; height:100%; }.remove-photo.remove-photo { position:absolute; top:0; right:0; width:72rpx; height:72rpx; color:white; background:rgba(45,59,80,.5); border-radius:0 20rpx 0 20rpx; font-size:36rpx; }.add-photo.add-photo { width:100%; display:flex; align-items:center; justify-content:center; color:var(--primary); font-size:42rpx; }.media-count { display:block; text-align:right; font-size:21rpx; margin-top:10rpx; color:var(--text-muted); }.voice-ready,.record-status { display:flex; align-items:center; gap:16rpx; justify-content:space-between; padding:6rpx 20rpx; margin-top:24rpx; border-radius:22rpx; background:var(--primary-pale); font-size:26rpx; }.voice-ready button[class],.record-status button[class] { min-width:72rpx; min-height:88rpx; display:flex; align-items:center; gap:16rpx; }.voice-ready image { width:32rpx; height:32rpx; }.record-dot { width:12rpx; height:12rpx; background:var(--primary-deep); border-radius:50%; animation:record-breathe 1.4s ease-in-out infinite; }
.capture-tools { display:flex; gap:16rpx; margin:24rpx 0 32rpx; }.capture-tools button[class] { flex:1; min-height:88rpx; display:flex; align-items:center; justify-content:center; gap:14rpx; border-radius:22rpx; color:var(--primary-deep); font-size:26rpx; background:var(--primary-pale); }.capture-tools image { width:34rpx; height:34rpx; }
.metadata { display:flex; flex-wrap:wrap; align-items:center; gap:0 24rpx; padding:12rpx 0; color:var(--text-secondary); font-size:24rpx; border-top:1rpx solid var(--line); }.date-control,.place-button.place-button { min-height:80rpx; display:flex; align-items:center; gap:12rpx; text-align:left; }.place-button.place-button { min-width:0; max-width:100%; }.place-button text { overflow-wrap:anywhere; }.metadata image { width:28rpx; height:28rpx; flex:none; }.clear-place.clear-place { width:64rpx; min-height:80rpx; color:var(--text-muted); }
.chapter-context.chapter-context { width:100%; padding:20rpx 0; min-height:100rpx; display:flex; align-items:center; gap:16rpx; border-top:1rpx solid var(--line); border-bottom:1rpx solid var(--line); text-align:left; }.context-icon { width:30rpx; height:30rpx; flex:none; }.context-copy { flex:1; min-width:0; }.context-label { display:block; color:var(--text-muted); font-size:22rpx; margin-top:4rpx; }.context-name { display:block; font-size:27rpx; overflow-wrap:anywhere; }.context-optional { font-size:23rpx; color:var(--text-muted); }.context-chevron { width:24rpx; height:24rpx; flex:none; opacity:.5; }.composer-tags { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin-top:12rpx; }.composer-tags button[class] { min-height:76rpx; }.tag-entry.tag-entry { color:var(--text-muted); font-size:23rpx; }
.composer-toolbar { position:fixed; z-index:30; left:0; right:0; padding:18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.97); border-top:1rpx solid var(--line); }.composer-toolbar.keyboard-open { padding:12rpx 24rpx; }.audience-note { display:block; text-align:center; margin-bottom:16rpx; font-size:22rpx; color:var(--text-secondary); }.publish-button.publish-button { min-height:100rpx; border-radius:28rpx; }.publish-button.publish-button text+text { margin-left:12rpx; font-size:32rpx; }.chapter-choices { max-height:44vh; margin-top:20rpx; }.sheet-row.sheet-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; font-size:28rpx; }.sheet-row.sheet-row>text { color:var(--text-muted); font-size:23rpx; flex:none; }.sheet-row.sheet-row>.choice-name { color:var(--text); font-size:28rpx; flex:1; min-width:0; overflow-wrap:anywhere; }.sheet-row.sheet-row.chosen>.choice-name,.new-chapter.new-chapter { color:var(--primary-deep); }.tag-input { height:100rpx; padding:20rpx; border-radius:22rpx; background:var(--surface-soft); margin:24rpx 0 32rpx; }
@keyframes record-breathe { 50% { opacity:.35; } } @media (prefers-reduced-motion:reduce) { .record-dot { animation:none; } }
