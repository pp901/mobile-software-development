<view class="composer">
 <navigation-bar title="{{momentId ? '我的视角' : id ? '编辑此刻' : '记录此刻'}}" background="#FFFFFF" intercept-back bind:back="handleBack"><text slot="right" class="nav-draft">{{saving ? '保存中' : draftStatus}}</text></navigation-bar>
 <view class="composer-body">
  <text class="composer-kicker">{{momentId ? '同一瞬间，也有你的记忆。' : '不用写完整，留下一点就好。'}}</text>
  <text wx:if="{{momentId}}" class="parent-context">{{parentLabel}}</text>
  <text wx:if="{{recovered}}" class="recovered-note">已接着上次的草稿，慢慢写。</text>
  <view class="writing-area"><textarea class="composer-input" value="{{content}}" auto-height maxlength="10000" bindinput="input" placeholder="{{momentId ? '在你的记忆里，那一刻是什么样的？' : '此刻，你想记住什么？'}}" placeholder-class="placeholder" cursor-spacing="120" adjust-position="{{true}}" disabled="{{blocked || !!savedMomentId}}"/><text wx:if="{{content.length > 9000}}" class="word-count">{{content.length}} / 10000</text></view>
  <view wx:if="{{media.length}}" class="media-grid"><view wx:for="{{media}}" wx:key="id" class="media-item"><image src="{{item.displayPath || item.path}}" mode="aspectFill" bindtap="preview" data-src="{{item.displayPath || item.path}}"/><button class="ui-button remove-photo" bindtap="removePhoto" data-index="{{index}}" aria-label="移除照片"><view>×</view></button></view><button wx:if="{{media.length < 12}}" class="ui-button add-photo" bindtap="addPhotos" disabled="{{adding || blocked}}" aria-label="添加图片"><view class="add-photo-mark">＋</view></button></view>
  <text wx:if="{{media.length}}" class="media-count">{{media.length}} / 12 张图片</text>
  <view wx:if="{{voicePath}}" class="voice-ready"><button class="ui-button voice-play" bindtap="play"><image src="/assets/icons/mic.svg"/><text>{{playing ? '暂停' : '听一听'}} · {{voiceDuration}} 秒</text></button><button class="ui-button voice-remove" bindtap="removeVoice" aria-label="移除录音">×</button></view>
  <view wx:if="{{isRecording}}" class="record-status"><view class="record-dot"></view><text>正在留住声音 · {{recordSeconds}} 秒</text><button class="ui-button record-finish" bindtap="record">完成</button></view>
  <view class="capture-tools"><button class="ui-button capture-tool" bindtap="addPhotos" disabled="{{adding || media.length >= 12 || blocked}}"><view class="tool-icon"><image src="/assets/icons/image.svg"/></view><text>{{adding ? '正在加入' : '加张照片'}}</text></button><button class="ui-button capture-tool voice-tool" bindtap="record" disabled="{{blocked}}"><view class="tool-icon"><image src="/assets/icons/mic.svg"/></view><text>{{isRecording ? '完成录音' : '留段声音'}}</text></button></view>
  <view class="metadata"><picker mode="date" value="{{localDateKey}}" bindchange="changeDate" disabled="{{blocked}}"><view class="date-control"><image src="/assets/icons/calendar.svg"/><text>{{localDateKey}}</text></view></picker><button class="ui-button place-button" bindtap="choosePlace" disabled="{{blocked}}"><image src="/assets/icons/pin.svg"/><text>{{location || '添加地点'}}</text></button><button wx:if="{{location}}" class="ui-button clear-place" bindtap="removePlace" aria-label="移除地点">×</button></view>
  <button wx:if="{{!momentId}}" class="ui-button chapter-context" bindtap="openChapters" disabled="{{blocked}}"><image class="context-icon" src="/assets/icons/book-open.svg"/><view class="context-copy"><text class="context-name">{{chapter ? chapter.title : '放入 Chapter'}}</text><text wx:if="{{chapter}}" class="context-label">收进这一段生活</text></view><text class="context-optional">{{chapter ? '更改' : '可选'}}</text><image class="context-chevron" src="/assets/icons/chevron-right.svg"/></button>
  <view class="composer-tags"><button wx:for="{{tags}}" wx:key="*this" class="ui-button tag" bindtap="openTags"># {{item}}</button><button class="ui-button tag-entry" bindtap="openTags" disabled="{{blocked}}">{{tags.length ? '编辑标签' : '＋ 标签'}}</button></view>
  <text wx:if="{{error}}" class="inline-error">{{error}}</text>
 </view>
 <view class="composer-toolbar {{keyboardHeight ? 'keyboard-open' : ''}}" style="bottom:{{keyboardHeight}}px;">
  <text wx:if="{{!keyboardHeight}}" class="audience-note">{{audience}} · {{momentId ? '让记忆多一个角度' : '以后，还能回到这一刻'}}</text>
  <button wx:if="{{savedMomentId}}" class="ui-button primary-button publish-button" bindtap="openSaved">查看刚留下的 Moment →</button>
  <button wx:else class="ui-button primary-button publish-button" bindtap="save" disabled="{{!canSave || saving || adding || isRecording || blocked}}" loading="{{saving}}"><text>{{id || contributionId ? '保存修改' : momentId ? '留下我的视角' : '留下这一刻'}}</text><text>↗</text></button>
 </view>
 <view wx:if="{{showChapters}}" class="sheet-mask" bindtap="closeChapters" catchtouchmove="noop"><view class="sheet" catchtap="noop"><text class="sheet-title">放进一段生活</text><text class="sheet-copy">归类可以晚一点。此刻先留下，也很好。</text><scroll-view scroll-y class="chapter-choices"><button class="ui-button sheet-row" bindtap="chooseChapter" data-id=""><text class="choice-name">暂不归类</text><text>仅自己可见</text></button><button wx:for="{{chapters}}" wx:key="id" class="ui-button sheet-row {{chapterId === item.id ? 'chosen' : ''}}" bindtap="chooseChapter" data-id="{{item.id}}"><text class="choice-name">{{item.title}}</text><text>{{chapterId === item.id ? '已选择' : item.memberCount > 1 ? item.memberCount + ' 人可见' : '仅自己'}}</text></button></scroll-view><button class="ui-button sheet-row new-chapter" bindtap="createChapter">＋ 新建 Chapter</button><button class="ui-button sheet-close" bindtap="closeChapters">取消</button></view></view>
 <view wx:if="{{showTags}}" class="sheet-mask" bindtap="closeTags"><view class="sheet" catchtap="noop"><text class="sheet-title">为此刻加个标签</text><text class="sheet-copy">用逗号分隔，最多 8 个。</text><input class="tag-input" value="{{tagInput}}" bindinput="inputTags" maxlength="160" placeholder="日常，心情，小小的完成"/><button class="ui-button primary-button" bindtap="saveTags">完成</button><button class="ui-button sheet-close" bindtap="closeTags">取消</button></view></view>
</view>
