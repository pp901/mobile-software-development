.life-profile { padding:30rpx 28rpx; margin-top:28rpx; border-radius:var(--radius-large); background:linear-gradient(125deg,#EAF2DD,#FAF3DE); }
.archive-eyebrow { display:flex; align-items:center; justify-content:space-between; gap:16rpx; color:var(--primary-deep); font-size:24rpx; }
.archive-english { color:#7B906F; font:400 23rpx/1.5 var(--font-ui); }
.profile-head { display:flex; align-items:center; gap:24rpx; margin-top:28rpx; }
.profile-identity { flex:1; min-width:0; }
.name { width:100%; min-height:76rpx; font-size:40rpx; font-weight:600; }
.edit-hint { display:block; margin-top:4rpx; color:var(--text-secondary); font-size:24rpx; }
.avatar-picker.avatar-picker { flex:none; width:140rpx; height:140rpx; overflow:hidden; border:5rpx solid #FFFDF8; border-radius:50%; background:#D0DFC9; box-shadow:0 10rpx 28rpx rgba(70,84,70,.15), 0 0 0 8rpx rgba(131,168,134,.2), 0 0 0 16rpx rgba(131,168,134,.08); }
.avatar-picker>image,.avatar-placeholder { width:100%; height:100%; border-radius:50%; }
.avatar-placeholder { display:flex; align-items:center; justify-content:center; }
.avatar-placeholder>image { width:44rpx; height:44rpx; }
.life-numbers { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; margin:40rpx 0 32rpx; }
.life-numbers>view { min-width:0; border-right:1rpx solid rgba(75,103,60,.13); }
.life-numbers>view:last-child { border:0; }
.life-number { display:block; color:#375A43; font:500 64rpx/1.1 var(--font-ui); font-variant-numeric:tabular-nums; letter-spacing:-3rpx; overflow-wrap:anywhere; }
.life-number-label { display:block; margin-top:12rpx; color:var(--text-secondary); font-size:24rpx; }
.archive-since { margin-top:24rpx; }
.archive-line { display:flex; align-items:center; height:18rpx; }
.archive-point { width:9rpx; height:9rpx; border:1rpx solid var(--primary); border-radius:50%; }
.archive-rule { height:1rpx; flex:1; background:#C6D4BE; }
.archive-point.current { width:10rpx; height:10rpx; background:var(--primary); }
.archive-date { display:flex; justify-content:space-between; gap:12rpx; margin-top:14rpx; color:#738568; font-size:22rpx; }
.archive-begin { border-top:1rpx solid var(--line); padding-top:22rpx; color:var(--text-secondary); font-size:24rpx; }
.first-moment.first-moment { min-height:88rpx; color:var(--primary-deep); text-align:left; font-size:26rpx; }
.shared-count { display:flex; align-items:center; gap:14rpx; padding-top:24rpx; margin-top:24rpx; border-top:1rpx solid rgba(75,103,60,.13); color:var(--text-secondary); font-size:23rpx; }
.shared-number { color:var(--primary-deep); font-weight:600; }
.shared-caption { font-size:22rpx; }
.shared-rings { display:flex; padding-right:7rpx; flex:none; }
.shared-rings>view { width:22rpx; height:22rpx; border:2rpx solid var(--primary); border-radius:50%; }
.shared-rings>view+view { margin-left:-7rpx; background:var(--primary-soft); }
.archive-caption { padding:24rpx 4rpx 36rpx; color:var(--text-secondary); font-size:25rpx; }
.archive-caption>text { display:block; }
.archive-caption>text+text { margin-top:8rpx; color:var(--text-muted); font-size:22rpx; }
.profile-menu { border-top:1rpx solid var(--line); }
.menu-row.menu-row { display:flex; align-items:center; gap:18rpx; width:100%; min-height:116rpx; border-bottom:1rpx solid var(--line); text-align:left; font-size:28rpx; }
.menu-icon { display:flex; align-items:center; justify-content:center; flex:none; width:52rpx; height:52rpx; border-radius:50%; background:var(--primary-pale); }
.menu-icon>image { width:28rpx; height:28rpx; }
.icon-drafts { background:var(--blush-soft); }
.icon-privacy { background:var(--lavender-soft); }
.icon-about { background:#EEEEDF; }
.menu-label { flex:none; }
.menu-detail { min-width:0; margin-left:auto; color:var(--text-secondary); font-size:22rpx; text-align:right; }
.menu-chevron { margin-left:auto; color:var(--text-muted); }
.menu-detail~.menu-chevron { margin-left:0; }
.sync-dot { flex:none; width:7rpx; height:7rpx; border-radius:50%; background:var(--clay); }
.menu-panel { padding:20rpx 4rpx 28rpx; border-bottom:1rpx solid var(--line); }
.panel-copy { font-size:25rpx; color:var(--text-secondary); line-height:1.85; }
.setting-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; font-size:26rpx; }
.setting-row>view { flex:1; min-width:0; }
.setting-row text { display:block; }
.setting-desc { color:var(--text-muted); font-size:23rpx; margin-top:8rpx; }
.draft-row.draft-row { display:flex; align-items:center; gap:20rpx; width:100%; min-height:104rpx; text-align:left; font-size:26rpx; }
.draft-row>text:first-child { flex:1; min-width:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere; }
.draft-row>text+text { flex:none; color:var(--primary-deep); font-size:23rpx; }
.profile-footer { display:block; text-align:center; margin:40rpx 0 12rpx; color:var(--text-muted); font:24rpx/1.8 var(--font-display); }
.profile-footer>text { display:block; }
.conflict-versions { max-height:35vh; margin:40rpx 0; }
.conflict-versions text { display:block; }
.version-copy { white-space:pre-wrap; color:var(--text-secondary); font-size:28rpx; margin:16rpx 0 48rpx; }
.sheet .secondary-button { margin-top:24rpx; }

.life-profile { padding:34rpx 30rpx; margin-top:34rpx; border:1rpx solid rgba(77,99,79,.08); border-radius:28rpx; background:linear-gradient(140deg,#ECF2E3 0%,#F4EDD8 100%); box-shadow:0 14rpx 30rpx rgba(70,83,71,.06), inset 0 1rpx 0 rgba(255,255,255,.5); }
.archive-eyebrow { font-size:21rpx; letter-spacing:2rpx; }.archive-english { font-family:var(--font-display); font-size:26rpx; font-style:italic; }
.name { font-family:var(--font-display); font-size:50rpx; font-weight:600; letter-spacing:-1rpx; }.avatar-picker.avatar-picker { border-color:#FFFDF8; box-shadow:0 10rpx 28rpx rgba(70,84,70,.15), 0 0 0 8rpx rgba(131,168,134,.2), 0 0 0 16rpx rgba(131,168,134,.08); }
.life-numbers { margin:42rpx 0 34rpx; }.life-number { font-family:var(--font-display); font-size:72rpx; font-weight:600; color:var(--primary-deep); letter-spacing:-3rpx; }.life-number-label { font-size:21rpx; color:var(--text-secondary); }
.archive-caption { padding:28rpx 4rpx 40rpx; }.profile-menu { border-top:1rpx solid rgba(57,72,62,.10); }.menu-row.menu-row { min-height:120rpx; border-bottom:1rpx solid rgba(57,72,62,.07); }.menu-icon { border-radius:16rpx; box-shadow:0 2rpx 8rpx rgba(70,84,70,.05); }.menu-panel { padding:24rpx 4rpx 30rpx; }

/* A personal archive sheet: no oversized green panel, only paper and small keepsakes. */
.life-profile { position:relative; overflow:visible; padding:48rpx 40rpx 40rpx; border:1rpx solid #DED6C8; border-radius:7rpx; background:#FFFDF8; box-shadow:0 12rpx 24rpx rgba(76,69,54,.075); }
.life-profile::before { content:''; position:absolute; top:-11rpx; right:50rpx; width:112rpx; height:23rpx; border:1rpx solid rgba(164,144,111,.12); background:#E8D5A6; transform:rotate(4deg); }
.life-profile::after { content:''; position:absolute; inset:10rpx; border:1rpx dashed rgba(125,112,88,.3); border-radius:2rpx; pointer-events:none; }
.life-profile > view, .life-profile > text, .life-profile > button, .life-profile > input { position:relative; z-index:1; }
.archive-eyebrow { color:#3D5A42; font-weight:600; }.archive-english { color:#6B8A6E; }
.avatar-picker.avatar-picker { width:130rpx; height:148rpx; padding:6rpx 6rpx 22rpx; border:1rpx solid #DCD3C3; border-radius:3rpx; background:#FFFEFA; box-shadow:0 7rpx 14rpx rgba(76,69,54,.12); transform:rotate(4deg); }
.avatar-picker>image,.avatar-placeholder { border-radius:1rpx; }.avatar-placeholder { background:#EAF0E5; }
.life-numbers { margin:42rpx 0 32rpx; }.life-numbers>view { border-color:rgba(125,112,88,.16); }.life-number { color:#496F56; }.life-number-label { color:#5F6E60; }
.archive-rule { background:#D8D0BF; }.archive-date { color:#5F6E60; }.shared-count { border-color:rgba(125,112,88,.16); }

.life-profile { border:0; border-radius:0; background-color:#FCF4DA; box-shadow:0 13rpx 27rpx rgba(126,105,56,.12); }
.life-profile::after { display:none; }.life-profile::before { background:#DDE8CD; }
.life-profile>.stamp-frame { position:absolute; inset:0; z-index:0; width:100%; height:100%; pointer-events:none; }

.archive-eyebrow { color:#628567; }.archive-english { color:#91A07E; }.name { color:#31583E; }.edit-hint { color:#758577; }
.life-number { color:#477756; }.life-number-label,.archive-date { color:#74816E; }.archive-caption { color:#647363; }
.name { font-family:var(--font-hand); letter-spacing:1rpx; }.archive-caption>text:first-child { color:#506A55; font-family:var(--font-hand); font-size:28rpx; }.profile-menu { border-top:1rpx dashed #CDC8BA; }
.menu-row.menu-row { margin-top:10rpx; padding:0 14rpx; border:1rpx solid #E8E0D3; border-radius:7rpx; background:#FFFDF8; box-shadow:0 4rpx 10rpx rgba(75,69,58,.035); }.menu-icon { border-radius:5rpx; transform:rotate(-2deg); }.menu-row:nth-child(4n+1) .menu-icon { transform:rotate(2deg); }.menu-label { color:#38533F; font-family:var(--font-hand); font-size:29rpx; }.menu-panel { margin:0 12rpx; padding:24rpx; border:1rpx dashed #D7D0C1; background:#FAF7EE; }
