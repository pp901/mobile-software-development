.life-profile { padding:30rpx 28rpx 26rpx; border-radius:32rpx; background:linear-gradient(130deg,#EDF1F7,#F3F2F7); margin-top:20rpx; }.archive-eyebrow { display:flex; align-items:center; justify-content:space-between; color:var(--primary-deep); font-size:22rpx; letter-spacing:2rpx; }.archive-english { font:italic 23rpx/1.5 var(--font-display); letter-spacing:0; color:var(--primary); }.profile-head { display:flex; align-items:center; gap:24rpx; margin-top:32rpx; }.profile-identity { flex:1; min-width:0; }.name { font-size:40rpx; font-weight:600; min-height:76rpx; width:100%; }.edit-hint { display:block; font-size:24rpx; color:var(--text-secondary); margin-top:4rpx; }.avatar-picker.avatar-picker,.avatar-picker.avatar-picker>image,.avatar-placeholder { flex:none; width:112rpx; height:112rpx; border-radius:38rpx; background:#E0E7F1; }.avatar-picker.avatar-picker { border:5rpx solid rgba(255,255,255,.8); overflow:hidden; }.avatar-picker.avatar-picker>image,.avatar-placeholder { width:100%; height:100%; }.avatar-placeholder { display:flex; align-items:center; justify-content:center; }.avatar-placeholder image { width:44rpx; height:44rpx; }.life-numbers { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14rpx; margin:40rpx 0 30rpx; }.life-numbers>view { min-width:0; border-right:1rpx solid rgba(113,133,166,.16); }.life-numbers>view:last-child { border:0; }.life-number { display:block; color:#415579; font:400 74rpx/1.1 var(--font-display); font-variant-numeric:tabular-nums; letter-spacing:-3rpx; overflow-wrap:anywhere; }.life-number-label { display:block; font-size:24rpx; color:var(--text-secondary); margin-top:12rpx; }.archive-since { margin-top:24rpx; }.archive-line { display:flex; align-items:center; gap:0; height:18rpx; }.archive-point { width:9rpx; height:9rpx; border-radius:50%; border:1rpx solid var(--primary); }.archive-rule { height:1rpx; flex:1; background:#CDD7E7; }.archive-point.current { width:10rpx; height:10rpx; background:var(--primary); }.archive-date { margin-top:14rpx; display:flex; justify-content:space-between; gap:12rpx; font-size:22rpx; color:#7A88A1; }.archive-begin { border-top:1rpx solid var(--line); padding-top:22rpx; font-size:24rpx; color:var(--text-secondary); }.first-moment.first-moment { color:var(--primary-deep); min-height:80rpx; text-align:left; font-size:26rpx; }.shared-count { display:flex; align-items:center; gap:14rpx; padding-top:24rpx; margin-top:24rpx; border-top:1rpx solid rgba(113,133,166,.13); font-size:23rpx; color:var(--text-secondary); }.shared-number { color:var(--primary-deep); font-weight:600; }.shared-caption { font-size:22rpx; }.shared-rings { display:flex; padding-right:7rpx; flex:none; }.shared-rings>view { width:22rpx; height:22rpx; border:1rpx solid var(--primary); border-radius:50%; }.shared-rings>view+view { margin-left:-7rpx; background:rgba(178,195,222,.4); }.archive-caption { padding:24rpx 4rpx 32rpx; color:var(--text-secondary); font-size:25rpx; }.archive-caption>text { display:block; }.archive-caption>text+text { color:var(--text-muted); font-size:21rpx; margin-top:6rpx; }
.profile-menu { border-top:1rpx solid var(--line); }.menu-row.menu-row { display:flex; align-items:center; gap:18rpx; min-height:116rpx; width:100%; border-bottom:1rpx solid var(--line); font-size:28rpx; text-align:left; }.menu-row>image { width:32rpx; height:32rpx; opacity:.75; flex:none; }.menu-detail { margin-left:auto; color:var(--text-muted); font-size:22rpx; }.menu-arrow { color:var(--primary); margin-left:auto; font-size:28rpx; }.menu-detail~.menu-arrow { margin-left:0; }.sync-dot { width:7rpx; height:7rpx; border-radius:50%; background:var(--primary); flex:none; }.menu-panel { padding:16rpx 4rpx 28rpx; border-bottom:1rpx solid var(--line); }.panel-copy { font-size:25rpx; color:var(--text-secondary); line-height:1.9; }.setting-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; font-size:26rpx; }.setting-row>view { flex:1; min-width:0; }.setting-row text { display:block; }.setting-desc { color:var(--text-muted); font-size:23rpx; margin-top:8rpx; }.draft-row.draft-row { display:flex; align-items:center; gap:20rpx; width:100%; min-height:104rpx; text-align:left; font-size:26rpx; }.draft-row>text:first-child { flex:1; min-width:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere; }.draft-row>text+text { flex:none; color:var(--primary-deep); font-size:23rpx; }.profile-footer { display:block; text-align:center; margin:38rpx 0 12rpx; font:24rpx/1.8 var(--font-display); color:var(--text-muted); }.profile-footer>text { display:block; }.conflict-versions { max-height:35vh; margin:40rpx 0; }.conflict-versions text { display:block; }.version-copy { white-space:pre-wrap; color:var(--text-secondary); font-size:28rpx; margin:16rpx 0 48rpx; }.sheet .secondary-button.secondary-button { margin-top:24rpx; }
