.profile-head{display:flex;flex-direction:column;align-items:flex-start;padding:64rpx 0}.avatar-picker.avatar-picker,.avatar-picker.avatar-picker>image,.avatar-placeholder{width:144rpx;height:144rpx;border-radius:50%;background:var(--background-secondary)}.avatar-placeholder{display:flex;align-items:center;justify-content:center}.avatar-placeholder image{width:56rpx;height:56rpx}.name{font-size:56rpx;font-weight:600;margin-top:40rpx;min-height:88rpx}.edit-hint{font-size:26rpx;color:var(--text-secondary)}.settings-group{padding:48rpx 0;border-top:2rpx solid var(--border-subtle)}.group-title{display:block;font-size:28rpx;font-weight:600;margin-bottom:24rpx}.setting-row.setting-row{min-height:128rpx;display:flex;align-items:center;justify-content:space-between;gap:32rpx;width:100%;text-align:left}.setting-row.setting-row>view{min-width:0;flex:1}.setting-row.setting-row text{display:block}.setting-desc,.privacy-copy{font-size:28rpx;color:var(--text-secondary)}.draft-row.draft-row{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.conflict-versions{max-height:35vh;margin:40rpx 0}.conflict-versions text{display:block}.version-copy{white-space:pre-wrap;color:var(--text-secondary);font-size:28rpx;margin:16rpx 0 48rpx}.sheet .secondary-button.secondary-button{margin-top:24rpx}
.profile-head { padding:44rpx 0; }.avatar-picker.avatar-picker { background:var(--primary-pale); }.settings-group { margin-bottom:20rpx; padding:28rpx; background:var(--surface); border:0; border-radius:36rpx; }.setting-row.setting-row { gap:20rpx; }.setting-row.setting-row>button[class] { flex:none; }.name { font-size:44rpx; }.privacy-copy { line-height:1.8; }.draft-row.draft-row { white-space:normal; overflow-wrap:anywhere; }
