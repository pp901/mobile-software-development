<view class="page-shell tabbar-space"><navigation-bar title="我的" back="{{false}}"/><view class="page-pad"><view class="profile-head"><button class="ui-button avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="更换头像"><image wx:if="{{profile.avatar}}" src="{{profile.avatar}}" mode="aspectFill"/><view wx:else class="avatar-placeholder"><image src="/assets/icons/user.svg"/></view></button><input class="name" type="nickname" value="{{profile.nickname}}" bindblur="saveNickname" maxlength="40"/><text class="edit-hint">点击头像或昵称修改</text></view><view class="settings-group"><text class="group-title">同步</text><view class="setting-row"><view><text>{{pending ? pending + ' 项等待同步' : '没有待同步内容'}}</text><text class="setting-desc">{{cloudEnabled ? '草稿仅保存在本机' : '内容已保存在本机'}}</text></view><button class="ui-button section-link" loading="{{syncing}}" disabled="{{syncing}}" bindtap="sync">重试同步</button></view><text wx:if="{{error}}" class="inline-error">{{error}}</text><button wx:for="{{issues}}" wx:key="key" class="ui-button section-link" data-key="{{item.key}}" bindtap="inspectConflict">查看版本冲突</button></view><view wx:if="{{drafts.length}}" class="settings-group"><text class="group-title">待编辑的记录</text><button wx:for="{{drafts}}" wx:key="id" class="ui-button setting-row draft-row" data-id="{{item.id}}" bindtap="openDraft">{{item.content || item.dateLabel}} ›</button></view><view class="settings-group"><text class="group-title">隐私</text><text class="privacy-copy">记录默认仅自己可见。加入共同 Chapter 或接受 Moment 邀请后，对应内容会向共同记录者开放。</text></view><button class="ui-button setting-row" bindtap="replayGuide"><text>关于 ongoing_</text><text>›</text></button></view><app-tabbar active="profile"/></view><view wx:if="{{conflictPanel}}" class="sheet-mask" bindtap="closeConflict"><view class="sheet" catchtap="noop"><text class="sheet-title">选择保留哪个版本</text><text class="sheet-copy">另一台设备也修改了这条内容。</text><scroll-view scroll-y class="conflict-versions"><text>本机版本</text><text class="version-copy">{{localVersion || '媒体记录'}}</text><text>云端版本</text><text class="version-copy">{{remoteVersion || '媒体记录'}}</text></scroll-view><button class="ui-button primary-button" bindtap="keepLocal">保留本机版本并同步</button><button class="ui-button secondary-button" bindtap="keepRemote">使用云端版本</button><button class="ui-button sheet-close" bindtap="closeConflict">稍后处理</button></view></view>