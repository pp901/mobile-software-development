<view class="page-shell tabbar-space">
 <navigation-bar home><view slot="home" class="app-masthead"><text class="app-wordmark">ongoing_</text></view></navigation-bar>
 <view class="page-pad">
  <view class="life-profile"><image class="stamp-frame" src="/assets/images/stamp-frame-cream.svg" mode="scaleToFill"/>
   <view class="archive-eyebrow"><text>生活档案</text><text class="archive-english">a life, ongoing_</text></view>
   <view class="profile-head"><view class="profile-identity"><input class="name" type="nickname" value="{{profile.nickname}}" bindblur="saveNickname" maxlength="40"/><text class="edit-hint">每一刻，都在成为你。</text></view><button class="ui-button avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="更换头像"><image wx:if="{{profile.avatar && !avatarFailed}}" src="{{profile.avatar}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="avatar-placeholder"><image src="/assets/icons/user.svg"/></view></button></view>
   <view class="life-numbers"><view><text class="life-number">{{stats.momentCount}}</text><text class="life-number-label">Moment</text></view><view><text class="life-number">{{stats.recordedDayCount}}</text><text class="life-number-label">个记录日</text></view><view><text class="life-number">{{stats.chapterCount}}</text><text class="life-number-label">Chapter</text></view></view>
   <view wx:if="{{stats.firstDate}}" class="archive-since"><view class="archive-line"><view class="archive-point"></view><view class="archive-rule"></view><view class="archive-point current"></view></view><view class="archive-date"><text>从 {{stats.firstDate}} 开始</text><text>仍在继续</text></view></view>
   <view wx:else class="archive-begin"><text>生活档案，从你留下的第一刻开始。</text><button class="ui-button first-moment" bindtap="createMoment">记录此刻 ↗</button></view>
   <view wx:if="{{stats.sharedMomentCount}}" class="shared-count"><view class="shared-rings"><view></view><view></view></view><text><text class="shared-number">{{stats.sharedMomentCount}}</text> 个共同 Moment<text class="shared-caption"> · 有人和你一起记得</text></text></view>
  </view>
  <view class="archive-caption"><text>日子会走远，记录会留下。</text><text>点击头像或昵称，可以修改资料。</text></view>
  <view class="profile-menu">
   <button class="ui-button menu-row" bindtap="togglePanel" data-panel="drafts" aria-expanded="{{panel === 'drafts'}}"><view class="menu-icon icon-drafts"><image src="/assets/icons/pencil.svg"/></view><text class="menu-label">草稿</text><text class="menu-detail">{{drafts.length ? drafts.length + ' 则未写完' : '都已好好留下'}}</text><view class="menu-chevron disclosure-chevron {{panel === 'drafts' ? 'is-open' : ''}}"></view></button>
   <view wx:if="{{panel === 'drafts'}}" class="menu-panel content-enter"><text wx:if="{{!drafts.length}}" class="panel-copy">写到一半的文字、图片和声音，会在这里等你。</text><button wx:for="{{drafts}}" wx:key="id" class="ui-button draft-row" data-url="{{item.url}}" bindtap="openDraft"><text>{{item.content || item.dateLabel}}</text><text>继续写 →</text></button></view>
   <button class="ui-button menu-row" bindtap="togglePanel" data-panel="sync" aria-expanded="{{panel === 'sync'}}"><view class="menu-icon icon-sync"><image src="/assets/icons/cloud.svg"/></view><text class="menu-label">同步与数据</text><text class="menu-detail">{{pending || error ? '已保存在本机' : cloudEnabled ? '已同步' : '本机保存'}}</text><view wx:if="{{error || issues.length}}" class="sync-dot"></view><view class="menu-chevron disclosure-chevron {{panel === 'sync' ? 'is-open' : ''}}"></view></button>
   <view wx:if="{{panel === 'sync'}}" class="menu-panel content-enter"><view class="setting-row"><view><text>{{pending ? pending + ' 项等待同步' : '没有待同步内容'}}</text><text class="setting-desc">草稿仅保存在本机</text></view><button class="ui-button section-link" loading="{{syncing}}" disabled="{{syncing}}" bindtap="sync">{{syncing ? '同步中' : '立即同步'}}</button></view><text wx:if="{{error}}" class="inline-error">{{error}}</text><button wx:if="{{syncStatus.diagnostic}}" class="ui-button section-link" bindtap="copySyncDiagnostic">复制诊断信息</button><button wx:for="{{issues}}" wx:key="key" class="ui-button section-link" data-key="{{item.key}}" bindtap="inspectConflict">查看版本冲突</button></view>
   <button class="ui-button menu-row" bindtap="togglePanel" data-panel="privacy" aria-expanded="{{panel === 'privacy'}}"><view class="menu-icon icon-privacy"><image src="/assets/icons/lock.svg"/></view><text class="menu-label">隐私</text><text class="menu-detail">由你决定分享给谁</text><view class="menu-chevron disclosure-chevron {{panel === 'privacy' ? 'is-open' : ''}}"></view></button>
   <view wx:if="{{panel === 'privacy'}}" class="menu-panel content-enter"><text class="panel-copy">记录默认仅自己可见。放入共同 Chapter 后，该 Chapter 的成员可以查看；通过 Moment 邀请加入的记录者，只能查看受邀的 Moment。草稿始终仅自己可见。</text></view>
   <button class="ui-button menu-row" bindtap="replayGuide"><view class="menu-icon icon-about"><image src="/assets/icons/book-open.svg"/></view><text class="menu-label">关于 ongoing_</text><view class="menu-chevron disclosure-chevron points-right"></view></button>
  </view>
  <text class="profile-footer">今天很容易留下一刻，<text>以后能重新看见自己的生活。</text></text>
 </view><app-tabbar active="profile"/>
</view>
<view wx:if="{{conflictPanel}}" class="sheet-mask" bindtap="closeConflict"><view class="sheet" catchtap="noop"><text class="sheet-title">选择保留哪个版本</text><text class="sheet-copy">另一台设备也修改了这条内容。</text><scroll-view scroll-y class="conflict-versions"><text>本机版本</text><text class="version-copy">{{localVersion || '媒体记录'}}</text><text>云端版本</text><text class="version-copy">{{remoteVersion || '媒体记录'}}</text></scroll-view><button class="ui-button primary-button" bindtap="keepLocal">保留本机版本并同步</button><button class="ui-button secondary-button" bindtap="keepRemote">使用云端版本</button><button class="ui-button sheet-close" bindtap="closeConflict">稍后处理</button></view></view>
