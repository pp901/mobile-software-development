<button class="ui-button chapter-card {{compact ? 'compact' : ''}}" bindtap="open" hover-class="card-hover"><view class="chapter-art media-placeholder"><image wx:if="{{chapter.cover && !imageFailed}}" class="chapter-photo" src="{{chapter.displayCover || chapter.cover}}" mode="aspectFill" lazy-load binderror="imageError"/><image wx:else src="/assets/icons/image.svg"/></view><view class="chapter-label"><text class="chapter-state">{{chapter.status === 'ONGOING' ? '进行中' : '已成章'}}</text><text class="chapter-name">{{chapter.title}}</text><text class="chapter-description">{{chapter.description}}</text><text class="chapter-meta">{{chapter.momentCount}} 个 Moment · {{chapter.memberCount}} 位同行者</text></view></button>
