<button class="ui-button chapter-card {{compact ? 'compact' : ''}}" bindtap="open" hover-class="card-hover"><view class="chapter-art media-placeholder"><image wx:if="{{chapter.cover && !imageFailed}}" class="chapter-photo" src="{{chapter.displayCover || chapter.cover}}" mode="aspectFill" lazy-load binderror="imageError"/><text wx:else class="chapter-initial">{{chapter.title[0]}}</text></view><view class="chapter-label"><text class="chapter-state">{{chapter.elapsedLabel}}</text><text class="chapter-name">{{chapter.title}}</text><text class="chapter-date-range">{{chapter.dateRange}}</text><text wx:if="{{!compact && chapter.description}}" class="chapter-description">{{chapter.description}}</text><text class="chapter-meta">{{chapter.momentCount}} Moment · {{chapter.recordedDayCount}} 个记录日</text><view class="chapter-members"><view class="chapter-avatar-stack"><view wx:for="{{chapter.memberPreview}}" wx:key="id" class="chapter-member-avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"/><text wx:else>{{item.nickname[0]}}</text></view></view><text>{{chapter.memberCount > 1 ? chapter.memberCount + ' 人一起经历' : '我的这一段生活'}}</text></view></view></button>
