:host { display:block; width:100%; min-width:0; }
.chapter-card.chapter-card { width:100%; min-width:0; overflow:hidden; border:1rpx solid rgba(66,82,70,.08); border-radius:28rpx; background:var(--chapter-surface); box-shadow:0 8rpx 22rpx rgba(67,79,67,.045); text-align:left; }
.chapter-art { height:300rpx; overflow:hidden; }
.chapter-art.media-placeholder { background:#E7EDE1; }
.chapter-art>.chapter-photo { width:100%; height:100%; opacity:1; }
.chapter-initial { color:#A4B19A; font:500 96rpx/1 var(--font-display); }
.chapter-label { padding:28rpx; min-width:0; }
.chapter-state { color:var(--primary-deep); font-size:22rpx; }
.chapter-name { display:block; margin:8rpx 0 12rpx; font:600 36rpx/1.4 var(--font-display); letter-spacing:-.5rpx; overflow-wrap:anywhere; }
.chapter-date-range { display:block; margin:8rpx 0 16rpx; color:var(--text-secondary); font-size:22rpx; }
.chapter-description { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:var(--text-secondary); font-size:25rpx; line-height:1.7; }
.chapter-meta { display:block; margin-top:18rpx; color:var(--text-secondary); font-size:23rpx; }
.chapter-members { display:flex; align-items:center; gap:12rpx; margin-top:18rpx; color:var(--text-secondary); font-size:22rpx; }
.chapter-avatar-stack { display:flex; padding-left:10rpx; flex:none; }
.chapter-member-avatar { display:flex; align-items:center; justify-content:center; width:36rpx; height:36rpx; margin-left:-10rpx; border:2rpx solid var(--chapter-surface); border-radius:50%; overflow:hidden; background:var(--primary-soft); color:var(--primary-deep); font-size:16rpx; }
.chapter-member-avatar>image { width:100%; height:100%; }
.chapter-card.compact { display:grid; grid-template-columns:minmax(148rpx,29%) minmax(0,1fr); }
.compact .chapter-art { height:calc(100% - 28rpx); min-height:280rpx; margin:14rpx 0 14rpx 14rpx; border-radius:var(--radius-small); }
.compact .chapter-label { padding:24rpx 20rpx; }
.compact .chapter-name { margin:8rpx 0; font-size:32rpx; }

/* Chapter cards share the same stamp-paper language in the full Chapter library. */
.chapter-card.chapter-card { position:relative; overflow:hidden; border:1rpx solid #DED6C8; border-radius:7rpx; background:#FFFDF8; box-shadow:0 9rpx 18rpx rgba(76,69,54,.06); }
.chapter-card::after { content:''; position:absolute; inset:10rpx; border:1rpx dashed rgba(125,112,88,.28); border-radius:2rpx; pointer-events:none; }
.chapter-art { position:relative; z-index:1; margin:16rpx 16rpx 0; height:276rpx; border:1rpx solid #DED6C8; border-radius:3rpx; background:#F1F0E8; }
.chapter-art.media-placeholder { background:#F1F0E8; }.chapter-initial { color:#A8B39F; }
.chapter-label { position:relative; z-index:1; padding:24rpx 28rpx 30rpx; }.chapter-state { color:#6D826C; }.chapter-date-range,.chapter-meta,.chapter-members { color:#7D796D; }
.chapter-member-avatar { border-color:#FFFDF8; background:#DCE5D4; }
.compact .chapter-art { height:calc(100% - 28rpx); min-height:280rpx; margin:14rpx 0 14rpx 14rpx; border-radius:3rpx; }

.chapter-card.chapter-card { border:0; border-radius:0; background-color:var(--chapter-surface, #E8F2D9); box-shadow:0 10rpx 21rpx rgba(91,113,78,.11); }
.chapter-card::after { display:none; }
.chapter-card>.stamp-frame { position:absolute; inset:0; z-index:0; width:100%; height:100%; pointer-events:none; }
.chapter-name { color:#345D42; font-size:38rpx; }.chapter-state { color:#668C68; }.chapter-date-range,.chapter-meta,.chapter-members { color:#718071; }
