.chapter-card { position:relative; display:block; width:100%; height:590rpx; padding:0; border:0; border-radius:30rpx; overflow:hidden; background:#cbd1c3; color:#fff; text-align:left; box-shadow:0 10rpx 0 rgba(23,63,45,.12),0 24rpx 46rpx rgba(36,52,41,.15); }
.chapter-cover,.chapter-shade { position:absolute; top:0; left:0; width:100%; height:100%; }
.chapter-shade { background:linear-gradient(180deg,transparent 42%,rgba(30,31,22,.14) 62%,rgba(30,31,22,.84) 100%); }
.cover-note { position:absolute; top:35rpx; left:48rpx; color:#565e51; transform:rotate(-7deg); font-family:"STKaiti","KaiTi","Songti SC",serif; font-size:28rpx; line-height:1.65; letter-spacing:2rpx; }
.cover-note text { display:block; white-space:pre-line; }.cover-note text:last-child { text-align:right; font-family:Georgia,serif; font-style:italic; font-size:23rpx; opacity:.75; }
.chapter-content { position:absolute; left:28rpx; right:28rpx; bottom:24rpx; }
.chapter-caption { display:flex; justify-content:space-between; align-items:center; }
.chapter-season { font-size:21rpx; }.chapter-title { display:block; font-size:44rpx; font-weight:600; line-height:1.25; margin-top:7rpx; }
.chapter-summary { display:flex; justify-content:space-between; align-items:center; gap:20rpx; margin-top:8rpx; }.chapter-day { font-size:25rpx; flex:none; }
.chapter-quote { width:49%; font-size:18rpx; line-height:1.55; color:rgba(255,255,255,.77); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.chapter-progress-row { display:flex; align-items:center; gap:20rpx; margin-top:16rpx; font-size:22rpx; }
.progress-track { flex:1; height:15rpx; overflow:hidden; border-radius:9rpx; background:rgba(245,243,231,.3); }.progress-fill { height:100%; background:#d1ddc6; border-radius:9rpx; }
.member-line { margin-top:14rpx; display:flex; align-items:center; gap:10rpx; font-size:18rpx; color:rgba(255,255,255,.82); }
.mini-avatars { display:flex; padding-left:8rpx; }
.mini-avatars image { width:34rpx; height:34rpx; margin-left:-8rpx; border:3rpx solid rgba(255,255,255,.85); border-radius:50%; }
.pending { margin-left:auto; padding:5rpx 9rpx; border-radius:8rpx; background:#f2bd42; color:#3e2e09; font-weight:700; }
.is-compact { height:280rpx; background:#fffdf8; color:#30362e; box-shadow:0 7rpx 0 rgba(43,72,54,.07),0 18rpx 34rpx rgba(54,49,38,.07); border-radius:22rpx; }
.is-compact .chapter-cover { width:34%; }.is-compact .chapter-shade { display:none; }
.is-compact .chapter-content { top:22rpx; bottom:20rpx; left:calc(34% + 22rpx); right:22rpx; }
.is-compact .chapter-season { font-size:17rpx; color:#777b72; }.is-compact .chapter-title { font-size:31rpx; }
.is-compact .chapter-day { font-size:20rpx; color:#6f746a; }.is-compact .chapter-progress-row { margin-top:12rpx; font-size:18rpx; }.is-compact .progress-track { height:9rpx; background:#e7e8df; }.is-compact .progress-fill { background:#71856a; }
.chapter-copy { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; margin-top:16rpx; font-size:19rpx; line-height:1.5; color:#8a8b80; }.chapter-more { font-size:26rpx; line-height:1; }
.is-compact .member-line { color:#7f877f; margin-top:11rpx; }.is-compact .mini-avatars image { border-color:#fffdf8; }.is-compact .pending { display:none; }.is-compact .chapter-copy { margin-top:10rpx; -webkit-line-clamp:1; }
