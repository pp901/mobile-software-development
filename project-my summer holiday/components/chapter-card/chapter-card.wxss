:host { display:block; width:100%; min-width:0; }.chapter-card.chapter-card { width:100%; min-width:0; text-align:left; overflow:hidden; border-radius:40rpx; background:var(--surface); }.chapter-art { height:300rpx; overflow:hidden; }.chapter-art>.chapter-photo { width:100%; height:100%; opacity:1; }.chapter-label { padding:24rpx; min-width:0; }.chapter-state { color:var(--primary); font-size:22rpx; }.chapter-name { display:block; font:600 36rpx/1.4 var(--font-display); margin:8rpx 0 12rpx; overflow-wrap:anywhere; }.chapter-description { color:var(--text-secondary); font-size:25rpx; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; line-height:1.7; }.chapter-meta { display:block; color:var(--text-muted); font-size:23rpx; margin-top:18rpx; }.compact { display:grid; grid-template-columns:minmax(152rpx,30%) minmax(0,1fr); }.compact .chapter-art { height:100%; min-height:280rpx; }.compact .chapter-label { padding:24rpx; }.compact .chapter-name { font-size:32rpx; }.compact .chapter-description { font-size:24rpx; }.compact .chapter-meta { font-size:21rpx; }
.chapter-initial { font:500 96rpx/1 var(--font-display); color:#ADB9CD; }.chapter-date-range { display:block; margin:10rpx 0 16rpx; font-size:22rpx; color:var(--text-muted); }.chapter-meta { color:var(--text-secondary); }.chapter-members { display:flex; align-items:center; gap:12rpx; margin-top:18rpx; color:var(--text-muted); font-size:21rpx; }.chapter-avatar-stack { display:flex; padding-left:10rpx; }.chapter-member-avatar { width:36rpx; height:36rpx; border:2rpx solid var(--surface); margin-left:-10rpx; border-radius:50%; background:var(--primary-soft); color:var(--primary-deep); display:flex; align-items:center; justify-content:center; overflow:hidden; font-size:16rpx; }.chapter-member-avatar>image { width:100%; height:100%; }.compact .chapter-art { min-height:304rpx; }.compact .chapter-date-range { font-size:21rpx; }.compact .chapter-name { margin:8rpx 0; }.chapter-card.chapter-card { border-radius:28rpx; }
