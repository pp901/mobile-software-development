<view class="navigation" style="padding-top:{{statusHeight}}px;background:{{background}};color:{{color}};opacity:{{show ? 1 : 0}};">
  <view class="navigation-inner {{home ? 'is-home' : ''}}" style="height:{{barHeight}}px;padding-right:{{capsuleWidth}}px;">
    <view wx:if="{{home}}" class="navigation-home"><slot name="home"></slot></view>
    <block wx:else>
      <button wx:if="{{back}}" class="ui-button navigation-back" bindtap="back" aria-label="返回" hover-class="nav-pressed"><view class="back-chevron"></view></button>
      <view wx:else class="navigation-left"><slot name="left"></slot></view>
      <text class="navigation-title">{{title}}</text>
      <view class="navigation-action"><slot name="right"></slot></view>
    </block>
  </view>
</view>
