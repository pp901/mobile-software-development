.navigation { width:100%; box-sizing:border-box; }.navigation-inner { position:relative; width:100%; min-width:0; display:flex; align-items:center; box-sizing:border-box; }.navigation-inner.is-home { display:block; }.navigation-home { width:100%; height:100%; }
.navigation-back.navigation-back,.navigation-left { width:96rpx; min-height:44px; height:100%; flex:none; display:flex; align-items:center; justify-content:center; }.navigation-back.navigation-back { margin-left:10rpx; border-radius:50%; }.back-chevron { width:17rpx; height:17rpx; border-bottom:3rpx solid currentColor; border-left:3rpx solid currentColor; transform:rotate(45deg); }.navigation-title { min-width:0; flex:1; font-size:31rpx; font-weight:600; line-height:1.35; letter-spacing:-.5rpx; overflow-wrap:anywhere; }.navigation-action { flex:none; max-width:136rpx; padding-right:8rpx; }.nav-pressed { opacity:.55; background:var(--surface-soft); }
.navigation { border-bottom:1rpx solid rgba(75,93,78,.055); background:rgba(255,254,248,.78); -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }.navigation-title { color:#31543C; font-family:var(--font-hand); font-size:34rpx; letter-spacing:.5rpx; }.navigation-back.navigation-back { color:#56745C; }
