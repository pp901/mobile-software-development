.navigation { width:100%; box-sizing:border-box; }.navigation-inner { position:relative; width:100%; min-width:0; display:flex; align-items:center; box-sizing:border-box; }.navigation-inner.is-home { display:block; }.navigation-home { width:100%; height:100%; }
.navigation-back.navigation-back,.navigation-left { width:96rpx; min-height:44px; height:100%; flex:none; display:flex; align-items:center; justify-content:center; }.back-chevron { width:18rpx; height:18rpx; border-bottom:3rpx solid currentColor; border-left:3rpx solid currentColor; transform:rotate(45deg); }.navigation-title { min-width:0; flex:1; font-size:30rpx; font-weight:500; line-height:1.35; overflow-wrap:anywhere; }.navigation-action { flex:none; max-width:136rpx; padding-right:8rpx; }.nav-pressed { opacity:.5; }
