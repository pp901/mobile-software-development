 <button class="ui-button tab-item {{active === 'chapters' ? 'active' : ''}}" bindtap="openChapters" aria-label="章节"><image src="/assets/icons/book-open{{active === 'chapters' ? '-active' : ''}}.svg"/><text>章节</text></button>
 <button class="ui-button tab-item {{active === 'history' ? 'active' : ''}}" bindtap="openHistory" aria-label="回望"><image src="/assets/icons/echo{{active === 'history' ? '-active' : ''}}.svg"/><text>回望</text></button>
 <button class="ui-button tab-item {{active === 'profile' ? 'active' : ''}}" bindtap="openProfile" aria-label="我的"><image src="/assets/icons/user{{active === 'profile' ? '-active' : ''}}.svg"/><text>我的</text></button>
