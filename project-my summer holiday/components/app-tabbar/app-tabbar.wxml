<view class="tabbar">
  <button class="tab-item {{active === 'now' ? 'is-active' : ''}}" bindtap="openNow"><image src="/assets/icons/home.svg" /><text>当下</text></button>
  <button class="create-button" bindtap="openCreate" aria-label="记录一个瞬间"><text>＋</text></button>
  <button class="tab-item {{active === 'history' ? 'is-active' : ''}}" bindtap="openHistory"><image src="/assets/icons/book-open.svg" /><text>回望</text></button>
</view>
<view wx:if="{{choosing}}" class="record-mask" bindtap="closeCreate" catchtouchmove="noop">
  <button class="sheet-close" aria-label="关闭" bindtap="closeCreate">×</button>
  <view class="record-sheet" catchtap="noop">
    <view class="sheet-handle"></view><text class="sheet-title">记录一个瞬间</text><text class="sheet-copy">选择你想记录的方式</text>
    <view class="record-options"><button wx:for="{{choices}}" wx:key="key" data-type="{{item.key}}" bindtap="choose" class="record-option"><view class="option-icon {{item.tone}}"><image src="/assets/icons/{{item.icon}}.svg" /></view><text class="option-title">{{item.title}}</text><text class="option-copy">{{item.copy}}</text></button></view>
    <text class="sheet-footer">生活的每一面，都值得被记录。</text>
  </view>
</view>
