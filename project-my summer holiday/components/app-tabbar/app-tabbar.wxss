.tabbar { position:fixed; z-index:80; left:28rpx; right:28rpx; bottom:calc(16rpx + env(safe-area-inset-bottom)); padding:10rpx; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; border:1rpx solid var(--line); border-radius:44rpx; background:var(--material); box-shadow:var(--elevation-material); }
.tab-item.tab-item { min-width:0; min-height:96rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5rpx; border-radius:32rpx; color:var(--text-muted); font-size:22rpx; line-height:1.4; }.tab-item.tab-item image { width:40rpx; height:40rpx; }.tab-item.tab-item.active { background:var(--primary-pale); color:var(--primary-deep); font-weight:600; }

.tab-item.tab-item { min-height:max(96rpx,44px); }
