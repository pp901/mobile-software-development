.tabbar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 8rpx 82rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(35, 47, 39, .1);
  background: rgba(255, 253, 248, .97);
  box-shadow: 0 -12rpx 34rpx rgba(32, 45, 37, .08);
}
.tab-item { width: 112rpx; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; color: #6e7770; font-size: 22rpx; }
.tab-item image { width: 42rpx; height: 42rpx; opacity: .66; }
.tab-item.is-active { color: #233328; font-weight: 700; }
.is-active image { opacity: 1; }
.create-button { width: 94rpx; height: 94rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #476354; color: #fff; box-shadow: 0 14rpx 30rpx rgba(45, 80, 59, .28); }
.create-button text { margin-top: -6rpx; font-size: 66rpx; font-weight: 200; line-height: 1; }
.record-mask { position: fixed; z-index: 100; inset: 0; background: rgba(24, 29, 25, .72); }
.sheet-close { position: absolute; top: calc(92rpx + env(safe-area-inset-top)); right: 28rpx; width: 88rpx; height: 88rpx; color: white; font-size: 46rpx; }
.record-sheet { position: absolute; right: 0; bottom: 0; left: 0; padding: 20rpx 28rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fffdf8; box-shadow: 0 -24rpx 60rpx rgba(18, 27, 21, .2); animation: sheet-in 220ms cubic-bezier(.2,.8,.2,1); }
.sheet-handle { width: 62rpx; height: 7rpx; margin: 0 auto 30rpx; border-radius: 8rpx; background: #aeb5af; }
.sheet-title, .sheet-copy, .sheet-footer { display: block; text-align: center; }
.sheet-title { color: #253029; font-size: 38rpx; font-weight: 700; }
.sheet-copy { margin-top: 8rpx; color: #667068; font-size: 24rpx; }
.record-options { margin-top: 32rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.record-option { min-width: 0; height: 218rpx; padding: 22rpx 10rpx 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.3), 0 12rpx 24rpx rgba(42,53,45,.12); }
.record-option:nth-child(1) { background: #476354; }
.record-option:nth-child(2) { background: #c96049; }
.record-option:nth-child(3) { background: #d6a43e; color: #332817; }
.option-icon { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: rgba(255,255,255,.18); }
.option-icon image { width: 42rpx; height: 42rpx; filter: brightness(0) invert(1); }
.record-option:nth-child(3) .option-icon image { filter: brightness(.3); }
.option-title { margin-top: 18rpx; font-size: 28rpx; font-weight: 700; }
.option-copy { margin-top: 7rpx; font-size: 21rpx; opacity: .78; }
.sheet-footer { margin-top: 28rpx; color: #6e7770; font-size: 22rpx; }
@keyframes sheet-in { from { transform: translateY(40rpx); opacity: .3; } to { transform: translateY(0); opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .record-sheet { animation: none; } }
