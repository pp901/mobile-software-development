.tabbar { position:fixed; z-index:80; left:28rpx; right:28rpx; bottom:calc(14rpx + env(safe-area-inset-bottom)); padding:10rpx 14rpx; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; border:1rpx solid rgba(255,255,255,.8); border-radius:50rpx; background:var(--material); box-shadow:0 8rpx 40rpx rgba(46,69,52,.1); backdrop-filter:blur(20px); }
.tab-item.tab-item { min-width:0; min-height:110rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; color:var(--text-muted); font-size:21rpx; line-height:1.4; }.tab-circle { width:66rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; transition:background .2s; }.tab-circle image { width:36rpx; height:36rpx; }.tab-item.tab-item.active { color:var(--primary-deep); font-weight:600; }.active .tab-circle { background:var(--primary-soft); }.capture-tab.capture-tab { color:var(--primary-deep); font-weight:600; }.capture-circle { width:76rpx; height:76rpx; flex:none; position:relative; background:var(--primary-deep); border-radius:50%; margin-top:-19rpx; margin-bottom:4rpx; box-shadow:0 4rpx 0 #D6E2D7; }.capture-circle>view { position:absolute; top:calc(50% - 2rpx); left:calc(50% - 16rpx); width:32rpx; height:4rpx; border-radius:4rpx; background:#fff; }.capture-circle>view+view { transform:rotate(90deg); }.capture-tab:active .capture-circle { transform:scale(.94); }.capture-circle { transition:transform .16s; } @media (prefers-reduced-motion:reduce) { .capture-circle { transition:none; } }
