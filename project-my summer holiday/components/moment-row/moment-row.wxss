:host { display:block; width:100%; min-width:0; }.moment-row.moment-row { width:100%; min-width:0; display:flex; align-items:center; gap:20rpx; padding:22rpx 0; text-align:left; border-bottom:1rpx solid var(--line); }.moment-thumb { width:112rpx; height:112rpx; overflow:hidden; border-radius:18rpx; flex:none; }.moment-thumb>.thumb-photo { width:100%; height:100%; opacity:1; }.moment-thumb>image { width:36rpx; height:36rpx; }.moment-row-body { flex:1; min-width:0; }.moment-row-copy { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:27rpx; line-height:1.6; overflow-wrap:anywhere; }.moment-time { display:block; margin-top:8rpx; color:var(--text-muted); font-size:23rpx; }.row-arrow { width:26rpx; height:26rpx; flex:none; opacity:.5; }

.row-perspectives { display:block; color:var(--primary-deep); font-size:22rpx; margin-top:6rpx; }
.moment-row.moment-row { margin-bottom:14rpx; padding:18rpx; border:1rpx solid #E5DDCE; border-radius:9rpx; background:#FFFDF8; box-shadow:0 6rpx 14rpx rgba(74,69,58,.05); }.moment-thumb { border:5rpx solid #fff; border-radius:4rpx; box-shadow:0 4rpx 10rpx rgba(74,69,58,.10); }.moment-row-copy { color:#354E3C; font-family:var(--font-hand); font-size:29rpx; }
