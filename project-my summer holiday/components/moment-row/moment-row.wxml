<button class="ui-button moment-row" bindtap="open"><view class="moment-thumb media-placeholder"><image wx:if="{{moment.image && !imageFailed}}" class="thumb-photo" src="{{moment.image}}" mode="aspectFill" lazy-load binderror="imageError"/><image wx:else src="/assets/icons/{{moment.voicePath ? 'mic' : 'image'}}.svg"/></view><view class="moment-row-body"><text class="moment-row-copy">{{summary}}</text><text wx:if="{{moment.participantCount > 1}}" class="row-perspectives">{{moment.participantCount}} 人共同记录</text><text class="moment-time">{{showDate ? shortDate + ' · ' : ''}}{{moment.time}}{{moment.location ? ' · ' + moment.location : ''}}</text></view><image class="row-arrow" src="/assets/icons/chevron-right.svg"/></button>
