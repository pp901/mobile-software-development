:host { display:block; min-width:0; width:100%; }.moment-card.moment-card { display:block; width:100%; padding:0 0 28rpx; text-align:left; }.photo-wrap { overflow:hidden; border-radius:32rpx; background:var(--surface-soft); }.photo-wrap image { display:block; width:100%; }.moment-copy { padding:18rpx 0; }.excerpt { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; font-size:30rpx; line-height:1.7; overflow-wrap:anywhere; }.text-only { padding:16rpx 0; font-size:34rpx; }.moment-meta { margin-top:12rpx; display:flex; flex-wrap:wrap; gap:8rpx 20rpx; color:var(--text-muted); font-size:24rpx; }.perspective-note { display:block; margin-top:8rpx; color:var(--primary-deep); font-size:24rpx; }.audio-note { display:flex; align-items:center; gap:12rpx; padding:16rpx 0; font-size:26rpx; }.audio-note image { width:32rpx; height:32rpx; }
.compact { padding:0; }.compact .photo-wrap { height:188rpx; border-radius:26rpx; }.compact .photo-wrap image { width:100%; height:100%; }.compact .photo-wrap .placeholder-icon { width:42rpx; height:42rpx; }.compact .moment-copy { padding:12rpx 0 0; }.compact .excerpt { padding:0; font-size:25rpx; line-height:1.5; -webkit-line-clamp:2; }.compact .moment-meta { font-size:21rpx; margin-top:6rpx; }
