.moment-card {
  width: 100%;
  min-height: 222rpx;
  padding: 16rpx;
  display: flex;
  gap: 22rpx;
  border: 1rpx solid rgba(38, 49, 43, .055);
  border-radius: 26rpx;
  background: #fffefa;
  box-shadow: 0 7rpx 0 rgba(43,72,54,.07), 0 16rpx 30rpx rgba(43,72,54,.06);
  text-align: left;
}

.photo-wrap {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  flex: none;
  overflow: hidden;
  border-radius: 19rpx;
  background: #e6ece7;
}
.moment-photo { width: 100%; height: 100%; }
.moment-photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #edf0e9;
  color: #718074;
}
.moment-photo-placeholder text:first-child { height: 72rpx; font-size: 76rpx; line-height: 1; }
.moment-photo-placeholder text:last-child { font-size: 18rpx; letter-spacing: 2rpx; }

.photo-count {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  background: rgba(25, 30, 27, .62);
  color: #fff;
  font-size: 21rpx;
  line-height: 40rpx;
  text-align: center;
}
.draft-badge { position:absolute; left:10rpx; top:10rpx; padding:8rpx 12rpx; border-radius:10rpx; background:#f2bd42; color:#44320b; font-size:18rpx; font-weight:700; }
.moment-body { min-width: 0; flex: 1; padding: 5rpx 3rpx 2rpx 0; }
.moment-meta {
  display: flex;
  justify-content: space-between;
  color: #8b908a;
  font-size: 19rpx;
  font-variant-numeric: tabular-nums;
}
.favorite { color: #c77c68; }
.moment-copy {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #303933;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}
.moment-place {
  margin-top: 11rpx;
  overflow: hidden;
  color: #737a74;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pin { margin-right: 6rpx; color: #587362; }
.moment-tags { margin-top: 10rpx; display: flex; gap: 7rpx; overflow: hidden; }
.mini-tag {
  flex: none;
  padding: 5rpx 9rpx;
  border-radius: 20rpx;
  background: #f0eee8;
  color: #7b7d78;
  font-size: 19rpx;
}
.moment-footer { margin-top:16rpx; display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.creator { min-width:0; display:flex; align-items:center; gap:9rpx; color:#707970; font-size:19rpx; }
.creator image { width:34rpx; height:34rpx; flex:none; border-radius:50%; background:#dcecdf; }
.creator text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.together { flex:none; padding:7rpx 10rpx; border-radius:9rpx; background:#ffe0d7; color:#9b4131; font-size:17rpx; font-weight:600; }
.moment-card.is-stack { display: block; padding: 0; overflow: hidden; }
.is-stack .photo-wrap { width: 100%; height: 300rpx; border-radius: 0; }
.is-stack .moment-body { padding: 24rpx; }
