:host { display:block; min-width:0; width:100%; }.moment-card.moment-card { display:block; width:100%; padding:0 0 28rpx; text-align:left; }.photo-wrap { overflow:hidden; border-radius:32rpx; background:var(--surface-soft); }.photo-wrap image { display:block; width:100%; }.moment-copy { padding:18rpx 0; }.excerpt { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; font-size:30rpx; line-height:1.7; overflow-wrap:anywhere; }.text-only { padding:16rpx 0; font-size:34rpx; }.moment-meta { margin-top:12rpx; display:flex; flex-wrap:wrap; gap:8rpx 20rpx; color:var(--text-muted); font-size:24rpx; }.perspective-note { display:block; margin-top:8rpx; color:var(--primary-deep); font-size:24rpx; }.audio-note { display:flex; align-items:center; gap:12rpx; padding:16rpx 0; font-size:26rpx; }.audio-note image { width:32rpx; height:32rpx; }
.compact { padding:0; }.compact .photo-wrap { height:188rpx; border-radius:26rpx; }.compact .photo-wrap image { width:100%; height:100%; }.compact .photo-wrap .placeholder-icon { width:42rpx; height:42rpx; }.compact .moment-copy { padding:12rpx 0 0; }.compact .excerpt { padding:0; font-size:25rpx; line-height:1.5; -webkit-line-clamp:2; }.compact .moment-meta { font-size:21rpx; margin-top:6rpx; }
.photo-wrap { position:relative; }.photo-count { position:absolute; bottom:14rpx; right:14rpx; padding:4rpx 12rpx; border-radius:12rpx; background:rgba(42,56,78,.45); color:#fff; font-size:21rpx; }.compact .photo-wrap { height:228rpx; border-radius:24rpx; }.compact .moment-copy { padding-top:12rpx; }.compact .excerpt { font-size:26rpx; line-height:1.65; }.compact .moment-meta { font-size:22rpx; }.text-cover,.voice-cover { position:relative; height:228rpx; border-radius:24rpx; padding:20rpx; background:#EDF0F6; overflow:hidden; }.quote-mark { position:absolute; top:-8rpx; right:16rpx; font:100rpx/1 var(--font-display); color:#D4DDEB; }.text-preview { position:relative; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; font:28rpx/1.6 var(--font-display); color:#485A79; overflow-wrap:anywhere; }.text-cover-label { position:absolute; bottom:16rpx; left:20rpx; color:#8592A9; font-size:20rpx; background:#EDF0F6; padding-right:12rpx; }.voice-cover { background:#EFEDF5; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18rpx; }.voice-cover>image { width:34rpx; height:34rpx; }.voice-cover>text { color:#7E7F98; font-size:21rpx; }.sound-lines { display:flex; align-items:center; gap:7rpx; height:38rpx; }.sound-lines>view { width:5rpx; height:20rpx; background:#A5A8BF; border-radius:5rpx; }.sound-lines>view:nth-child(2n) { height:36rpx; }.sound-lines>view:nth-child(3n) { height:28rpx; }.perspective-note { display:flex; align-items:center; gap:12rpx; margin-top:12rpx; font-size:23rpx; color:var(--primary-deep); }.participant-stack { display:flex; padding-left:10rpx; flex:none; }.participant-avatar { width:38rpx; height:38rpx; margin-left:-10rpx; border:3rpx solid var(--bg); border-radius:50%; background:#DCE4F0; overflow:hidden; display:flex; align-items:center; justify-content:center; font-size:17rpx; }.participant-avatar>image { width:100%; height:100%; }.compact .perspective-note { gap:8rpx; font-size:21rpx; }.compact .participant-avatar { width:32rpx; height:32rpx; font-size:15rpx; }.compact.moment-card { padding-bottom:0; }
.compact .photo-wrap { height:274rpx; border-radius:28rpx; }.text-cover,.voice-cover { height:274rpx; border-radius:28rpx; }.text-cover { background:#F0EAD9; }.quote-mark { color:#D9CCAD; }.text-preview { font-size:29rpx; color:#675E49; -webkit-line-clamp:4; }.text-cover-label { color:#A09579; background:#F0EAD9; bottom:20rpx; }.voice-cover { background:#E9E6F0; }.participant-avatar { border-color:var(--bg); background:#DAE5DA; }.compact .moment-meta { font-size:23rpx; }.compact .perspective-note { font-size:22rpx; }.compact .participant-avatar { width:36rpx; height:36rpx; }
