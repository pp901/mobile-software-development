.album-entry.album-entry { display:flex; gap:18rpx; width:100%; min-width:0; padding:0 0 26rpx; margin-bottom:24rpx; border-bottom:1rpx solid var(--line); text-align:left; }
.album-photos { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); grid-template-rows:repeat(2,minmax(0,1fr)); gap:3rpx; flex:none; width:184rpx; height:184rpx; overflow:hidden; border-radius:12rpx; background:var(--surface-soft); }
.album-photos-1 { grid-template-columns:1fr; grid-template-rows:1fr; }
.album-photos-2 { grid-template-rows:1fr; }
.album-photos-3>.album-photo:first-child { grid-row:span 2; }
.album-photo { position:relative; min-width:0; min-height:0; display:flex; align-items:center; justify-content:center; }
.album-photo>image { width:100%; height:100%; }
.album-photo>.album-photo-fallback { width:28rpx; height:28rpx; opacity:.5; }
.album-summary { flex:1; min-width:0; display:flex; flex-direction:column; align-items:flex-start; }
.album-excerpt { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere; font-size:27rpx; line-height:1.55; white-space:pre-wrap; }
.words-only .album-excerpt { padding:16rpx 20rpx; width:100%; background:var(--primary-pale); border-radius:12rpx; }
.album-media-note { display:flex; flex-wrap:wrap; gap:12rpx; color:var(--text-secondary); font-size:21rpx; }
.album-media-note>view { display:flex; align-items:center; gap:6rpx; }
.album-media-note image { width:22rpx; height:22rpx; }
.album-author { display:block; max-width:100%; margin-top:12rpx; color:var(--text-secondary); font-size:22rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.album-together { margin-top:6rpx; color:var(--primary-deep); font-size:21rpx; }
.feed-author { display:flex; align-items:center; gap:10rpx; margin-bottom:10rpx; font-size:26rpx; font-weight:500; }
.feed-author>image { width:38rpx; height:38rpx; border-radius:50%; flex:none; }
.feed-author>text+text { color:var(--text-muted); font-size:22rpx; font-weight:400; }
:host { display:block; min-width:0; width:100%; }
.moment-feed { padding:32rpx 0; border-bottom:1rpx solid var(--line); min-width:0; }
.feed-heading { display:flex; align-items:baseline; justify-content:space-between; gap:16rpx; margin-bottom:18rpx; }
.feed-date { font-size:25rpx; font-weight:500; color:var(--text-secondary); }
.feed-time { font-size:22rpx; color:var(--text-muted); font-variant-numeric:tabular-nums; }
.feed-writing { margin-bottom:20rpx; }
.feed-text { display:block; font-size:var(--type-body); line-height:1.75; white-space:pre-wrap; overflow-wrap:anywhere; }
.feed-text.collapsed { display:-webkit-box; -webkit-line-clamp:6; -webkit-box-orient:vertical; overflow:hidden; }
.expand-text.expand-text { width:auto; display:flex; align-items:center; gap:12rpx; min-height:44px; color:var(--primary-deep); font-size:25rpx; }
.feed-context { display:flex; flex-direction:column; gap:10rpx; margin-top:18rpx; }
.feed-location { display:flex; align-items:flex-start; gap:8rpx; color:var(--text-secondary); font-size:24rpx; }
.feed-location>image { flex:none; width:24rpx; height:24rpx; margin-top:5rpx; opacity:.75; }
.feed-location>text { min-width:0; overflow-wrap:anywhere; }
.feed-tags { display:flex; flex-wrap:wrap; gap:6rpx 18rpx; color:var(--primary-deep); font-size:23rpx; overflow-wrap:anywhere; }
.feed-tags>text { max-width:100%; }
.feed-footer { display:flex; flex-wrap:wrap; align-items:center; gap:4rpx 20rpx; margin-top:12rpx; }
.feed-chapter.feed-chapter { width:auto; display:flex; align-items:center; gap:8rpx; min-width:0; max-width:100%; min-height:44px; color:var(--primary-deep); font-size:23rpx; text-align:left; }
.feed-chapter>image { flex:none; width:26rpx; height:26rpx; opacity:.75; }
.feed-chapter>text { min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.invited-note { color:var(--text-secondary); font-size:23rpx; }
.shared-note { display:flex; align-items:center; gap:10rpx; color:var(--primary-deep); font-size:23rpx; }
.shared-rings { display:flex; padding-right:6rpx; flex:none; }
.shared-rings>view { width:20rpx; height:20rpx; border:2rpx solid var(--primary); border-radius:50%; }
.shared-rings>view+view { margin-left:-6rpx; background:var(--primary-soft); }
.moment-preview.moment-preview { display:block; width:100%; text-align:left; }
.preview-photo { position:relative; overflow:hidden; height:274rpx; border-radius:var(--radius-medium); background:var(--surface-soft); }
.preview-photo>image { width:100%; height:100%; display:block; }
.photo-count { position:absolute; right:14rpx; bottom:14rpx; padding:3rpx 12rpx; border-radius:var(--radius-full); background:rgba(41,62,56,.5); color:#fff; font-size:21rpx; }
.preview-copy { padding-top:14rpx; }
.preview-excerpt { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:26rpx; line-height:1.6; overflow-wrap:anywhere; }
.preview-date { display:block; margin-top:6rpx; color:var(--text-secondary); font-size:23rpx; }
.preview-copy>.shared-note { margin-top:10rpx; font-size:22rpx; }
.text-cover,.voice-cover { position:relative; height:274rpx; border-radius:var(--radius-medium); padding:24rpx; overflow:hidden; }
.text-cover { background:#F0EAD9; }
.quote-mark { position:absolute; right:16rpx; top:-8rpx; font:100rpx/1 var(--font-display); color:#D9CCAD; }
.text-preview { position:relative; display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden; font:29rpx/1.6 var(--font-display); color:#675E49; overflow-wrap:anywhere; }
.text-cover-label { position:absolute; left:24rpx; right:24rpx; bottom:18rpx; background:#F0EAD9; color:#887F69; font-size:21rpx; }
.voice-cover { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20rpx; background:var(--lavender-soft); }
.voice-cover>image { width:34rpx; height:34rpx; }
.voice-cover>text { font-size:21rpx; color:#77788C; }
.sound-lines { display:flex; align-items:center; gap:7rpx; height:40rpx; }
.sound-lines>view { width:5rpx; height:20rpx; background:#A8A4B9; border-radius:5rpx; }
.sound-lines>view:nth-child(2n) { height:36rpx; }
.sound-lines>view:nth-child(3n) { height:28rpx; }
