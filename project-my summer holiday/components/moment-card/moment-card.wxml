<button class="ui-button moment-card {{layout === 'compact' ? 'compact' : ''}}" bindtap="open" hover-class="card-hover"><view wx:if="{{moment.image && !imageFailed}}" class="photo-wrap"><image src="{{moment.image}}" mode="{{layout === 'compact' ? 'aspectFill' : 'widthFix'}}" lazy-load binderror="imageError"/></view><view wx:elif="{{layout === 'compact'}}" class="photo-wrap media-placeholder"><image class="placeholder-icon" src="/assets/icons/{{moment.voicePath ? 'mic' : 'image'}}.svg"/></view><view class="moment-copy"><text class="excerpt {{moment.image ? '' : 'text-only'}}">{{moment.content || (moment.voicePath ? '留住这一刻的声音' : '此刻的画面')}}</text><view wx:if="{{moment.voicePath && layout !== 'compact'}}" class="audio-note"><image src="/assets/icons/mic.svg"/><text>录音 · {{moment.voiceDuration}} 秒</text></view><view class="moment-meta"><text>{{moment.dateLabel}}</text><text wx:if="{{layout !== 'compact' && moment.location}}">{{moment.location}}</text></view><text wx:if="{{moment.participantCount > 1 && layout !== 'compact'}}" class="perspective-note">{{moment.participantCount}} 人的视角</text></view></button>
