<button class="ui-button moment-card {{layout === 'compact' ? 'compact' : ''}}" bindtap="open" hover-class="card-hover">
 <view wx:if="{{moment.image && !imageFailed}}" class="photo-wrap"><image src="{{moment.image}}" mode="{{layout === 'compact' ? 'aspectFill' : 'widthFix'}}" lazy-load binderror="imageError"/><text wx:if="{{moment.imageCount > 1}}" class="photo-count">{{moment.imageCount}} 张</text></view>
 <view wx:elif="{{layout === 'compact' && moment.voicePath}}" class="voice-cover"><image src="/assets/icons/mic.svg"/><view class="sound-lines"><view></view><view></view><view></view><view></view><view></view><view></view><view></view></view><text>{{moment.voiceDuration || 0}} 秒 · 那一刻的声音</text></view>
 <view wx:elif="{{layout === 'compact'}}" class="text-cover"><text class="quote-mark">“</text><text class="text-preview">{{moment.content || '此刻的画面'}}</text><text class="text-cover-label">{{moment.image ? '图片暂时无法显示' : '写在此刻'}}</text></view>
 <view class="moment-copy"><text wx:if="{{layout !== 'compact' || moment.image || moment.voicePath}}" class="excerpt {{moment.image ? '' : 'text-only'}}">{{moment.content || (moment.voicePath ? '留住这一刻的声音' : '此刻的画面')}}</text><view wx:if="{{moment.voicePath && layout !== 'compact'}}" class="audio-note"><image src="/assets/icons/mic.svg"/><text>录音 · {{moment.voiceDuration}} 秒</text></view><view class="moment-meta"><text>{{moment.dateLabel}}</text><text wx:if="{{layout !== 'compact' && moment.location}}">{{moment.location}}</text></view><view wx:if="{{moment.participantCount > 1}}" class="perspective-note"><view class="participant-stack"><view wx:for="{{moment.participantPreview}}" wx:key="id" class="participant-avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"/><text wx:else>{{item.nickname[0]}}</text></view></view><text>{{moment.participantCount}} 人共同记录</text></view></view>
</button>
