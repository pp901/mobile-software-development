:host { display:block; min-width:0; }.content { min-width:0; }.photos { display:flex; flex-direction:column; gap:16rpx; }.photos image { width:100%; display:block; border-radius:24rpx; background:var(--surface-soft); }.body-copy { display:block; margin:24rpx 0; font-size:29rpx; line-height:1.85; white-space:pre-wrap; overflow-wrap:anywhere; }.image-error { padding:56rpx 24rpx; background:var(--lavender-soft); color:var(--text-secondary); font-size:26rpx; border-radius:24rpx; }.audio.audio { width:100%; min-height:112rpx; padding:20rpx 24rpx; margin:24rpx 0; display:flex; align-items:center; gap:24rpx; border-radius:32rpx; background:var(--lavender-soft); text-align:left; font-size:27rpx; }.audio-symbol { width:64rpx; height:64rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--surface); color:var(--primary-deep); }.audio-time { display:block; color:var(--text-secondary); font-size:23rpx; }
