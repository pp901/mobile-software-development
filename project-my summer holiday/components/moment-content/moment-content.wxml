<view class="content"><view wx:if="{{showPhotos && item.media.length}}" class="photos"><block wx:for="{{item.media}}" wx:key="id"><image wx:if="{{item.type === 'image' && !failed[index]}}" src="{{item.displayPath || item.path}}" mode="widthFix" lazy-load bindtap="preview" data-src="{{item.displayPath || item.path}}" data-index="{{index}}" binderror="imageError"/><view wx:elif="{{failed[index]}}" class="image-error">图片暂时无法显示</view></block></view><text wx:if="{{showText && item.content}}" class="body-copy" selectable>{{item.content}}</text><button wx:if="{{item.voicePath}}" class="ui-button audio" bindtap="play" aria-label="{{playing ? '暂停录音' : '播放录音'}}"><view class="audio-symbol">{{playing ? 'Ⅱ' : '▶'}}</view><view><text>{{playing ? '正在播放' : '录音'}}</text><text class="audio-time">{{playing ? elapsed + ' / ' : ''}}{{item.voiceDuration || 0}} 秒</text></view></button></view>
