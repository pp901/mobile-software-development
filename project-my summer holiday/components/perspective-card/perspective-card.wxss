:host { display:block; width:100%; min-width:0; }
.perspective-post { padding:24rpx; border:1rpx solid rgba(75,88,77,.09); border-radius:24rpx; background:var(--surface); box-shadow:0 6rpx 18rpx rgba(61,71,64,.035); }
.perspective-post.is-expanded { background:#FCF9F3; }
.post-author { display:flex; align-items:center; gap:14rpx; }.post-avatar { width:56rpx; height:56rpx; flex:none; overflow:hidden; border-radius:18rpx; background:var(--primary-pale); display:flex; align-items:center; justify-content:center; }.post-avatar>image { width:100%; height:100%; }.post-avatar>.post-avatar-icon { width:30rpx; height:30rpx; }.post-author-copy { flex:1; min-width:0; }.post-author-copy>text { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:26rpx; font-weight:500; }.post-author-copy>text+text { margin-top:3rpx; color:var(--text-muted); font-size:21rpx; font-weight:400; }.post-more.post-more { flex:none; width:72rpx; height:72rpx; min-height:44px; display:flex; align-items:center; justify-content:center; border-radius:50%; }.post-more>image { width:30rpx; height:30rpx; }
.post-summary.post-summary { width:100%; min-height:0; margin-top:18rpx; text-align:left; }.post-preview { display:flex; align-items:stretch; gap:18rpx; min-width:0; padding:20rpx; border-radius:18rpx; background:#F4F2EB; }.post-preview-copy { flex:1; min-width:0; display:flex; flex-direction:column; justify-content:space-between; gap:16rpx; }.post-text { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; color:var(--text); font-size:27rpx; line-height:1.62; white-space:pre-wrap; overflow-wrap:anywhere; }.post-meta { display:flex; flex-wrap:wrap; gap:6rpx 14rpx; color:var(--text-muted); font-size:21rpx; }.post-meta>text:last-child { color:var(--primary-deep); }.post-arrow { margin-left:3rpx; font-size:24rpx; }.post-photo { width:144rpx; height:144rpx; flex:none; border-radius:14rpx; background:var(--surface-soft); }
.post-full { margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid var(--line); }.post-collapse.post-collapse { min-height:72rpx; color:var(--primary-deep); font-size:23rpx; }
.comment-section { margin-top:22rpx; padding:20rpx; border-radius:18rpx; background:#F3F1EA; }.comment-heading { display:flex; align-items:baseline; justify-content:space-between; gap:16rpx; }.comment-heading>text:first-child { font-size:24rpx; font-weight:600; }.comment-heading>text+text { color:var(--text-muted); font-size:20rpx; }.comment-list { margin-top:16rpx; }.comment-row { display:flex; align-items:flex-start; gap:10rpx; padding:12rpx 0; }.comment-row+.comment-row { border-top:1rpx solid rgba(74,87,77,.08); }.comment-avatar { width:40rpx; height:40rpx; flex:none; overflow:hidden; border-radius:12rpx; background:var(--primary-pale); display:flex; align-items:center; justify-content:center; }.comment-avatar>image { width:100%; height:100%; }.comment-avatar>.comment-avatar-icon { width:22rpx; height:22rpx; }.comment-copy { flex:1; min-width:0; }.comment-copy>view { font-size:22rpx; line-height:1.55; overflow-wrap:anywhere; }.comment-copy>view>text:first-child { margin-right:10rpx; color:var(--primary-deep); font-weight:500; }.comment-content { color:var(--text); }.comment-copy>text { display:block; margin-top:3rpx; color:var(--text-muted); font-size:19rpx; }.comment-delete.comment-delete { flex:none; width:48rpx; min-height:48rpx; color:var(--text-muted); font-size:28rpx; line-height:1; }.comment-empty { display:block; margin:14rpx 0; color:var(--text-muted); font-size:21rpx; }.comment-composer { display:flex; align-items:center; gap:12rpx; min-height:72rpx; padding:0 6rpx 0 18rpx; border:1rpx solid rgba(74,87,77,.1); border-radius:var(--radius-full); background:var(--surface); }.comment-composer>input { flex:1; min-width:0; height:68rpx; font-size:22rpx; }.comment-send.comment-send { flex:none; min-width:78rpx; min-height:60rpx; padding:0 14rpx; border-radius:var(--radius-full); background:var(--primary-deep); color:#fff; font-size:21rpx; }
.perspective-post { position:relative; border:1rpx solid #E2D8C8; border-radius:8rpx; background:#FFFDF8; box-shadow:0 7rpx 15rpx rgba(78,70,58,.06); }.perspective-post::before { content:''; position:absolute; top:-10rpx; left:42rpx; width:86rpx; height:20rpx; background:rgba(225,207,158,.72); transform:rotate(-4deg); }.perspective-post.is-expanded { background:#FFFAF0; }.post-preview { border:1rpx dashed #D9CFBD; border-radius:6rpx; background:#F6F1E7; }.post-text { color:#354E3C; font-family:var(--font-hand); font-size:29rpx; }.post-photo { border:5rpx solid #fff; border-radius:3rpx; transform:rotate(2deg); box-shadow:0 4rpx 10rpx rgba(72,67,55,.10); }.comment-section { border-radius:7rpx; background:#F2F4EA; }.comment-composer { border-radius:8rpx; }
