<view class="perspective-post {{expanded ? 'is-expanded' : ''}}">
 <view class="post-author"><view class="post-avatar"><image wx:if="{{item.creator.avatar}}" src="{{item.creator.avatar}}" mode="aspectFill"/><image wx:else class="post-avatar-icon" src="/assets/icons/user.svg"/></view><view class="post-author-copy"><text>{{item.canEdit ? '我的视角' : item.creator.nickname + ' 的视角'}}</text><text>视角 {{item.dateLabel}}</text></view><button wx:if="{{item.canEdit}}" class="ui-button post-more" catchtap="more" aria-label="管理我的视角"><image src="/assets/icons/more.svg"/></button></view>
 <button class="ui-button post-summary" bindtap="toggle" aria-expanded="{{expanded}}" aria-label="{{expanded ? '收起' : '查看'}} {{item.creator.nickname}} 的完整视角"><view class="post-preview {{previewImage ? 'has-photo' : ''}}"><view class="post-preview-copy"><text class="post-text">{{summary}}</text><view class="post-meta"><text wx:if="{{previewImage}}">{{imageCount > 1 ? imageCount + ' 张照片' : '照片'}}</text><text wx:if="{{item.voicePath}}">声音 {{item.voiceDuration || 0}} 秒</text><text>{{expanded ? '收起' : '查看完整视角'}} <text class="post-arrow">{{expanded ? '↑' : '↗'}}</text></text></view></view><image wx:if="{{previewImage}}" class="post-photo" src="{{previewImage}}" mode="aspectFill"/></view></button>
 <view wx:if="{{expanded}}" class="post-full"><moment-content item="{{item}}"/><view class="comment-section"><view class="comment-heading"><text>评论 {{comments.length}}</text><text>一起记得这一刻</text></view><view wx:if="{{comments.length}}" class="comment-list"><view wx:for="{{comments}}" wx:key="id" class="comment-row"><view class="comment-avatar"><image wx:if="{{item.creator.avatar}}" src="{{item.creator.avatar}}" mode="aspectFill"/><image wx:else class="comment-avatar-icon" src="/assets/icons/user.svg"/></view><view class="comment-copy"><view><text>{{item.creator.nickname}}</text><text class="comment-content">{{item.content}}</text></view><text>{{item.dateLabel}}</text></view><button wx:if="{{item.canDelete}}" class="ui-button comment-delete" catchtap="deleteComment" data-id="{{item.id}}" aria-label="删除我的评论">×</button></view></view><text wx:else class="comment-empty">第一句回应，会让这段记忆更完整。</text><view class="comment-composer"><input value="{{commentInput}}" bindinput="inputComment" bindconfirm="submitComment" confirm-type="send" maxlength="300" placeholder="写一句回应…"/><button class="ui-button comment-send" bindtap="submitComment" disabled="{{!commentInput}}">发送</button></view></view><button class="ui-button post-collapse" bindtap="collapse">收起这段视角 ↑</button></view>
</view>
