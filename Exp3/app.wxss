/* ===== 观海听涛 · 全局样式 ===== */

page {
  background: #F4F7FB;
  color: #17324D;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

/* ---- 新闻卡片（首页 / 我的 复用） ---- */
.news-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(10, 60, 120, 0.08);
}

.news-card .poster {
  width: 220rpx;
  height: 150rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #E8EEF5;
}

.news-card .info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 150rpx;
}

.news-card .card-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #17324D;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-card .card-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #7A8CA0;
}

.news-card .card-meta .date {
  margin-left: auto;
}

/* ---- 分类标签 ---- */
.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #ffffff;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tag-headlines { background: #0A5BA8; }
.tag-comprehensive { background: #12A5B0; }
.tag-academic { background: #7B61FF; }
.tag-campus { background: #FF9F5A; }
.tag-media { background: #C9972B; }

/* ---- 按压反馈 ---- */
.card-hover {
  opacity: 0.75;
  transform: scale(0.985);
}

/* ---- 空状态 ---- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 0;
}

.empty .empty-wave {
  width: 160rpx;
  height: 60rpx;
  border-radius: 60rpx;
  background: #D8E6F5;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.empty .empty-wave::after {
  content: '';
  position: absolute;
  left: 30rpx;
  top: 14rpx;
  width: 100rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #B7D2EC;
}

.empty .empty-text {
  color: #8A9AA9;
  font-size: 26rpx;
}
