page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f3eb;
  color: #20364d;
  font-family: "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
}

.page-scroll {
  height: 0;
  flex: 1;
  overflow: hidden;
}

.hero {
  overflow: hidden;
  background: #e9e0d0;
}

.hero-image {
  display: block;
  width: 100%;
}

.hero-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 30rpx 16rpx;
  border-bottom: 1rpx solid rgba(32, 54, 77, 0.15);
  color: #8b7960;
  font-size: 18rpx;
  letter-spacing: 0.6rpx;
}

.content {
  padding: 0 34rpx 76rpx;
  box-sizing: border-box;
}

.section-title,
.section-subtitle,
.paragraph,
.note-mark,
.note-text,
.focus-name,
.focus-description,
.todo-title,
.todo-description,
.life-name,
.life-text,
.closing-title,
.closing-text,
.footer-sign {
  display: block;
}

.profile-rail {
  margin-top: 52rpx;
  border-top: 2rpx solid #24435f;
  border-bottom: 1rpx solid rgba(36, 67, 95, 0.3);
  background: #eee6da;
}

.profile-rail-main {
  display: grid;
  grid-template-columns: 205rpx minmax(0, 1fr);
}

.profile-kicker,
.profile-name,
.profile-name-en,
.profile-detail-label,
.profile-detail-value,
.profile-direction-label {
  display: block;
}

.profile-signature {
  display: flex;
  min-height: 161rpx;
  padding: 23rpx 21rpx 25rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  background: #183b5d;
}

.profile-kicker {
  margin-bottom: 14rpx;
  color: rgba(241, 229, 209, 0.58);
  font-family: Georgia, serif;
  font-size: 16rpx;
  letter-spacing: 1.2rpx;
}

.profile-name {
  color: #f7efe1;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  line-height: 1.1;
}

.profile-name-en {
  margin-top: 11rpx;
  color: rgba(241, 229, 209, 0.65);
  font-family: Georgia, serif;
  font-size: 15rpx;
  letter-spacing: 0.8rpx;
}

.profile-details {
  display: flex;
  min-width: 0;
  min-height: 161rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
}

.profile-detail-row {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  align-items: start;
  padding: 12rpx 0;
}

.profile-detail-row + .profile-detail-row {
  border-top: 1rpx solid rgba(36, 67, 95, 0.15);
}

.profile-detail-label {
  padding-top: 2rpx;
  color: #987344;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.profile-detail-value {
  color: #29465f;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.45;
}

.profile-direction {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 57rpx;
  padding: 13rpx 21rpx;
  border-top: 1rpx solid rgba(36, 67, 95, 0.18);
  box-sizing: border-box;
}

.profile-direction-label {
  width: 100rpx;
  flex: none;
  color: #916c3d;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.profile-direction-value {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  color: #27445e;
  font-size: 19rpx;
  font-weight: 600;
}

.profile-direction-divider {
  margin: 0 13rpx;
  color: #b4894c;
  font-family: Georgia, serif;
  font-weight: 400;
}

.section {
  margin-top: 86rpx;
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 34rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid rgba(32, 54, 77, 0.2);
}

.section-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 55rpx;
  height: 55rpx;
  flex: none;
  margin-right: 20rpx;
  background: #173b60;
  color: #d4ad72;
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-style: italic;
  line-height: 55rpx;
}

.section-heading {
  min-width: 0;
  flex: 1;
}

.section-title {
  color: #173a5e;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.section-subtitle {
  margin-top: 5rpx;
  color: #9c8c76;
  font-family: Georgia, serif;
  font-size: 16rpx;
  font-style: italic;
  letter-spacing: 1rpx;
}

.section-body {
  padding-left: 0;
}

.paragraph {
  margin-bottom: 23rpx;
  color: #526679;
  font-size: 25rpx;
  line-height: 1.92;
  text-align: justify;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.personal-note {
  position: relative;
  margin: 58rpx 0 3rpx;
  padding: 25rpx 25rpx 26rpx 31rpx;
  border-left: 5rpx solid #c69a58;
  background: #efe5d4;
}

.note-mark {
  position: absolute;
  top: 1rpx;
  left: 11rpx;
  color: rgba(157, 122, 67, 0.18);
  font-family: Georgia, serif;
  font-size: 80rpx;
  line-height: 1;
}

.note-text {
  position: relative;
  color: #455d73;
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.75;
}

.focus-list,
.todo-list,
.life-list {
  margin-left: 0;
}

.focus-item {
  padding: 0 0 35rpx;
  margin-bottom: 34rpx;
  border-bottom: 1rpx solid rgba(32, 54, 77, 0.15);
}

.focus-item--last {
  margin-bottom: 0;
}

.focus-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.focus-name {
  color: #193b5d;
  font-size: 28rpx;
  font-weight: 600;
}

.focus-code {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 41rpx;
  height: 41rpx;
  border: 1rpx solid rgba(157, 122, 67, 0.5);
  color: #9d7a43;
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-style: italic;
}

.focus-description {
  color: #566a7d;
  font-size: 24rpx;
  line-height: 1.84;
  text-align: justify;
}

.keyword-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  color: #9b7b4b;
  font-size: 19rpx;
}

.keyword-row text {
  margin-right: 25rpx;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid rgba(155, 123, 75, 0.35);
}

.todo-item {
  display: flex;
  padding: 0 0 30rpx;
  margin-bottom: 29rpx;
  border-bottom: 1rpx solid rgba(32, 54, 77, 0.14);
}

.todo-item--last {
  margin-bottom: 0;
}

.todo-status {
  width: 92rpx;
  flex: none;
  padding-top: 4rpx;
  color: #a47d42;
  font-size: 18rpx;
}

.todo-copy {
  min-width: 0;
  flex: 1;
}

.todo-title {
  color: #213e5a;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.55;
}

.todo-description {
  margin-top: 9rpx;
  color: #667789;
  font-size: 22rpx;
  line-height: 1.72;
}

.life-item {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr);
  padding: 0 0 31rpx;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(32, 54, 77, 0.14);
}

.life-item--last {
  margin-bottom: 0;
}

.life-name {
  padding-top: 2rpx;
  color: #9d7540;
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  font-weight: 700;
}

.life-text {
  color: #566a7d;
  font-size: 23rpx;
  line-height: 1.82;
  text-align: justify;
}

.closing-note {
  margin-top: 87rpx;
  padding: 35rpx 32rpx 38rpx;
  border-top: 5rpx solid #b78a48;
  background: #173b60;
  color: #f9f1e3;
}

.closing-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 700;
}

.closing-text {
  margin-top: 17rpx;
  color: rgba(249, 241, 227, 0.76);
  font-size: 23rpx;
  line-height: 1.78;
}

.footer {
  padding: 57rpx 0 4rpx;
}

.share-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 91rpx;
  margin: 0;
  padding: 22rpx 27rpx 23rpx 29rpx;
  border: 0;
  border-radius: 4rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #c69a58;
  color: #173551;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: left;
  transition: background-color 180ms ease, opacity 180ms ease, transform 180ms ease;
}

.share-button::after {
  display: none;
}

.share-button--pressed {
  background: #b98b4b;
  opacity: 0.9;
  transform: translateY(1rpx);
}

.share-button-label {
  display: block;
  min-width: 0;
  flex: 1;
  line-height: 1.35;
  white-space: nowrap;
}

.share-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  flex: none;
  margin-left: 22rpx;
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-1rpx);
}

.footer-sign {
  margin-top: 27rpx;
  color: #90816c;
  font-size: 17rpx;
  line-height: 1.6;
  text-align: center;
}
